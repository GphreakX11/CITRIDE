{
  "name": "citride-watershed-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src vite.config.ts tsconfig.json index.html package.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json index.html package.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "cytoscape": "3.34.3",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/cytoscape": "3.21.9",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
