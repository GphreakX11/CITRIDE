c:IDT_11_4_4 a owl:Class ;
  rdfs:label "IDT 11.4.4 Waterway" ;
  rdfs:comment "Navigable waterways capable of carrying marine traffic. " ;
  rdfs:subClassOf c:IDT_11_4 .
