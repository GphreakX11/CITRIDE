c:IDT_9_2_2 a owl:Class ;
  rdfs:label "IDT 9.2.2 Courier Information System Center" ;
  rdfs:comment "Data centers that house information systems or are the locations from which information systems are deployed. Information systems refer to databases and other computing resources." ;
  rdfs:subClassOf c:IDT_9_2 .
