c:IDT_1_2_3_1_2 a owl:Class ;
  rdfs:label "IDT 1.2.3.1.2 Sugarcane Refining" ;
  rdfs:comment "Facilities primarily engaged in refining cane sugar from raw cane sugar. " ;
  rdfs:subClassOf c:IDT_1_2_3_1 .
c:axiom-idt-1_2_3_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
