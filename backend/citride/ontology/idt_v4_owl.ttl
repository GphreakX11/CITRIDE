c:IDT_5_3_5_2_2 a owl:Class ;
  rdfs:label "IDT 5.3.5.2.2 Liquefied Natural Gas (LNG) Port" ;
  rdfs:comment "Port facilities designed to handle liquefied natural gas (LNG) tankers. Includes mooring facilities, loading and unloading facilities. Includes specially designed storage tanks. Includes regasification equipment to regasify LNG for injection into pipelines." ;
  rdfs:subClassOf c:IDT_5_3_5_2 .
c:axiom-idt-5_3_5_2_2-parent a owl:Axiom ;
