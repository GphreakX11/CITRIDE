c:IDT_5_3_6_3 a owl:Class ;
  rdfs:label "IDT 5.3.6.3 Natural Gas Distribution Control and Dispatch Center" ;
  rdfs:comment "These centers control the lower pressure gas distribution system. Includes distribution supervisory control and data acquisition (SCADA) systems.  " ;
  rdfs:subClassOf c:IDT_5_3_6 .
c:axiom-idt-5_3_6_3-parent a owl:Axiom ;
