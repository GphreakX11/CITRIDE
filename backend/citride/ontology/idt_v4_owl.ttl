  rdfs:label "IDT 17.3.4 Transuranic Waste Processing or Storage Facility" ;
  rdfs:comment "Facilities that process and/or store radioactive waste containing more than regulatory-prescribed minimum amounts of radioactive elements of atomic number greater than 92.  " ;
  rdfs:subClassOf c:IDT_17_3 .
