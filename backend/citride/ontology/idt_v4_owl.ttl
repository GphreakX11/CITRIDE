  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_15_1_1 .

c:IDT_15_1_1_5 a owl:Class ;
  rdfs:label "IDT 15.1.1.5 Border Facility" ;
  rdfs:comment "Government buildings used at border crossing sites that provide immigration and customs control at the borders shared with Canada and Mexico." ;
  rdfs:subClassOf c:IDT_15_1_1 .
c:axiom-idt-15_1_1_5-parent a owl:Axiom ;
