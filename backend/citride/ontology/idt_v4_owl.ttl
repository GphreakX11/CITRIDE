c:IDT_11_4_2_1_2 a owl:Class ;
  rdfs:label "IDT 11.4.2.1.2 Shallow Draft Dry Bulk Cargo Terminal" ;
  rdfs:comment "Terminals designed to load or unload flowable dry commodities. These facilities may have ship loaders or unloaders on the wharf, or may utilize mobile cranes. Storage may be in structures (e.g., silos, sheds) or open (e.g., on pads, in bins)." ;
  rdfs:subClassOf c:IDT_11_4_2_1 .
c:axiom-idt-11_4_2_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_1 .

c:IDT_11_4_2_1_3 a owl:Class ;
  rdfs:label "IDT 11.4.2.1.3 Shallow Draft Liquid Bulk Cargo Terminal" ;
  rdfs:comment "Terminals designed to load or unload liquid commodities. These facilities have pipelines and manifolds at the waterside. They may or may not have wharves. Those without wharves have cells or \"dolphins\" for tying up vessels. These terminals may have tank storage on site or may feed pipelines directly from the vessel." ;
  rdfs:subClassOf c:IDT_11_4_2_1 .
c:axiom-idt-11_4_2_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_1 .

c:IDT_11_4_2_1_4 a owl:Class ;
  rdfs:label "IDT 11.4.2.1.4 Shallow Draft Barge Fleeting Area" ;
  rdfs:comment "A parking or staging area for barges awaiting loading, unloading, or transport." ;
  rdfs:subClassOf c:IDT_11_4_2_1 .
c:axiom-idt-11_4_2_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_1 .

c:IDT_11_4_2_1_5 a owl:Class ;
  rdfs:label "IDT 11.4.2.1.5 Shallow Draft Passenger Terminal" ;
  rdfs:comment "A terminal designed to handle the embarkation and debarkation of passengers from a vessel. " ;
  rdfs:subClassOf c:IDT_11_4_2_1 .
