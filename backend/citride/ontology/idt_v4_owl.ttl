c:IDT_8_4_1 a owl:Class ;
  rdfs:label "IDT 8.4.1 Internet Service Provider" ;
  rdfs:comment "Establishments that provide clients with access to the Internet and generally provide related services such as web hosting, web page designing, and hardware or software consulting related to Internet connectivity.  " ;
  rdfs:subClassOf c:IDT_8_4 .
c:axiom-idt-8_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
