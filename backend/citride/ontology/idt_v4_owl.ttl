  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_2_3 .

c:IDT_3_2_3_2 a owl:Class ;
  rdfs:label "IDT 3.2.3.2 Railroad Loading Rack" ;
  rdfs:comment "The shelter and associated equipment for the withdrawal of liquid petroleum or a chemical product from a storage tank and loading it into a railroad tank car or tank truck. \n" ;
  rdfs:subClassOf c:IDT_3_2_3 .
c:axiom-idt-3_2_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_2_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_2_3 .

c:IDT_3_2_4 a owl:Class ;
  rdfs:label "IDT 3.2.4 Road Transport" ;
  rdfs:comment "Road assets used for transporting hazardous chemicals.  " ;
  rdfs:subClassOf c:IDT_3_2 .
