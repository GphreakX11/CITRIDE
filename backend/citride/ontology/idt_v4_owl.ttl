  owl:annotatedTarget c:IDT_10_1_1_1 .

c:IDT_10_1_1_1_3 a owl:Class ;
  rdfs:label "IDT 10.1.1.1.3 State, Local, or Tribal General Medical and Surgical Hospital" ;
  rdfs:comment "Hospitals operated by state, local, or tribal government organizations (e.g., community hospital). " ;
  rdfs:subClassOf c:IDT_10_1_1_1 .
c:axiom-idt-10_1_1_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_1_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_1_1 .

c:IDT_10_1_1_2 a owl:Class ;
  rdfs:label "IDT 10.1.1.2 Psychiatric or Substance Abuse Hospital" ;
  rdfs:comment "Hospitals primarily engaged in providing diagnostic and medical treatment, and monitoring services for inpatients who suffer from mental illness or substance abuse disorders.  " ;
  rdfs:subClassOf c:IDT_10_1_1 .
c:axiom-idt-10_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_1 .

c:IDT_10_1_1_2_1 a owl:Class ;
  rdfs:label "IDT 10.1.1.2.1 Private or Not-for-Profit Psychiatric or Substance Abuse Hospital" ;
  rdfs:comment "Hospitals operated by private organizations, both profit and non-profit. " ;
  rdfs:subClassOf c:IDT_10_1_1_2 .
c:axiom-idt-10_1_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_1_2 .

