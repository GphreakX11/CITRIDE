c:IDT_17_2_2 a owl:Class ;
  rdfs:label "IDT 17.2.2 Radioactive and Nuclear Materials Transport" ;
  rdfs:comment "Transport of radioactive and nuclear materials for use and for waste disposal." ;
  rdfs:subClassOf c:IDT_17_2 .
c:axiom-idt-17_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
