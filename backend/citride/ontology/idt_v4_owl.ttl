c:IDT_16_3_4 a owl:Class ;
  rdfs:label "IDT 16.3.4 Non-Structural Mitigation Measure" ;
  rdfs:comment "A measure or feature not involving physical construction that reduces hurricane impacts." ;
  rdfs:subClassOf c:IDT_16_3 .
