c:IDT_14_5_1 a owl:Class ;
  rdfs:label "IDT 14.5.1 Office Building" ;
  rdfs:comment "Facilities housing business offices.  Includes small single-story offices for small businesses and large multi-story office buildings housing a number of tenants.  " ;
  rdfs:subClassOf c:IDT_14_5 .
c:axiom-idt-14_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_5 .

c:IDT_14_5_1_1 a owl:Class ;
  rdfs:label "IDT 14.5.1.1 Office Building - Stand Alone" ;
  rdfs:comment "Individual office buildings.  May be single- or multi-tenant.  " ;
  rdfs:subClassOf c:IDT_14_5_1 .
c:axiom-idt-14_5_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
