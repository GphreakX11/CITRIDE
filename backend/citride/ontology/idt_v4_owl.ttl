c:IDT_17_2_2_2 a owl:Class ;
  rdfs:label "IDT 17.2.2.2 High Hazard Radioactive Materials Transport" ;
  rdfs:comment "Transportation of quantities of radioactive material that must be transported in Type-B containers or higher-level packaging (e.g., casks). Generally occurs via rail, truck, or barge. " ;
  rdfs:subClassOf c:IDT_17_2_2 .
c:axiom-idt-17_2_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
