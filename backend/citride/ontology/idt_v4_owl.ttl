  owl:annotatedTarget c:IDT_6_2_2 .

c:IDT_6_2_3 a owl:Class ;
  rdfs:label "IDT 6.2.3 Fire & Emergency Services Apparatus" ;
  rdfs:comment "Fire apparatus and other vehicles used in fire and hazardous materials (HAZMAT) activities. Includes pumpers, ladder trucks, mobile command centers, marine vessels and aircraft." ;
  rdfs:subClassOf c:IDT_6_2 .
c:axiom-idt-6_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2 .

c:IDT_6_2_3_1 a owl:Class ;
  rdfs:label "IDT 6.2.3.1 Helicopter, Firefighting" ;
  rdfs:comment "Aircraft that depend principally on the lift generated by one or more rotors for its support in flight. Capable of the delivery of firefighters, water, or chemical retardants (either a fixed tank or bucket system), and internal or external cargo." ;
  rdfs:subClassOf c:IDT_6_2_3 .
c:axiom-idt-6_2_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_3 .

c:IDT_6_2_3_2 a owl:Class ;
  rdfs:label "IDT 6.2.3.2 Helitanker, Firefighting" ;
  rdfs:comment "Helicopters equipped with a fixed tank, Air Tanker Board certified, and capable of delivering a minimum of 1,100 gallons of water, retardant, or foam." ;
  rdfs:subClassOf c:IDT_6_2_3 .
c:axiom-idt-6_2_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_3 .

c:IDT_6_2_3_3 a owl:Class ;
  rdfs:label "IDT 6.2.3.3 Water Tender, Firefighting" ;
  rdfs:comment "Specialized firefighting apparatus designed for transporting water from a water source to a fire scene. Water tenders are capable of drafting water from a stream, lake or hydrant.  Water tenders are used when there is no working fire hydrant within reach of other fire equipment or when they can provide a very rapid connection to the fire engine(s)." ;
  rdfs:subClassOf c:IDT_6_2_3 .
c:axiom-idt-6_2_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_3 .

c:IDT_6_2_3_4 a owl:Class ;
  rdfs:label "IDT 6.2.3.4 Fire Engine " ;
  rdfs:comment "Any ground vehicle that provides specified levels of pumping, water, hose capacity, and staffed with a minimum number of personnel." ;
  rdfs:subClassOf c:IDT_6_2_3 .
c:axiom-idt-6_2_3_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_3_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_3 .

c:IDT_6_2_3_5 a owl:Class ;
  rdfs:label "IDT 6.2.3.5 Fire Boat     " ;
  rdfs:comment "Vessels or watercraft designed and constructed for the purpose of fighting fires providing specified level of pumping capacity. The boat is designed with the ability to carry firefighting foam and personnel to extinguish fires in the marine environment." ;
  rdfs:subClassOf c:IDT_6_2_3 .
c:axiom-idt-6_2_3_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_3_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_3 .

c:IDT_6_2_3_6 a owl:Class ;
  rdfs:label "IDT 6.2.3.6 Fire Truck, Aerial (Ladder or Platform)" ;
  rdfs:comment "Fire apparatus primarily used for search and rescue, or ventilation tasks." ;
  rdfs:subClassOf c:IDT_6_2_3 .
c:axiom-idt-6_2_3_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_3_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_3 .

c:IDT_6_2_3_7 a owl:Class ;
  rdfs:label "IDT 6.2.3.7 Foam Tender, Firefighting" ;
  rdfs:comment "Apparatus used to mix concentrate with water to make solution, pump, and mix air and solution to make foam, and transport and apply foam." ;
  rdfs:subClassOf c:IDT_6_2_3 .
c:axiom-idt-6_2_3_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_3_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_3 .

c:IDT_6_2_3_8 a owl:Class ;
  rdfs:label "IDT 6.2.3.8 Portable Pump" ;
  rdfs:comment "Portable, powered water pumping system designed to use untapped water sources for refilling fire engines." ;
  rdfs:subClassOf c:IDT_6_2_3 .
c:axiom-idt-6_2_3_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_3_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_3 .

c:IDT_6_2_3_9 a owl:Class ;
  rdfs:label "IDT 6.2.3.9 Brush Patrol Unit" ;
  rdfs:comment "Light, mobile vehicular units with limited pumping and water capacity for off-road operations." ;
  rdfs:subClassOf c:IDT_6_2_3 .
c:axiom-idt-6_2_3_9-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_3_9 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_3 .

c:IDT_6_2_3_10 a owl:Class ;
  rdfs:label "IDT 6.2.3.10 Gas Tanker or Aviation Gas (AvGas) Tanker" ;
  rdfs:comment "Vehicles that carry and dispense gasoline." ;
  rdfs:subClassOf c:IDT_6_2_3 .
