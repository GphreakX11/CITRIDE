  rdfs:label "IDT 11.6.1.3 Crude Oil Pipeline Control Center" ;
  rdfs:comment "Central control facilities that monitor and operate a pipeline(s). Includes supervisory control and data acquisition (SCADA) system control centers. " ;
  rdfs:subClassOf c:IDT_11_6_1 .
c:axiom-idt-11_6_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
