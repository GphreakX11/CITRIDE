  owl:annotatedTarget c:IDT_10_1_1_2 .

c:IDT_10_1_1_2_3 a owl:Class ;
  rdfs:label "IDT 10.1.1.2.3 State, Local, or Tribal Psychiatric or Substance Abuse Hospital" ;
  rdfs:comment "Hospitals operated by state, local, or tribal government organizations (e.g., veterans hospital). " ;
  rdfs:subClassOf c:IDT_10_1_1_2 .
c:axiom-idt-10_1_1_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
