  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_15_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_15 .

c:IDT_15_2_1 a owl:Class ;
  rdfs:label "IDT 15.2.1 Service-Oriented Building or Structure" ;
  rdfs:comment "Buildings geared towards providing services to government and the public. " ;
  rdfs:subClassOf c:IDT_15_2 .
