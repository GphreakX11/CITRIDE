c:IDT_9_1_4 a owl:Class ;
  rdfs:label "IDT 9.1.4 United States Postal Service Retail Center" ;
  rdfs:comment "Facilities serving a specific local area to receive mail and provide other postal services (e.g., post office, retail store fronts)." ;
  rdfs:subClassOf c:IDT_9_1 .
