  rdfs:label "IDT 5.2.6.1 Petroleum Product Pipeline" ;
  rdfs:comment "Pipeline facilities for the transport of petroleum products.  " ;
  rdfs:subClassOf c:IDT_5_2_6 .
c:axiom-idt-5_2_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
