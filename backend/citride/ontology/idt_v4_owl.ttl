  rdfs:label "IDT 1.2.2.3.1 Corn, Farina, and Grain Breakfast Cereal Manufacturing" ;
  rdfs:comment "Facilities engaged in manufacturing corn, farina, and grain breakfast cereal foods." ;
  rdfs:subClassOf c:IDT_1_2_2_3 .
c:axiom-idt-1_2_2_3_1-parent a owl:Axiom ;
