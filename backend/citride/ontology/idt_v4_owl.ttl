c:IDT_6_3 a owl:Class ;
  rdfs:label "IDT 6.3 Emergency Medical Services (EMS)" ;
  rdfs:comment "Includes federal, state, and local assets designed to provide medical care at the scene of an incident and during transport of victims to healthcare and public health facilities. Does not include hospital assets, which are categorized elsewhere." ;
  rdfs:subClassOf c:IDT_6 .
c:axiom-idt-6_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6 .

c:IDT_6_3_1 a owl:Class ;
  rdfs:label "IDT 6.3.1 Emergency Medical Services Administration Office/Headquarters" ;
  rdfs:comment "Central offices where Emergency Medical Services (EMS) activities in a jurisdiction are managed. Other functions include billing, report storage, policy development, and administration. Note: In many communities these offices are located in fire operational facilities or fire stations." ;
  rdfs:subClassOf c:IDT_6_3 .
c:axiom-idt-6_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
