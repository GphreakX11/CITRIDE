c:IDT_3_2_5 a owl:Class ;
  rdfs:label "IDT 3.2.5 Air Transport" ;
  rdfs:comment "Aviation facilities and assets (e.g., aircraft, airports) involved in the transport of hazardous chemicals by air.  " ;
  rdfs:subClassOf c:IDT_3_2 .
c:axiom-idt-3_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_2 .

c:IDT_3_3 a owl:Class ;
  rdfs:label "IDT 3.3 Hazardous Chemical Storage/Stockpile/Utilization/Distribution" ;
  rdfs:comment "Facilities or assets that do not manufacture hazardous chemicals but have hazardous chemicals on-site, in storage, for use in other manufacturing operations, or for an end use activity. Facilities that manufacture hazardous chemicals are included in the Hazardous Chemical Manufacturing or Processing Plant sub-sector (3.1)." ;
  rdfs:subClassOf c:IDT_3 .
c:axiom-idt-3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3 .

c:IDT_3_3_1 a owl:Class ;
  rdfs:label "IDT 3.3.1 Warehousing and Storage" ;
  rdfs:comment "Facilities or assets primarily engaged in operating warehousing and storage facilities for hazardous chemicals and potentially other warehouse products. May or may not sell the goods they handle. May provide a range of services, often referred to as logistics services, related to the distribution of hazardous chemicals." ;
  rdfs:subClassOf c:IDT_3_3 .
c:axiom-idt-3_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_3 .

c:IDT_3_3_1_1 a owl:Class ;
  rdfs:label "IDT 3.3.1.1 Bulk Storage" ;
  rdfs:comment "Facilities or assets used for the storage and/or marketing of hazardous chemicals. Includes storage tanks, pipes and pumps, control machinery, and other equipment. These facilities are not used to store hazardous chemicals for final consumption. Also referred to as tank farms." ;
  rdfs:subClassOf c:IDT_3_3_1 .
c:axiom-idt-3_3_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_3_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_3_1 .

c:IDT_3_3_1_1_1 a owl:Class ;
  rdfs:label "IDT 3.3.1.1.1 Land-Based Bulk Terminal" ;
  rdfs:comment "Facilities or assets that receive and distribute chemicals via pipeline, marine vessel, rail, or truck from either domestic or import suppliers. Includes the valves, piping, control machinery, and other equipment to connect the terminal to the suppliers serving it." ;
  rdfs:subClassOf c:IDT_3_3_1_1 .
c:axiom-idt-3_3_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_3_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_3_1_1 .

c:IDT_3_3_1_1_2 a owl:Class ;
  rdfs:label "IDT 3.3.1.1.2 Marine Bulk Terminal" ;
  rdfs:comment "Large terminal located on a waterway. Generally receives and distributes its petroleum via pipeline, barge, or marine tanker from either domestic or foreign suppliers." ;
  rdfs:subClassOf c:IDT_3_3_1_1 .
c:axiom-idt-3_3_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_3_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_3_1_1 .

c:IDT_3_3_1_2 a owl:Class ;
  rdfs:label "IDT 3.3.1.2 Retail Distribution" ;
  rdfs:comment "Facilities or assets used to store hazardous chemicals for retail distribution to end use customers." ;
  rdfs:subClassOf c:IDT_3_3_1 .
c:axiom-idt-3_3_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_3_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_3_1 .

c:IDT_3_3_2 a owl:Class ;
  rdfs:label "IDT 3.3.2 Storage at Manufacturing Facility" ;
  rdfs:comment "Establishments (other than chemical manufacturers) that use hazardous chemicals in the manufacturing and production of other products. They purchase hazardous chemicals from manufacturers and/or from wholesalers." ;
  rdfs:subClassOf c:IDT_3_3 .
c:axiom-idt-3_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_3_2 ;
