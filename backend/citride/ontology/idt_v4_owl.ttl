c:IDT_9_1_3_4 a owl:Class ;
  rdfs:label "IDT 9.1.3.4 United States Postal Service Network Distribution Center" ;
  rdfs:comment "Highly mechanized mail processing plants that distribute standard mail in piece and bulk form. (Formerly known as Bulk Mail Centers.)" ;
  rdfs:subClassOf c:IDT_9_1_3 .
c:axiom-idt-9_1_3_4-parent a owl:Axiom ;
