  rdfs:label "IDT 16.1.6.1 Navigation Lock" ;
  rdfs:comment "Walled section of a river or canal, closed by water gates at both ends, in which the water level can be raised or lowered by means of valves or sluiceways to match the level in the upper or lower reach. " ;
  rdfs:subClassOf c:IDT_16_1_6 .
