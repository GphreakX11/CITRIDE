  owl:annotatedTarget c:IDT_10_1 .

c:IDT_10_1_1_1 a owl:Class ;
  rdfs:label "IDT 10.1.1.1 General Medical and Surgical Hospital" ;
  rdfs:comment "Hospitals primarily engaged in providing diagnostic and medical treatment (both surgical and non-surgical) to inpatients with a of a wide variety of medical conditions." ;
  rdfs:subClassOf c:IDT_10_1_1 .
c:axiom-idt-10_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_1 .

