  owl:annotatedTarget c:IDT_6_5 .

c:IDT_6_5_2 a owl:Class ;
  rdfs:label "IDT 6.5.2 Public Works Operational Facility" ;
  rdfs:comment "Facilities used for day-to-day public works operations. Public works facilities can vary widely but are typically related to urban infrastructure or rural development projects (e.g., water purification plants, sewage treatment facilities).  " ;
  rdfs:subClassOf c:IDT_6_5 .
c:axiom-idt-6_5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_5_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_5 .

