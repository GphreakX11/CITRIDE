  rdfs:label "IDT 16.1.5.3 Pumped-Storage Plant" ;
  rdfs:comment "Power generation facility designed to generate electricity for peak load by releasing water previously pumped into an elevated storage reservoir, usually during off-peak periods." ;
  rdfs:subClassOf c:IDT_16_1_5 .
