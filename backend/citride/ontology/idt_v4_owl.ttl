c:IDT_12 a owl:Class ;
  rdfs:label "IDT 12 Water" ;
  rdfs:comment "The Water Sector includes both drinking water and wastewater utilities and systems." ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-12-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
