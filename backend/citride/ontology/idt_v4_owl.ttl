  rdfs:label "IDT 1.5.2.7 Meat and Meat Product Merchant Wholesaler" ;
  rdfs:comment "Establishments primarily engaged in the merchant wholesale distribution of meats and meat products (except canned and packaged frozen) and/or lard." ;
  rdfs:subClassOf c:IDT_1_5_2 .
c:axiom-idt-1_5_2_7-parent a owl:Axiom ;
