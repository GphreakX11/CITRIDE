  rdfs:label "IDT 17.2.4.1 Radioactive Device Manufacturing" ;
  rdfs:comment "Facilities in which sources are assembled into devices that allow for irradiation, sterilization, or medical procedures." ;
  rdfs:subClassOf c:IDT_17_2_4 .
