c:IDT_3_2_4_2 a owl:Class ;
  rdfs:label "IDT 3.2.4.2 Tanker Truck Loading Rack" ;
  rdfs:comment "Facilities at some storage facilities and chemical plants that are used to load tanker trucks that deliver chemicals.  " ;
  rdfs:subClassOf c:IDT_3_2_4 .
c:axiom-idt-3_2_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
