c:IDT_1_2_3_2 a owl:Class ;
  rdfs:label "IDT 1.2.3.2 Confectionary Manufacturing" ;
  rdfs:comment "Establishments primarily engaged in manufacturing confectioneries. Includes chocolate and non-chocolate confectionaries." ;
  rdfs:subClassOf c:IDT_1_2_3 .
c:axiom-idt-1_2_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_3 .

c:IDT_1_2_3_2_1 a owl:Class ;
  rdfs:label "IDT 1.2.3.2.1  Chocolate and Confectionary Manufacturing from Cacao Beans " ;
  rdfs:comment "Facilities primarily engaged in shelling, roasting, and grinding cacao beans and making chocolate cacao products and chocolate confectioneries." ;
  rdfs:subClassOf c:IDT_1_2_3_2 .
c:axiom-idt-1_2_3_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_3_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_3_2 .

c:IDT_1_2_3_2_2 a owl:Class ;
  rdfs:label "IDT 1.2.3.2.2 Confectionary Manufacturing from Purchased Chocolate" ;
  rdfs:comment "Facilities primarily engaged in manufacturing chocolate confectioneries from chocolate produced elsewhere. Included in this industry are establishments primarily engaged in retailing chocolate confectionery products not for immediate consumption made on the premises from chocolate made elsewhere." ;
  rdfs:subClassOf c:IDT_1_2_3_2 .
c:axiom-idt-1_2_3_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_3_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_3_2 .

c:IDT_1_2_3_2_3 a owl:Class ;
  rdfs:label "IDT 1.2.3.2.3 Non-Chocolate Confectionary Manufacturing " ;
  rdfs:comment "Facilities primarily engaged in manufacturing non-chocolate confectioneries. Included in this industry are establishments primarily engaged in retailing non-chocolate confectionery products not for immediate consumption made on the premises. " ;
  rdfs:subClassOf c:IDT_1_2_3_2 .
c:axiom-idt-1_2_3_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_3_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_3_2 .

c:IDT_1_2_4 a owl:Class ;
  rdfs:label "IDT 1.2.4 Fruit/Vegetable Preserving, Specialty Food Manufacturing Facility" ;
  rdfs:comment "Establishments primarily engaged in manufacturing canned, pickled, and dried fruits, vegetables, and specialty foods. Establishments in this industry may package the dried or dehydrated ingredients they make with other purchased ingredients. Examples of products made by these establishments are canned juices, canned baby foods, canned soups (except seafood), canned dry beans, canned tomato-based sauces, such as catsup, salsa, chili, spaghetti, barbeque, and tomato paste, pickles, relishes, jams and jellies, dried soup mixes and bullions, and sauerkraut." ;
  rdfs:subClassOf c:IDT_1_2 .
c:axiom-idt-1_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2 .

c:IDT_1_2_4_1 a owl:Class ;
  rdfs:label "IDT 1.2.4.1 Frozen Food Manufacturing Facility" ;
  rdfs:comment "Facilities primarily engaged in manufacturing frozen fruit, frozen juices, frozen vegetables, and frozen specialty foods (except seafood), such as frozen dinners, entrees, and side dishes, frozen pizza, frozen whipped toppings, and others." ;
  rdfs:subClassOf c:IDT_1_2_4 .
c:axiom-idt-1_2_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_4 .

c:IDT_1_2_4_1_1 a owl:Class ;
  rdfs:label "IDT 1.2.4.1.1 Frozen Fruit, Juice and Vegetable Manufacturing " ;
  rdfs:comment "Facilities primarily engaged in manufacturing frozen fruits; frozen vegetables; and frozen fruit juices, ades, drinks, cocktail mixes and concentrates." ;
  rdfs:subClassOf c:IDT_1_2_4_1 .
c:axiom-idt-1_2_4_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_4_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_4_1 .

c:IDT_1_2_4_1_2 a owl:Class ;
  rdfs:label "IDT 1.2.4.1.2  Frozen Specialty Food Manufacturing" ;
  rdfs:comment "Facilities primarily engaged in manufacturing frozen specialty foods (except seafood), such as frozen dinners, entrees, and side dishes; frozen pizza; frozen whipped topping; and frozen waffles, pancakes, and french toast." ;
  rdfs:subClassOf c:IDT_1_2_4_1 .
c:axiom-idt-1_2_4_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_4_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_4_1 .

c:IDT_1_2_4_2 a owl:Class ;
  rdfs:label "IDT 1.2.4.2 Fruit and Vegetable Canning, Pickling, Drying" ;
  rdfs:comment "Facilities primarily engaged in manufacturing canned, pickled, and dried fruits, vegetables, and specialty foods, and may package the dried or dehydrated ingredients they make with other purchased ingredients. Examples of products made in these facilities are canned juices, canned baby foods, canned soups (except seafood), canned dry beans, canned tomato-based sauces, pickles, relishes, jams and jellies, dried soup mixes and bullions, and others." ;
  rdfs:subClassOf c:IDT_1_2_4 .
c:axiom-idt-1_2_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_4 .

c:IDT_1_2_4_2_1 a owl:Class ;
  rdfs:label "IDT 1.2.4.2.1 Fruit and Vegetable Canning " ;
  rdfs:comment "Facilities primarily engaged in manufacturing canned, pickled, and brined fruits and vegetables. Examples of products made in these establishments are canned juices; canned jams and jellies; canned tomato-based sauces, such as catsup, salsa, chili, spaghetti, barbeque, and tomato paste; pickles, relishes, and sauerkraut. " ;
  rdfs:subClassOf c:IDT_1_2_4_2 .
c:axiom-idt-1_2_4_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_4_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_4_2 .

c:IDT_1_2_4_2_2 a owl:Class ;
  rdfs:label "IDT 1.2.4.2.2 Specialty Canning  " ;
  rdfs:comment "Facilities primarily engaged in manufacturing canned specialty foods. Examples of products made in these establishments are canned baby food, canned baked beans, canned soups (except seafood), canned spaghetti, and other canned nationality foods. " ;
  rdfs:subClassOf c:IDT_1_2_4_2 .
c:axiom-idt-1_2_4_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_4_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_4_2 .

c:IDT_1_2_4_2_3 a owl:Class ;
  rdfs:label "IDT 1.2.4.2.3 Dried and Dehydrated Food Manufacturing" ;
  rdfs:comment "Facilities primarily engaged in (1) drying (including freeze-dried) and/or dehydrating fruits, vegetables, and soup mixes and bouillon and/or (2) drying and/or dehydrating ingredients and packaging them with other purchased ingredients, such as rice and dry pasta." ;
  rdfs:subClassOf c:IDT_1_2_4_2 .
c:axiom-idt-1_2_4_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_4_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_4_2 .

c:IDT_1_2_5 a owl:Class ;
  rdfs:label "IDT 1.2.5 Dairy Product Manufacturing (Except Frozen)" ;
  rdfs:comment "Facilities primarily engaged in manufacturing dairy products from raw milk and/or processed milk products, manufacturing dairy substitutes from soybeans and other non-dairy substances, and manufacturing dry, condensed, concentrated, and evaporated dairy and dairy substitute products." ;
  rdfs:subClassOf c:IDT_1_2 .
c:axiom-idt-1_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2 .

c:IDT_1_2_5_1 a owl:Class ;
  rdfs:label "IDT 1.2.5.1 Fluid Milk Manufacturing" ;
  rdfs:comment "Establishments primarily engaged in (1) manufacturing processed milk products, such as pasteurized milk or cream and sour cream and/or (2) manufacturing fluid milk dairy substitutes from soybeans and other non-dairy substances." ;
  rdfs:subClassOf c:IDT_1_2_5 .
c:axiom-idt-1_2_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_5 .

c:IDT_1_2_5_1_1 a owl:Class ;
  rdfs:label "IDT 1.2.5.1.1 Acidophilus Milk Manufacturing" ;
  rdfs:comment "Facilities primarily engaged in manufacturing acidophilus milk." ;
  rdfs:subClassOf c:IDT_1_2_5_1 .
c:axiom-idt-1_2_5_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_5_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_5_1 .

c:IDT_1_2_5_1_2 a owl:Class ;
  rdfs:label "IDT 1.2.5.1.2 Milk Based Beverage Manufacturing (Except Dietary)" ;
  rdfs:comment "Facilities primarily engaged in manufacturing milk based beverages (except dietary)." ;
  rdfs:subClassOf c:IDT_1_2_5_1 .
