  rdfs:comment "Stations along the length of a pipeline. Includes pumps, valves, control machinery, and breakout storage. " ;
  rdfs:subClassOf c:IDT_11_6_2 .
c:axiom-idt-11_6_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
