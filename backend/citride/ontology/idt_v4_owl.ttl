c:IDT_14_2_2 a owl:Class ;
  rdfs:label "IDT 14.2.2 Stand Alone Casino" ;
  rdfs:comment "Casinos that have no other functions such as lodging, shopping, or convention facilities." ;
  rdfs:subClassOf c:IDT_14_2 .
