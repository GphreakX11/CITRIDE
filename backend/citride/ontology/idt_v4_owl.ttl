  rdfs:label "IDT 1.5.2.3 Dairy Product Merchant Wholesaler (Except Dried or Canned)" ;
  rdfs:comment "Establishments primarily engaged in the merchant wholesale distribution of dairy products (except dried or canned)." ;
  rdfs:subClassOf c:IDT_1_5_2 .
