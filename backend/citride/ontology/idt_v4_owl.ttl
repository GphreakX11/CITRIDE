  owl:annotatedTarget c:IDT_2_3 .

c:IDT_2_3_5 a owl:Class ;
  rdfs:label "IDT 2.3.5 Insurance Regulatory, Oversight, or Industry Organization" ;
  rdfs:comment "Organizations that provide technical, operation, pricing, and business oversight and support to insurance organizations.  " ;
  rdfs:subClassOf c:IDT_2_3 .
c:axiom-idt-2_3_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_2_3_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_2_3 .

c:IDT_2_3_5_1 a owl:Class ;
  rdfs:label "IDT 2.3.5.1 Federal Insurance Agency" ;
  rdfs:comment "Federal agencies that deal with the insurance industry." ;
  rdfs:subClassOf c:IDT_2_3_5 .
