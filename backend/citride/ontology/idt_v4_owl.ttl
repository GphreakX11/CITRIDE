  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_4 .

c:IDT_11_4_4_3 a owl:Class ;
  rdfs:label "IDT 11.4.4.3 Navigation Lock" ;
  rdfs:comment "Walled section of a river or canal, closed by water gates at both ends, in which the water level can be raised or lowered by means of valves or sluiceways to match the level in the upper or lower reach, as desired. When the levels are the same, the water gate is opened to permit a vessel to enter or leave the lock." ;
  rdfs:subClassOf c:IDT_11_4_4 .
c:axiom-idt-11_4_4_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_4_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_4 .

c:IDT_11_4_4_4 a owl:Class ;
  rdfs:label "IDT 11.4.4.4 Canal" ;
  rdfs:comment "A constructed channel, usually open, that conveys water by gravity to farms, municipalities, etc. Artificial watercourse of perceptible extent, with a definite bed and banks to confine and conduct continuously or periodically flowing water." ;
  rdfs:subClassOf c:IDT_11_4_4 .
c:axiom-idt-11_4_4_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_4_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_4 .

c:IDT_11_4_4_5 a owl:Class ;
  rdfs:label "IDT 11.4.4.5 Dam" ;
  rdfs:comment "Water retention structures used for irrigation, electricity generation, water supply storage, flood control, navigation, fisheries, recreation, sediment and hazardous materials control, or mine tailings impoundments. Many dams have multiple uses." ;
  rdfs:subClassOf c:IDT_11_4_4 .
c:axiom-idt-11_4_4_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_4_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_4 .

