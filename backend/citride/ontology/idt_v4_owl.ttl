  rdfs:label "IDT 5.3.5.2.1 Liquefied Natural Gas (LNG) Tanker" ;
  rdfs:comment "Specially-designed ships for carrying liquefied natural gas (LNG) and maintaining very low temperatures. Generally used for imported LNG." ;
  rdfs:subClassOf c:IDT_5_3_5_2 .
c:axiom-idt-5_3_5_2_1-parent a owl:Axiom ;
