  rdfs:label "IDT 1.2.2.3.4 Instant Hot Cereal Manufacturing" ;
  rdfs:comment "Facilities engaged in manufacturing instant hot cereal foods." ;
  rdfs:subClassOf c:IDT_1_2_2_3 .
