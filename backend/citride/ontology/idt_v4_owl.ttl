c:IDT_1_2_2_3_2 a owl:Class ;
  rdfs:label "IDT 1.2.2.3.2 Grain Mills, Breakfast Cereal" ;
  rdfs:comment "Facilities engaged in manufacturing flour and grain mills breakfast cereal foods." ;
  rdfs:subClassOf c:IDT_1_2_2_3 .
