c:IDT_6_5_1 a owl:Class ;
  rdfs:label "IDT 6.5.1 Public Works Administration Office/Headquarters" ;
  rdfs:comment "Facilities where the following activities take place: operations management and supervision, financial management and reporting, public relations, procurement of professional services, requesting and evaluating proposals, awarding bids and contract management." ;
  rdfs:subClassOf c:IDT_6_5 .
