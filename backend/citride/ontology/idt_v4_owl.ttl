  owl:annotatedTarget c:IDT_17_2_3 .

c:IDT_17_2_3_2 a owl:Class ;
  rdfs:label "IDT 17.2.3.2 Research Facility With Radioactive Materials" ;
  rdfs:comment "Research facilities using radioactive materials in their research efforts." ;
  rdfs:subClassOf c:IDT_17_2_3 .
