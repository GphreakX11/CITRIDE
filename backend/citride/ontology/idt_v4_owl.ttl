  rdfs:label "IDT 17.2.1.5.3 Category III Facility (Special Nuclear Materials - Low Strategic Significance) " ;
  rdfs:comment "Facilities handling special nuclear materials designated as Category III by the Nuclear Regulatory Commission (NRC)." ;
  rdfs:subClassOf c:IDT_17_2_1_5 .
