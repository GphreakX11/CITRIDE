c:IDT_7 a owl:Class ;
  rdfs:label "IDT 7 Information Technology" ;
  rdfs:comment "The Information Technology (IT) Sector is comprised of physical assets and virtual systems and networks that enable key capabilities and services in both the public and private sectors. Functions are sets of processes that produce, provide, and maintain products and services. These functions encompass the full set of processes involved in creating IT products and services, including R&D, manufacturing, distribution, upgrades, and maintenance. They also support the sector’s ability to produce and provide high-assurance products, services, and practices that are resilient to threats and can be rapidly recovered. Critical IT Sector facilities, operations, and services provide for the design, development, distribution, and support of IT products (hardware and software) and operational support services that are essential or critical to maintain or reconstitute IT Sector critical functions." ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_7_1 a owl:Class ;
  rdfs:label "IDT 7.1 Hardware Production" ;
  rdfs:comment "Facilities that support the production of hardware computing equipment, such as computer peripherals, networking equipment, personal computers, and similar electronic products, or that manufacture components for such products. " ;
  rdfs:subClassOf c:IDT_7 .
c:axiom-idt-7_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7 .

c:IDT_7_1_1 a owl:Class ;
  rdfs:label "IDT 7.1.1 Network Development" ;
  rdfs:comment "Facilities that support the production of network access and communication devices, security hardware, routing and switching equipment, and wireless networking products." ;
  rdfs:subClassOf c:IDT_7_1 .
c:axiom-idt-7_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_1 .

c:IDT_7_1_2 a owl:Class ;
  rdfs:label "IDT 7.1.2 Semiconductor Production" ;
  rdfs:comment "Facilities that support the production of electronic devices used by or incorporated into other hardware equipment." ;
  rdfs:subClassOf c:IDT_7_1 .
c:axiom-idt-7_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_1 .

c:IDT_7_1_3 a owl:Class ;
  rdfs:label "IDT 7.1.3 Storage Hardware Production" ;
  rdfs:comment "Facilities that support the production of large-scale storage systems, including magnetic and optical data storage systems." ;
  rdfs:subClassOf c:IDT_7_1 .
c:axiom-idt-7_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_1 .

c:IDT_7_1_4 a owl:Class ;
  rdfs:label "IDT 7.1.4 Domain Name System Appliance Production" ;
  rdfs:comment "Facilities that support the production of appliances that support Domain Name System (DNS) functions. Examples include (but are not limited to) servers, network management appliances, and specialized DNS appliances." ;
  rdfs:subClassOf c:IDT_7_1 .
c:axiom-idt-7_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_1 .

c:IDT_7_1_5 a owl:Class ;
  rdfs:label "IDT 7.1.5 Identity Management Technology Production" ;
  rdfs:comment "Facilities that support the incorporation and verification of legitimate individual digital identities to include credential hardware and software and credential verification devices and software." ;
  rdfs:subClassOf c:IDT_7_1 .
c:axiom-idt-7_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_1 .

c:IDT_7_1_6 a owl:Class ;
  rdfs:label "IDT 7.1.6 Control Systems Hardware Production" ;
  rdfs:comment "Facilities that support the production of hardware designed to monitor and control sensitive processes and physical functions. This hardware includes distributed control systems (typically used within a single processing plant or over a small geographic area) and supervisory control and data acquisition (SCADA) systems (typically used for large, geographically dispersed systems)." ;
  rdfs:subClassOf c:IDT_7_1 .
c:axiom-idt-7_1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_1 .

c:IDT_7_1_6_1 a owl:Class ;
  rdfs:label "IDT 7.1.6.1 Field Devices Production" ;
  rdfs:comment "Facilities that support the production of units receiving real time process information (e.g., voltage, current, power, pressures, flows, temperatures) and provide control to actuators to change or maintain a process (e.g., breakers, valves, frequency, speed control). These operate with supervisory control and data acquisition Systems (SCADA) and distributed control systems (DCS). Some could stand alone, are network based, and have potential cyber vulnerabilities. Examples of these are the remote terminal units (RTUs), intelligent electronic devices (IEDs), programmable logic controllers  (PLCs), and intelligent sensors." ;
  rdfs:subClassOf c:IDT_7_1_6 .
c:axiom-idt-7_1_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_1_6_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_1_6 .

c:IDT_7_1_7 a owl:Class ;
  rdfs:label "IDT 7.1.7 Other Hardware Production Facility" ;
  rdfs:comment "Hardware production facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_7_1 .
c:axiom-idt-7_1_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_1_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_1 .

c:IDT_7_2 a owl:Class ;
  rdfs:label "IDT 7.2 Software Production" ;
  rdfs:comment "Facilities that support the production of software, such as operating systems, utilities software, wireless software, or that produce components for such products. " ;
  rdfs:subClassOf c:IDT_7 .
c:axiom-idt-7_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7 .

c:IDT_7_2_1 a owl:Class ;
  rdfs:label "IDT 7.2.1 Security Software Production" ;
  rdfs:comment "Facilities that support the production of software for cyber security and policy compliance elements." ;
  rdfs:subClassOf c:IDT_7_2 .
c:axiom-idt-7_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_2 .

c:IDT_7_2_2 a owl:Class ;
  rdfs:label "IDT 7.2.2 Operating System Development" ;
  rdfs:comment "Facilities that support the production of software that communicates with computer hardware. Operating systems perform basic tasks, such as recognizing input from the keyboard, sending output to the display screen, keeping track of files and directories on the disk, and controlling peripheral devices such as disk drives and printers (e.g., Microsoft, Unix, Apple, IBM, supercomputing, render farms, mainframes, servers, workstations, desktops, handheld devices, real-time systems, embedded systems, and components)." ;
  rdfs:subClassOf c:IDT_7_2 .
c:axiom-idt-7_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_2 .

c:IDT_7_2_3 a owl:Class ;
  rdfs:label "IDT 7.2.3 Business Software Production" ;
  rdfs:comment "Facilities that support the production of software that manages business productivity, industrial processes, customer care, and retail operations; controls the organization, storage, retrieval, security and integrity of data in a database; and enables analytics, data mining, data warehousing, forecasting, querying, reporting, and data analysis." ;
  rdfs:subClassOf c:IDT_7_2 .
c:axiom-idt-7_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_2 .

c:IDT_7_2_4 a owl:Class ;
  rdfs:label "IDT 7.2.4 Control System Software" ;
  rdfs:comment "Facilities that produce software that supports hardware designed to monitor and control sensitive processes and physical functions. This hardware includes distributed control systems (typically used within a single processing plant or over a small geographic area) and supervisory control and data acquisition (SCADA) systems (typically used for large, geographically dispersed systems)." ;
  rdfs:subClassOf c:IDT_7_2 .
c:axiom-idt-7_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_2 .

c:IDT_7_2_4_1 a owl:Class ;
  rdfs:label "IDT 7.2.4.1 Field Device Software" ;
  rdfs:comment "Facilities that support the production of software that will receive real time process information (e.g., voltage, current, power, pressures, flows, temperatures) and provide control to actuators to change or maintain a process (e.g., breakers, valves, frequency, speed control). This software operates with supervisory control and data acquisition (SCADA) and distributed control system (DCS) devices. Some devices could stand alone, are network based, and have potential cyber vulnerabilities. Examples of these devices are the remote terminal units (RTUs), intelligent electronic devices (IEDs), programmable logic controllers (PLCs), and intelligent sensors." ;
  rdfs:subClassOf c:IDT_7_2_4 .
c:axiom-idt-7_2_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_2_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_2_4 .

c:IDT_7_2_5 a owl:Class ;
  rdfs:label "IDT 7.2.5 Other Software Development Facility" ;
  rdfs:comment "Software production facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_7_2 .
c:axiom-idt-7_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_2 .

c:IDT_7_3 a owl:Class ;
  rdfs:label "IDT 7.3 Internet-Based Content, Information, and Communications Services" ;
  rdfs:comment "Facilities and establishments engaged in the operation, support, development, and administration of the Internet and its services and products.  " ;
  rdfs:subClassOf c:IDT_7 .
c:axiom-idt-7_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7 .

c:IDT_7_3_1 a owl:Class ;
  rdfs:label "IDT 7.3.1 Internet Support Service" ;
  rdfs:comment "Facilities that conduct and\\or provide internet services and support to preparedness and response, geospatial services and mapping, world wide web, communication and other internet based capabilities." ;
  rdfs:subClassOf c:IDT_7_3 .
c:axiom-idt-7_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_3 .

c:IDT_7_3_1_1 a owl:Class ;
  rdfs:label "IDT 7.3.1.1 Fundamental Internet Service" ;
  rdfs:comment "Facilities that support the production of services for Internet access or management and monitoring of Internet access at a high level (e.g., Internet backbone services, Internet performance tracking, global traffic management, Internet Protocol [IP] address assignment, domain name services)." ;
  rdfs:subClassOf c:IDT_7_3_1 .
c:axiom-idt-7_3_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_3_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_3_1 .

c:IDT_7_3_1_2 a owl:Class ;
  rdfs:label "IDT 7.3.1.2 Local Internet Service" ;
  rdfs:comment "Facilities that support the production of Internet access or management and monitoring of Internet access at a low level (e.g. local Internet access, benchmarking services, domain name services)." ;
  rdfs:subClassOf c:IDT_7_3_1 .
c:axiom-idt-7_3_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_3_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_3_1 .

c:IDT_7_3_2 a owl:Class ;
  rdfs:label "IDT 7.3.2 Internet Licensing Service" ;
  rdfs:comment "Facilities that operate domain registration services, top-level domain (TLD) /root infrastructures, and resolution services." ;
  rdfs:subClassOf c:IDT_7_3 .
c:axiom-idt-7_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_3 .

c:IDT_7_3_3 a owl:Class ;
  rdfs:label "IDT 7.3.3 Internet Routing, Access, and Connection Facility" ;
  rdfs:comment "Facilities that house critical carrier equipment and data servers. Assets that provide and\\or support Internet infrastructures, points of presence, peering points, local access services and capabilities. " ;
  rdfs:subClassOf c:IDT_7_3 .
c:axiom-idt-7_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_3 .

c:IDT_7_3_4 a owl:Class ;
  rdfs:label "IDT 7.3.4 Other Internet Support or Production Service Facility" ;
  rdfs:comment "Internet-based content, information, and communication services, facilities, and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_7_3 .
c:axiom-idt-7_3_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_3_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_3 .

c:IDT_7_4 a owl:Class ;
  rdfs:label "IDT 7.4 Other Hardware Production Facility" ;
  rdfs:comment "Facilities that support the production of information technology services.  Includes development, marketing, delivery, and support of information services, managed services, transaction processing, and others.  " ;
  rdfs:subClassOf c:IDT_7 .
c:axiom-idt-7_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7 .

c:IDT_7_4_1 a owl:Class ;
  rdfs:label "IDT 7.4.1 IT Management Service" ;
  rdfs:comment "Facilities that support outsourced functions for a particular area of Information Technology (IT) on a long-term basis (e.g., managed data center services, managed security services, managed storage services, managed network services, technical support services, application service provider services, collocation services, custom software development, systems integration)." ;
  rdfs:subClassOf c:IDT_7_4 .
c:axiom-idt-7_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_4 .

c:IDT_7_4_2 a owl:Class ;
  rdfs:label "IDT 7.4.2 Identity Management and Trust Service" ;
  rdfs:comment "Facilities that provide services, technologies, and infrastructure to ensure the identity, authenticate and authorize entities and ensure confidentiality, integrity, and availability of devices, services, data, and transactions." ;
  rdfs:subClassOf c:IDT_7_4 .
c:axiom-idt-7_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_4 .

c:IDT_7_4_3 a owl:Class ;
  rdfs:label "IDT 7.4.3 IT Quality Assurance Service" ;
  rdfs:comment "Facilities that support steps taken by an organization to ensure that systems are designed, developed, and maintained using formalized and rigorous controls and standards." ;
  rdfs:subClassOf c:IDT_7_4 .
c:axiom-idt-7_4_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_4_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_4 .

c:IDT_7_4_4 a owl:Class ;
  rdfs:label "IDT 7.4.4 Other Operational Support Service Facility" ;
  rdfs:comment "Other operational support service facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_7_4 .
c:axiom-idt-7_4_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_4_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7_4 .

c:IDT_7_5 a owl:Class ;
  rdfs:label "IDT 7.5 Regulatory, Oversight, or Industry Organization" ;
  rdfs:comment "Facilities that provide technical, operation, pricing, and business oversight and support to the various components of the Information Technology (IT) system. " ;
  rdfs:subClassOf c:IDT_7 .
c:axiom-idt-7_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7 .

c:IDT_7_6 a owl:Class ;
  rdfs:label "IDT 7.6 Other Information Technology Facility" ;
  rdfs:comment "Information Technology (IT) facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_7 .
c:axiom-idt-7_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_7_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_7 .

c:IDT_8 a owl:Class ;
  rdfs:label "IDT 8 Communications" ;
  rdfs:comment "Establishments primarily engaged in operating, maintaining, and/or providing access to facilities for the transmission of voice, data, text, sound, and video. A communications facility may be based on a single technology or a combination of technologies." ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_8_1 a owl:Class ;
  rdfs:label "IDT 8.1 Wired Communication" ;
  rdfs:comment "Establishments engaged in operating and maintaining switching and transmission facilities to provide point-to-point communications via landlines (e.g., copper wire, fiber optic), microwave, or a combination of landlines and satellite linkups or furnishing telegraph and other non-vocal communications using their own facilities. Includes facilities termed the public switched telephone network (PSTN)." ;
  rdfs:subClassOf c:IDT_8 .
c:axiom-idt-8_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8 .

c:IDT_8_1_1 a owl:Class ;
  rdfs:label "IDT 8.1.1 Switching Facility" ;
  rdfs:comment "Nodes in the communications network where lines and trunks are connected to form a communication path." ;
  rdfs:subClassOf c:IDT_8_1 .
c:axiom-idt-8_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1 .

c:IDT_8_1_1_1 a owl:Class ;
  rdfs:label "IDT 8.1.1.1 Local Exchange Facility" ;
  rdfs:comment "Switching facilities that serve a local area. Also called end offices or central offices. Lines from homes and businesses terminate in a local exchange facility (end office or central office). These facilities connect customers within the area together. Typically, calls within an exchange area served by these facilities are considered local calls." ;
  rdfs:subClassOf c:IDT_8_1_1 .
c:axiom-idt-8_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_1 .

c:IDT_8_1_1_2 a owl:Class ;
  rdfs:label "IDT 8.1.1.2 Local and Access Tandem Switching Facility" ;
  rdfs:comment "Switching facilities that concentrate and distribute call traffic. They generally connect higher volume trunk lines to each other. Local tandem switches generally connect trunk lines from one local exchange to another within a metropolitan area. Access tandem switches generally connect trunk lines from local exchange facilities into the long distance network.  " ;
  rdfs:subClassOf c:IDT_8_1_1 .
c:axiom-idt-8_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_1 .

c:IDT_8_1_1_3 a owl:Class ;
  rdfs:label "IDT 8.1.1.3 Inter-Exchange Switching Facility" ;
  rdfs:comment "Switching facilities that handle long distance traffic. Sometimes referred to as \"toll\" switches. A facility may house the switches owned by competing telephone service providers that have a \"point-of-presence\" at the facility.  " ;
  rdfs:subClassOf c:IDT_8_1_1 .
c:axiom-idt-8_1_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_1 .

c:IDT_8_1_2 a owl:Class ;
  rdfs:label "IDT 8.1.2 Signaling Network Facility" ;
  rdfs:comment "Facilities that carry network signaling information ( e.g., address, supervision, switching information) that is used to handle call traffic. These facilities may be co-located with or be separate from switching facilities." ;
  rdfs:subClassOf c:IDT_8_1 .
c:axiom-idt-8_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1 .

c:IDT_8_1_2_1 a owl:Class ;
  rdfs:label "IDT 8.1.2.1 Signaling System (SS7) Center" ;
  rdfs:comment "Facilities where signaling equipment is installed and operated." ;
  rdfs:subClassOf c:IDT_8_1_2 .
c:axiom-idt-8_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_2 .

c:IDT_8_1_2_2 a owl:Class ;
  rdfs:label "IDT 8.1.2.2 Signaling Link" ;
  rdfs:comment "Lines or other connection routes that carry network signaling information.  " ;
  rdfs:subClassOf c:IDT_8_1_2 .
c:axiom-idt-8_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_2 .

c:IDT_8_1_3 a owl:Class ;
  rdfs:label "IDT 8.1.3 Transport Facility" ;
  rdfs:comment "Links in the communications network that carry call information. Includes copper wire, fiber optic, microwave and other technologies. Includes high volume trunk lines and individual customer lines." ;
  rdfs:subClassOf c:IDT_8_1 .
c:axiom-idt-8_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1 .

c:IDT_8_1_3_1 a owl:Class ;
  rdfs:label "IDT 8.1.3.1 Trunk Line Link" ;
  rdfs:comment "Communication lines between switching facilities. Generally carry large volume of call traffic from many users simultaneously. The links Include physical lines (e.g., copper wire, fiber optic), microwave connections, and other transmission technologies." ;
  rdfs:subClassOf c:IDT_8_1_3 .
c:axiom-idt-8_1_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_3 .

c:IDT_8_1_3_2 a owl:Class ;
  rdfs:label "IDT 8.1.3.2 Submarine Cable" ;
  rdfs:comment "Submarine cable trunk lines laid in the ocean and across lakes, bays, and rivers to connect across waterways. Also includes cable landing stations where the lines come ashore and are connected to the telephone network." ;
  rdfs:subClassOf c:IDT_8_1_3 .
c:axiom-idt-8_1_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_3 .

c:IDT_8_1_3_3 a owl:Class ;
  rdfs:label "IDT 8.1.3.3 Customer Line" ;
  rdfs:comment "Communication lines linking end use customers to a switching facility." ;
  rdfs:subClassOf c:IDT_8_1_3 .
c:axiom-idt-8_1_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_3 .

c:IDT_8_1_4 a owl:Class ;
  rdfs:label "IDT 8.1.4 Operations Management" ;
  rdfs:comment "Facilities where operational activities and procedures take place to address critical infrastructure coordination efforts toward improving the physical and cyber security protection of Communications Sector assets.  Includes capabilities to ease the flow of information within the sector, across sectors and with designated federal agencies; includes addressing issues related to response and recovery under all hazards to assure the continued operation of vital communications services." ;
  rdfs:subClassOf c:IDT_8_1 .
c:axiom-idt-8_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1 .

c:IDT_8_1_4_1 a owl:Class ;
  rdfs:label "IDT 8.1.4.1 Network Operations Center" ;
  rdfs:comment "Central facilities from which large portions of the telephone network are monitored and managed. In general, each communications company has its own network operations center. Larger companies may have more than one center, including backup facilities.  " ;
  rdfs:subClassOf c:IDT_8_1_4 .
c:axiom-idt-8_1_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_4 .

c:IDT_8_1_4_2 a owl:Class ;
  rdfs:label "IDT 8.1.4.2 Call Center/Customer Service Center" ;
  rdfs:comment "Central location where telephone agents, or operators, make outgoing calls or field inbound calls for a company or organization." ;
  rdfs:subClassOf c:IDT_8_1_4 .
c:axiom-idt-8_1_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_4 .

c:IDT_8_1_4_3 a owl:Class ;
  rdfs:label "IDT 8.1.4.3 Billing Center" ;
  rdfs:comment "Central location that collects invoice information from clients and generates bills on their behalf." ;
  rdfs:subClassOf c:IDT_8_1_4 .
c:axiom-idt-8_1_4_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_4_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_4 .

c:IDT_8_1_4_4 a owl:Class ;
  rdfs:label "IDT 8.1.4.4 Emergency Operations Center" ;
  rdfs:comment "Central command and control facilities responsible for carrying out the principles of emergency preparedness and emergency management, or disaster management functions at a strategic level in an emergency situation, and ensuring the continuity of operation of a organization or company." ;
  rdfs:subClassOf c:IDT_8_1_4 .
c:axiom-idt-8_1_4_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_4_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_4 .

c:IDT_8_1_4_5 a owl:Class ;
  rdfs:label "IDT 8.1.4.5 Data Center" ;
  rdfs:comment "Departments that house the computer systems and related equipment, including the data library. Data entry and systems programming may also come under its jurisdiction. A control section is usually provided that accepts work from and releases output to user departments." ;
  rdfs:subClassOf c:IDT_8_1_4 .
c:axiom-idt-8_1_4_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_4_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_4 .

c:IDT_8_1_5 a owl:Class ;
  rdfs:label "IDT 8.1.5 Wired Telecommunication Service Provider Facility" ;
  rdfs:comment "Administrative facilities of companies that own and operate wired communications networks.  " ;
  rdfs:subClassOf c:IDT_8_1 .
c:axiom-idt-8_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1 .

c:IDT_8_1_6 a owl:Class ;
  rdfs:label "IDT 8.1.6 Access Infrastructure" ;
  rdfs:comment "Gateways for communication between distributed platforms providing clients access to information or resources." ;
  rdfs:subClassOf c:IDT_8_1 .
c:axiom-idt-8_1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1 .

c:IDT_8_1_6_1 a owl:Class ;
  rdfs:label "IDT 8.1.6.1 End Office" ;
  rdfs:comment "Telephone central offices that connect directly to the customer." ;
  rdfs:subClassOf c:IDT_8_1_6 .
c:axiom-idt-8_1_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_6_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_6 .

c:IDT_8_1_6_2 a owl:Class ;
  rdfs:label "IDT 8.1.6.2 Internet Service Provider Point of Presence" ;
  rdfs:comment "Sites where there exists a collection of telecommunications equipment, usually modems, digital leased lines and multi-protocol routers. Internet service providers may operate several points of presence (PoPs) distributed throughout their area of operation to increase the chance that their subscribers will be able to reach one with a local telephone call. The alternative is for them to use virtual PoPs via a third party vendor." ;
  rdfs:subClassOf c:IDT_8_1_6 .
c:axiom-idt-8_1_6_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_6_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_6 .

c:IDT_8_1_6_3 a owl:Class ;
  rdfs:label "IDT 8.1.6.3 Access Tandem" ;
  rdfs:comment "Switches that provide the connection between end offices and the points of presence (PoPs) for interexchange carriers." ;
  rdfs:subClassOf c:IDT_8_1_6 .
c:axiom-idt-8_1_6_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_6_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_6 .

c:IDT_8_1_6_4 a owl:Class ;
  rdfs:label "IDT 8.1.6.4 Local Loop or Metro Ring" ;
  rdfs:comment "The lines between a customer and the telephone company's central office, often called the \"last mile.\" Local loops use copper-based telephone wire." ;
  rdfs:subClassOf c:IDT_8_1_6 .
c:axiom-idt-8_1_6_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_6_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_6 .

c:IDT_8_1_7 a owl:Class ;
  rdfs:label "IDT 8.1.7 Wireline Communications Customer Hosting Center Facility" ;
  rdfs:comment "Telecommunications carrier locations for providing wireline communications services to customers such as local and long distance service, voice over Internet protocol (VOIP), ethernet and managed internet services." ;
  rdfs:subClassOf c:IDT_8_1 .
c:axiom-idt-8_1_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
