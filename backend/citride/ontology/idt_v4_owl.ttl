c:IDT_11_6_3_1 a owl:Class ;
  rdfs:label "IDT 11.6.3.1 Natural Gas Transmission Pipeline Component or Interconnect" ;
  rdfs:comment "Lengths of pipeline, interconnections, and valves. Includes above ground, under ground, river crossings, and other segments. This includes facilities that link one company to another company to transfer gas custody or provide emergency transportation service between companies. Also included are facilities such as pipeline segments, valves, or metering and or pressure reduction stations. " ;
  rdfs:subClassOf c:IDT_11_6_3 .
