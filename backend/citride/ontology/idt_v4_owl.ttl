  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_12_1 a owl:Class ;
  rdfs:label "IDT 12.1 Raw Water Supply" ;
  rdfs:comment "Sources for raw water that are used by commercial and private water purveyors to supply drinking water.  Note: Some water supplies may be ground water, surface water, or a combination of the two. The vast majority of community water systems serving fewer than 10,000 people use ground water as their source. Large community water systems obtain most of their water from surface sources." ;
  rdfs:subClassOf c:IDT_12 .
c:axiom-idt-12_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12 .

c:IDT_12_1_1 a owl:Class ;
  rdfs:label "IDT 12.1.1 Surface Water" ;
  rdfs:comment "Sources of raw water that are located above ground that are used to supply water, including lakes, reservoirs, and rivers.  " ;
  rdfs:subClassOf c:IDT_12_1 .
c:axiom-idt-12_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_1 .

c:IDT_12_1_2 a owl:Class ;
  rdfs:label "IDT 12.1.2 Ground Water" ;
  rdfs:comment "Sources of raw water that are located below ground (e.g., aquifers) and are used to supply water. This may include drainage basins or watersheds." ;
  rdfs:subClassOf c:IDT_12_1 .
c:axiom-idt-12_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_1 .

c:IDT_12_2 a owl:Class ;
  rdfs:label "IDT 12.2 Raw Water Transmission" ;
  rdfs:comment "Facilities that are used to convey water from a remote raw water source to a treatment plant. Community water systems may use pipes or open canals (aqueducts). The water may be pumped or gravity-fed." ;
  rdfs:subClassOf c:IDT_12 .
c:axiom-idt-12_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12 .

c:IDT_12_2_1 a owl:Class ;
  rdfs:label "IDT 12.2.1 Aqueduct" ;
  rdfs:comment "Open-channel conduits used to convey water from a source area to a treatment facility.  " ;
  rdfs:subClassOf c:IDT_12_2 .
c:axiom-idt-12_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_2 .

c:IDT_12_2_2 a owl:Class ;
  rdfs:label "IDT 12.2.2 Water Pipeline" ;
  rdfs:comment "Closed conduits (e.g., pipes, tunnels) used to convey water from a source area to a treatment facility.  " ;
  rdfs:subClassOf c:IDT_12_2 .
c:axiom-idt-12_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_2 .

c:IDT_12_2_2_1 a owl:Class ;
  rdfs:label "IDT 12.2.2.1 Water Pipeline Segment" ;
  rdfs:comment "Lengths of pipeline, interconnections, and valves. Includes above ground, under ground, river crossings, and other segments." ;
  rdfs:subClassOf c:IDT_12_2_2 .
c:axiom-idt-12_2_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_2_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_2_2 .

c:IDT_12_2_2_2 a owl:Class ;
  rdfs:label "IDT 12.2.2.2 Water Pipeline Pumping Station" ;
  rdfs:comment "Stations along the length of a pipeline. Includes pumps, valves, control machinery, and breakout storage." ;
  rdfs:subClassOf c:IDT_12_2_2 .
c:axiom-idt-12_2_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_2_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_2_2 .

c:IDT_12_2_3 a owl:Class ;
  rdfs:label "IDT 12.2.3 Catch Basin" ;
  rdfs:comment "In a combined sewer system, surface-level inlets where excess wastewater and run-off is frequently discharged to a holding basin for subsequent treatment and disposal." ;
  rdfs:subClassOf c:IDT_12_2 .
c:axiom-idt-12_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_2 .

c:IDT_12_3 a owl:Class ;
  rdfs:label "IDT 12.3 Raw Water Storage" ;
  rdfs:comment "Facilities that store raw water from a source before it is treated." ;
  rdfs:subClassOf c:IDT_12 .
c:axiom-idt-12_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12 .

c:IDT_12_3_1 a owl:Class ;
  rdfs:label "IDT 12.3.1 Raw Water Storage Reservoir" ;
  rdfs:comment "Reservoirs used to hold raw water prior to treatment. May be in remote or urban areas.  " ;
  rdfs:subClassOf c:IDT_12_3 .
c:axiom-idt-12_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_3 .

c:IDT_12_3_2 a owl:Class ;
  rdfs:label "IDT 12.3.2 Raw Water Storage Tank" ;
  rdfs:comment "Tanks used to hold raw water prior to treatment.  " ;
  rdfs:subClassOf c:IDT_12_3 .
c:axiom-idt-12_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_3 .

c:IDT_12_4 a owl:Class ;
  rdfs:label "IDT 12.4 Water Treatment Facility" ;
  rdfs:comment "Facilities used to provide safe, potable water for domestic use, adequate quantities of water at sufficient pressure for fire protection and other emergencies, and industrial water for manufacturing. A variety of physical and chemical treatments are applied. Steps in treatment may include clarification, coagulation, sedimentation, filtration, disinfection, and fluoridation." ;
  rdfs:subClassOf c:IDT_12 .
c:axiom-idt-12_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12 .

c:IDT_12_5 a owl:Class ;
  rdfs:label "IDT 12.5 Treated (Finished) Water Storage" ;
  rdfs:comment "Facilities to store treated (e.g., finished) water for a short time prior to distribution to customers." ;
  rdfs:subClassOf c:IDT_12 .
c:axiom-idt-12_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12 .

c:IDT_12_5_1 a owl:Class ;
  rdfs:label "IDT 12.5.1 Water Tower" ;
  rdfs:comment "Elevated storage tanks that are used to provide additional system pressure by using gravity.  " ;
  rdfs:subClassOf c:IDT_12_5 .
c:axiom-idt-12_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_5 .

c:IDT_12_5_2 a owl:Class ;
  rdfs:label "IDT 12.5.2 Standpipe" ;
  rdfs:comment "Flat-bottomed cylindrical tanks, with a shell height that is greater than its diameter, used for storing treated water." ;
  rdfs:subClassOf c:IDT_12_5 .
c:axiom-idt-12_5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_5_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_5 .

c:IDT_12_5_3 a owl:Class ;
  rdfs:label "IDT 12.5.3 Covered Reservoir" ;
  rdfs:comment "Flat-bottomed cylindrical tanks, with a shell height that is equal to or smaller than its diameter, used for storing treated water either above or below the ground surface." ;
  rdfs:subClassOf c:IDT_12_5 .
c:axiom-idt-12_5_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_5_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_5 .

c:IDT_12_5_4 a owl:Class ;
  rdfs:label "IDT 12.5.4 Uncovered Reservoir" ;
  rdfs:comment "Reservoirs without covers used to store treated water." ;
  rdfs:subClassOf c:IDT_12_5 .
c:axiom-idt-12_5_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_5_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_5 .

c:IDT_12_5_5 a owl:Class ;
  rdfs:label "IDT 12.5.5 Clearwell" ;
  rdfs:comment "Used to provide interim contact time during the water treatment process.  " ;
  rdfs:subClassOf c:IDT_12_5 .
c:axiom-idt-12_5_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_5_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_5 .

c:IDT_12_6 a owl:Class ;
  rdfs:label "IDT 12.6 Treated Water Distribution System" ;
  rdfs:comment "Facilities that transport treated water to end users. This includes the network of pipes, tanks, pumps, and valves that convey and that adjust the flow such that the proper volume and pressure of water is delivered when and where needed." ;
  rdfs:subClassOf c:IDT_12 .
c:axiom-idt-12_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12 .

c:IDT_12_6_1 a owl:Class ;
  rdfs:label "IDT 12.6.1 Water Transmission/Distribution Main" ;
  rdfs:comment "Pipes used to transport large quantities of water within the distribution network.  " ;
  rdfs:subClassOf c:IDT_12_6 .
c:axiom-idt-12_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_6_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_6 .

c:IDT_12_6_2 a owl:Class ;
  rdfs:label "IDT 12.6.2 Water Service Line" ;
  rdfs:comment "Pipes that transport smaller quantities of water in the distribution network to the end users.  " ;
  rdfs:subClassOf c:IDT_12_6 .
c:axiom-idt-12_6_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_6_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_6 .

c:IDT_12_6_3 a owl:Class ;
  rdfs:label "IDT 12.6.3 Water Distribution Pumping Station" ;
  rdfs:comment "Facilities used to increase the pressure in the distribution network when end users are located far from the treatment plant.  " ;
  rdfs:subClassOf c:IDT_12_6 .
c:axiom-idt-12_6_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_6_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_6 .

c:IDT_12_6_4 a owl:Class ;
  rdfs:label "IDT 12.6.4 Fire Hydrant" ;
  rdfs:comment "Devices used to provide access to the distribution network for obtaining emergency water, washing down streets, and flushing water mains.  " ;
  rdfs:subClassOf c:IDT_12_6 .
c:axiom-idt-12_6_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_6_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_6 .

c:IDT_12_6_5 a owl:Class ;
  rdfs:label "IDT 12.6.5 Booster Disinfection Facility" ;
  rdfs:comment "Facilities that include pumps and valves used to inject additional disinfectant in the treated water to maintain desired water quality.  " ;
  rdfs:subClassOf c:IDT_12_6 .
c:axiom-idt-12_6_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_6_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_6 .

c:IDT_12_6_6 a owl:Class ;
  rdfs:label "IDT 12.6.6 Backflow Preventer" ;
  rdfs:comment "Devices used to prevent contaminated water from entering the distribution network if the downstream pressure exceeds the pressure upstream.  " ;
  rdfs:subClassOf c:IDT_12_6 .
c:axiom-idt-12_6_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_6_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_6 .

c:IDT_12_6_7 a owl:Class ;
  rdfs:label "IDT 12.6.7 Meter" ;
  rdfs:comment "Devices used to track consumption of water in the distribution network.  " ;
  rdfs:subClassOf c:IDT_12_6 .
c:axiom-idt-12_6_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_6_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_6 .

c:IDT_12_7 a owl:Class ;
  rdfs:label "IDT 12.7 Treated Water Monitoring System" ;
  rdfs:comment "Facilities to monitor treated water quality for conventional regulated and unregulated contaminants. Some systems have sensors installed at critical points to monitor a range of physical properties, such as water pressure and water-quality indicators.  " ;
  rdfs:subClassOf c:IDT_12 .
c:axiom-idt-12_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12 .

c:IDT_12_8 a owl:Class ;
  rdfs:label "IDT 12.8 Treated Water Distribution Control Center" ;
  rdfs:comment "Central control facilities that monitor and operate the distribution system. Some systems have electronic networks, often including wireless communication, to link the monitoring system, and the controls for the treatment and distribution systems, to a central display and operations room. These systems may also help to automate control of a drinking water system with monitoring-system readouts serving as inputs for control. Supervisory control and data acquisition systems are part of an integrated control system." ;
  rdfs:subClassOf c:IDT_12 .
c:axiom-idt-12_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12 .

c:IDT_12_9 a owl:Class ;
  rdfs:label "IDT 12.9 Wastewater Facility" ;
  rdfs:comment "Facilities used to collect and treat wastewater for safe discharge or reuse, and disposal of produced biosolids." ;
  rdfs:subClassOf c:IDT_12 .
c:axiom-idt-12_9-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12 .

c:IDT_12_9_1 a owl:Class ;
  rdfs:label "IDT 12.9.1 Wastewater Collection System" ;
  rdfs:comment "The network of pipes that conveys wastewater from the source to the treatment plant. In some older cities, the wastewater and storm water collection systems are integrated (combined sewer systems), and in wet weather the combined effluent may discharge directly to the receiving body, bypassing the treatment plant." ;
  rdfs:subClassOf c:IDT_12_9 .
c:axiom-idt-12_9_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9 .

c:IDT_12_9_1_1 a owl:Class ;
  rdfs:label "IDT 12.9.1.1 Sewer" ;
  rdfs:comment "Underground conduits used to collect and convey wastewater by gravity flow from an urban area to points of disposal or treatment. Laterals connect residences and industries to branch sewers, sub-main lines, and main line sewers (also called trunks or force mains, if driven by a pump). This may include outfalls and catch basins." ;
  rdfs:subClassOf c:IDT_12_9_1 .
c:axiom-idt-12_9_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9_1 .

c:IDT_12_9_1_2 a owl:Class ;
  rdfs:label "IDT 12.9.1.2 Inverted Siphon" ;
  rdfs:comment "A sewer that is buried deeper below ground in order to avoid an obstruction such as a stream, railway cut, or depressed highway." ;
  rdfs:subClassOf c:IDT_12_9_1 .
c:axiom-idt-12_9_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9_1 .

c:IDT_12_9_1_3 a owl:Class ;
  rdfs:label "IDT 12.9.1.3 Manhole" ;
  rdfs:comment "Openings to the sewer system that are used for inspection and cleaning. " ;
  rdfs:subClassOf c:IDT_12_9_1 .
c:axiom-idt-12_9_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9_1 .

c:IDT_12_9_1_4 a owl:Class ;
  rdfs:label "IDT 12.9.1.4 Combined Sewer Overflow Outfall" ;
  rdfs:comment "For combined sewer systems, the location where excess wastewater and run-off is frequently discharged directly to a receiving stream without treatment." ;
  rdfs:subClassOf c:IDT_12_9_1 .
c:axiom-idt-12_9_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9_1 .

c:IDT_12_9_1_5 a owl:Class ;
  rdfs:label "IDT 12.9.1.5 Lift/Pump Station" ;
  rdfs:comment "Stations are used to elevate and transport wastewater in collection systems using a system of pumps when gravity flow is insufficient or no longer feasible. " ;
  rdfs:subClassOf c:IDT_12_9_1 .
c:axiom-idt-12_9_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9_1 .

c:IDT_12_9_1_6 a owl:Class ;
  rdfs:label "IDT 12.9.1.6 Catch Basin" ;
  rdfs:comment "In a combined sewer system, surface-level inlets where excess wastewater and run-off is frequently discharged to a holding basin for subsequent treatment and disposal." ;
  rdfs:subClassOf c:IDT_12_9_1 .
c:axiom-idt-12_9_1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9_1 .

c:IDT_12_9_2 a owl:Class ;
  rdfs:label "IDT 12.9.2 Wastewater Raw Influent Storage" ;
  rdfs:comment "Facilities to store raw sewage and/or industrial effluents prior to treatment. Generally used for the purpose of flow equalization. May be tanks or impoundments. " ;
  rdfs:subClassOf c:IDT_12_9 .
c:axiom-idt-12_9_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9 .

c:IDT_12_9_3 a owl:Class ;
  rdfs:label "IDT 12.9.3 Wastewater Treatment Plant" ;
  rdfs:comment "Plants providing a combination of physical and biological processes that are designed to remove organic matter from solution and treat the water to a degree that it can be released to the environment. Processes include screening, grit removal, flotation, flocculation and sedimentation, aeration, clarification, disinfection, chemical coagulation, and filtration. The processes are applied to the plant influent to reduce pollutant levels to the concentrations specified in the National Pollutant Discharge Elimination System (NPDES) permit, in the case of a direct discharger, or other specified discharge limits, in the case of an indirect discharger." ;
  rdfs:subClassOf c:IDT_12_9 .
c:axiom-idt-12_9_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9 .

c:IDT_12_9_4 a owl:Class ;
  rdfs:label "IDT 12.9.4 Treated Wastewater Storage" ;
  rdfs:comment "Facilities where treated wastewater is held (e.g., in lagoons, detention basins) prior to discharge.  " ;
  rdfs:subClassOf c:IDT_12_9 .
c:axiom-idt-12_9_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9 .

c:IDT_12_9_5 a owl:Class ;
  rdfs:label "IDT 12.9.5 Treated Wastewater Discharge System" ;
  rdfs:comment "Facilities that discharge treated wastewater to a surface water body, in the case of a direct discharger, or to a publicly owned treatment works (POTW) collection system, in the case of an indirect discharger.  " ;
  rdfs:subClassOf c:IDT_12_9 .
c:axiom-idt-12_9_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9 .

c:IDT_12_9_6 a owl:Class ;
  rdfs:label "IDT 12.9.6 Treated Wastewater Monitoring System" ;
  rdfs:comment "Facilities to monitor a range of physical properties, such as flow rates and water-quality indicators, and detect levels of contaminants before, during, and after wastewater treatment.  " ;
  rdfs:subClassOf c:IDT_12_9 .
c:axiom-idt-12_9_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9 .

c:IDT_12_9_7 a owl:Class ;
  rdfs:label "IDT 12.9.7 Wastewater Control Center" ;
  rdfs:comment "Central control facilities that monitor and operate the wastewater system. Some systems have electronic networks, often including wireless communication, to link the monitoring system, and the controls for the treatment and distribution systems, to a central display and operations room. These systems may also help to automate control of a drinking water system with monitoring-system readouts serving as inputs for control. Supervisory control and data acquisition (SCADA) systems are part of an integrated control system." ;
  rdfs:subClassOf c:IDT_12_9 .
c:axiom-idt-12_9_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_9_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_9 .

c:IDT_12_10 a owl:Class ;
  rdfs:label "IDT 12.10 Regulatory, Oversight, or Industry Organization" ;
  rdfs:comment "Organizations that provide technical, operation, pricing, and business oversight and support to the various components of the water system." ;
  rdfs:subClassOf c:IDT_12 .
c:axiom-idt-12_10-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_10 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12 .

c:IDT_12_10_1 a owl:Class ;
  rdfs:label "IDT 12.10.1 Federal Water Agency" ;
  rdfs:comment "Federal agencies dealing with water including Environmental Protection Agency, U.S. Army Corps of Engineers, etc.  " ;
  rdfs:subClassOf c:IDT_12_10 .
c:axiom-idt-12_10_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_10_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_10 .

c:IDT_12_10_2 a owl:Class ;
  rdfs:label "IDT 12.10.2 State, Local, or Regional Water Agency" ;
  rdfs:comment "State, local, and regional agencies that deal with water in their jurisdictions.  " ;
  rdfs:subClassOf c:IDT_12_10 .
c:axiom-idt-12_10_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_10_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_10 .

c:IDT_12_10_3 a owl:Class ;
  rdfs:label "IDT 12.10.3 Water Industry Organization" ;
  rdfs:comment "Industry organizations that provide industry-wide support.  " ;
  rdfs:subClassOf c:IDT_12_10 .
c:axiom-idt-12_10_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_10_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_10 .

c:IDT_12_10_4 a owl:Class ;
  rdfs:label "IDT 12.10.4 International Water Organization" ;
  rdfs:comment "International organizations dealing with water issues." ;
  rdfs:subClassOf c:IDT_12_10 .
c:axiom-idt-12_10_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_10_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_10 .

c:IDT_12_10_5 a owl:Class ;
  rdfs:label "IDT 12.10.5 Private-Sector Water Supply or Distribution Company" ;
  rdfs:comment "Commercial water companies contracted by a district to provide water and/or wastewater services. These companies may either own the facilities or operate municipal facilities.  " ;
  rdfs:subClassOf c:IDT_12_10 .
c:axiom-idt-12_10_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_12_10_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_12_10 .

c:IDT_13 a owl:Class ;
  rdfs:label "IDT 13 National Monuments and Icons" ;
  rdfs:comment "Assets including National Monuments, symbols, and icons that represent the nation’s heritage, traditions, values, and political power. This sector includes a wide variety of sites and structures such as prominent historical attractions, monuments, cultural icons, and centers of commerce and business. Includes assets with significance at the local, regional, or national level as well as those that are government (federal, state, local) and privately owned. These assets Include structures, geographical areas, documents, and objects. Many assets are listed in the Department of Interior’s national register of historic places or national historic landmarks. Note: Some assets are only categorized in this category (e.g., Statue of Liberty, Washington Monument). Other assets are primarily identified as part of another sector but also have icon status (e.g., Golden Gate Bridge, U.S. Capitol). These assets have both their primary categorization and this icon categorization." ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-13-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_13_1 a owl:Class ;
  rdfs:label "IDT 13.1 National Monument/Icon Structure" ;
  rdfs:comment "National monument/icon assets that are structures.  May or may not be located in a monument/icon geographic area." ;
  rdfs:subClassOf c:IDT_13 .
c:axiom-idt-13_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13 .

c:IDT_13_1_1 a owl:Class ;
  rdfs:label "IDT 13.1.1 Building" ;
  rdfs:comment "Assets that are buildings.  Includes historic buildings, homes, and others.  " ;
  rdfs:subClassOf c:IDT_13_1 .
c:axiom-idt-13_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13_1 .

c:IDT_13_1_2 a owl:Class ;
  rdfs:label "IDT 13.1.2 Monument or Memorial" ;
  rdfs:comment "Assets that are monuments, memorials, statues, and others. " ;
  rdfs:subClassOf c:IDT_13_1 .
c:axiom-idt-13_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13_1 .

c:IDT_13_1_3 a owl:Class ;
  rdfs:label "IDT 13.1.3 Other National Monument/Icon Structure" ;
  rdfs:comment "Assets other than buildings and monuments (e.g., famous bridges)." ;
  rdfs:subClassOf c:IDT_13_1 .
c:axiom-idt-13_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13_1 .

c:IDT_13_2 a owl:Class ;
  rdfs:label "IDT 13.2 National Monument/Icon Geographic Area" ;
  rdfs:comment "National monument/icon assets that are primarily geographical areas.  May or may not contain any structures." ;
  rdfs:subClassOf c:IDT_13 .
c:axiom-idt-13_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13 .

c:IDT_13_2_1 a owl:Class ;
  rdfs:label "IDT 13.2.1 Park or Public Land" ;
  rdfs:comment "National, state and local parks, forests, and recreational areas.  " ;
  rdfs:subClassOf c:IDT_13_2 .
c:axiom-idt-13_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13_2 .

c:IDT_13_2_2 a owl:Class ;
  rdfs:label "IDT 13.2.2 Historical or Heritage Land" ;
  rdfs:comment "Historic battlefields, landmarks, and others.  " ;
  rdfs:subClassOf c:IDT_13_2 .
c:axiom-idt-13_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13_2 .

c:IDT_13_2_3 a owl:Class ;
  rdfs:label "IDT 13.2.3 Other National Monument/Icon Geographic Area" ;
  rdfs:comment "Assets other than parks and historical areas (e.g., commercial districts). " ;
  rdfs:subClassOf c:IDT_13_2 .
c:axiom-idt-13_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13_2 .

c:IDT_13_3 a owl:Class ;
  rdfs:label "IDT 13.3 National Monument/Icon Document or Object" ;
  rdfs:comment "National monument/icon assets including historical documents and historical objects.  Generally on display in museums, libraries, historic sites, and other such locations.  They would retain their iconic value if temporarily moved to another location, e.g., for an exhibition." ;
  rdfs:subClassOf c:IDT_13 .
c:axiom-idt-13_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13 .

c:IDT_13_3_1 a owl:Class ;
  rdfs:label "IDT 13.3.1 Historical/Significant Document" ;
  rdfs:comment "Documents of historical significance nationally, regionally, or locally (e.g., Declaration of Independence, United States Constitution)." ;
  rdfs:subClassOf c:IDT_13_3 .
c:axiom-idt-13_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13_3 .

c:IDT_13_3_2 a owl:Class ;
  rdfs:label "IDT 13.3.2 Historical/Significant Object" ;
  rdfs:comment "Objects of historical or other significance nationally, regionally, or locally (e.g., Liberty Bell)." ;
  rdfs:subClassOf c:IDT_13_3 .
c:axiom-idt-13_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13_3 .

c:IDT_13_4 a owl:Class ;
  rdfs:label "IDT 13.4 Other National Monuments and Icons" ;
  rdfs:comment "National monument and icon facilities and assets not elsewhere categorized. " ;
  rdfs:subClassOf c:IDT_13 .
c:axiom-idt-13_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_13_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_13 .

c:IDT_14 a owl:Class ;
  rdfs:label "IDT 14 Commercial Facilities" ;
  rdfs:comment "Includes commercial businesses and community facilities. Most are privately owned, but some are publicly owned and operated." ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-14-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_14_1 a owl:Class ;
  rdfs:label "IDT 14.1 Entertainment or Media Facility" ;
  rdfs:comment "Facilities engaged in producing and distributing information and cultural products, processing data, and providing the means to transmit or distribute these products, data or communications." ;
  rdfs:subClassOf c:IDT_14 .
c:axiom-idt-14_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14 .

c:IDT_14_1_1 a owl:Class ;
  rdfs:label "IDT 14.1.1 Television Production Facility" ;
  rdfs:comment "Establishments involved in the production and distribution of television programming. This may or may not include broadcasting." ;
  rdfs:subClassOf c:IDT_14_1 .
c:axiom-idt-14_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_1 .

c:IDT_14_1_2 a owl:Class ;
  rdfs:label "IDT 14.1.2 Internet Publishing" ;
  rdfs:comment "Establishments engaged in publishing and/or broadcasting content on the Internet exclusively. Establishments in this industry provide textual, audio, and/or video content of general or specific interest on the Internet. Includes Internet host web sites. Does not include the hardware and software to operate the Internet system, which are categorized under the Information Technology and Telecommunications sectors." ;
  rdfs:subClassOf c:IDT_14_1 .
c:axiom-idt-14_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_1_2 ;
