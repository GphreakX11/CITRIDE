  rdfs:label "IDT 17.2.4.3 Radioactive Source Importer or Distributor" ;
  rdfs:comment "Facilities in which imported and other sources including those being transshipped or in transit through the United States may be temporarily stored incidental to transportation." ;
  rdfs:subClassOf c:IDT_17_2_4 .
