c:IDT_17_2_4 a owl:Class ;
  rdfs:label "IDT 17.2.4 Radioactive Source Production or Distribution Facility" ;
  rdfs:comment "Facilities that import, fabricate, or remanufacture radioactive sources, or store such sources incidental to transport." ;
  rdfs:subClassOf c:IDT_17_2 .
