  owl:annotatedTarget c:IDT_14 .

c:IDT_14_4_1 a owl:Class ;
  rdfs:label "IDT 14.4.1 Motor Racetrack" ;
  rdfs:comment "Facilities that include specially surfaced circuits or courses used for motor racing. The track is a permanent facility and may feature grandstands and concourses." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
