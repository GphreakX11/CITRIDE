c:IDT_14_4 a owl:Class ;
  rdfs:label "IDT 14.4 Public Assembly" ;
  rdfs:comment "Facilities where large numbers of people congregate to pursue business activities, conduct personal transactions, or enjoy recreational pastimes." ;
  rdfs:subClassOf c:IDT_14 .
