c:IDT_3_2_2_2 a owl:Class ;
  rdfs:label "IDT 3.2.2.2 Port Handling Hazardous Chemical" ;
  rdfs:comment "Port facilities for mooring, docking, loading, and unloading marine vessels with hazardous chemicals. Includes shuttle tankers to off-load larger vessels." ;
  rdfs:subClassOf c:IDT_3_2_2 .
c:axiom-idt-3_2_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
