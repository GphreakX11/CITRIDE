  rdfs:label "IDT 1.5.2.8 Fresh Fruit and Vegetable Merchant Wholesaler" ;
  rdfs:comment "Establishments primarily engaged in the merchant wholesale distribution of fresh fruits and vegetables." ;
  rdfs:subClassOf c:IDT_1_5_2 .
