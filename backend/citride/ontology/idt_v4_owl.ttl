c:IDT_11_4_5_2_2 a owl:Class ;
  rdfs:label "IDT 11.4.5.2.2 State or Local Marine Emergency Response Facility" ;
  rdfs:comment "State and local stations providing emergency search and rescue capabilities. May be attached to the local fire department. " ;
  rdfs:subClassOf c:IDT_11_4_5_2 .
