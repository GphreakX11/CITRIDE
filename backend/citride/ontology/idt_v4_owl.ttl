  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_3_1 .

c:IDT_1_2_3_1_3 a owl:Class ;
  rdfs:label "IDT 1.2.3.1.3 Beet Sugar Manufacturing" ;
  rdfs:comment "Facilities primarily engaged in manufacturing refined beet sugar from sugar beets. " ;
  rdfs:subClassOf c:IDT_1_2_3_1 .
c:axiom-idt-1_2_3_1_3-parent a owl:Axiom ;
