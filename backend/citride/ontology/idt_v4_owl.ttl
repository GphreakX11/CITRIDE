c:IDT_15_5_1 a owl:Class ;
  rdfs:label "IDT 15.5.1 Global Positioning System (GPS)" ;
  rdfs:comment "A worldwide, satellite-based radio navigation system providing specially coded satellite signals that can be processed in a global positioning system (GPS) receiver, enabling the receiver to compute position in three dimensions, velocity, and time.  GPS is funded by and controlled by the U. S. Department of Defense (DoD).  " ;
  rdfs:subClassOf c:IDT_15_5 .
c:axiom-idt-15_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_15_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_15_5 .

c:IDT_15_5_1_1 a owl:Class ;
  rdfs:label "IDT 15.5.1.1 Global Positioning System (GPS) Space Segment" ;
  rdfs:comment "The space segment consists of 24 operational satellites in six orbital planes (four satellites in each plane).  " ;
  rdfs:subClassOf c:IDT_15_5_1 .
c:axiom-idt-15_5_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_15_5_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_15_5_1 .

c:IDT_15_5_1_2 a owl:Class ;
  rdfs:label "IDT 15.5.1.2 Global Positioning System (GPS) Control Segment" ;
  rdfs:comment "The control segment consists of monitor stations, ground antennas, and a master control station (MCS). The monitor stations passively track all satellites in view, accumulating ranging data. This information is processed at the MCS to determine satellite orbits and to update each satellite's navigation message. Updated information is transmitted to each satellite via the ground antennas.  " ;
  rdfs:subClassOf c:IDT_15_5_1 .
c:axiom-idt-15_5_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_15_5_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_15_5_1 .

c:IDT_15_5_2 a owl:Class ;
  rdfs:label "IDT 15.5.2 Government Observation System" ;
  rdfs:comment "Facilities associated with systems that are used to gather information and data, such as National Oceanic and Atmospheric Administration (NOAA) weather stations, telescope facilities, and early warning systems. " ;
  rdfs:subClassOf c:IDT_15_5 .
c:axiom-idt-15_5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_15_5_2 ;
