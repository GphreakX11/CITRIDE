c:IDT_15_1_1_3 a owl:Class ;
  rdfs:label "IDT 15.1.1.3 Correctional Facility" ;
  rdfs:comment "Government buildings designed for the confinement, correction, and rehabilitation of adult and/or juvenile offenders sentenced by a court. Includes correctional institutions, detention centers, community corrections centers, and holding cells in courthouses.  " ;
  rdfs:subClassOf c:IDT_15_1_1 .
