c:IDT_2_3_3 a owl:Class ;
  rdfs:label "IDT 2.3.3 Insurance Producer" ;
  rdfs:comment "Establishments primarily engaged in acting as agents (e.g., brokers) in selling annuities and insurance policies." ;
  rdfs:subClassOf c:IDT_2_3 .
c:axiom-idt-2_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_2_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_2_3 .

c:IDT_2_3_4 a owl:Class ;
  rdfs:label "IDT 2.3.4 Insurance Support Organization" ;
  rdfs:comment "Establishments primarily engaged in facilitating insurance activities by performing supporting activities. Includes claims adjustment, claims investigation, claims processing, actuarial services, loss prevention services, rate making services, and medical cost evaluation." ;
  rdfs:subClassOf c:IDT_2_3 .
c:axiom-idt-2_3_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
