c:IDT_11_5_1 a owl:Class ;
  rdfs:label "IDT 11.5.1 Rail Mass Transit" ;
  rdfs:comment "Facilities associated with systems for carrying transit passengers described by specific right-of-way, technology and operational features. " ;
  rdfs:subClassOf c:IDT_11_5 .
c:axiom-idt-11_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
