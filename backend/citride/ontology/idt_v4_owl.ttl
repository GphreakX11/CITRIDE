c:IDT_17_2_2_1 a owl:Class ;
  rdfs:label "IDT 17.2.2.1 Low Hazard Radioactive Materials Transport" ;
  rdfs:comment "Transportation of smaller quantities of radioactive material that must be transported in Type-A containers or industrial packaging." ;
  rdfs:subClassOf c:IDT_17_2_2 .
c:axiom-idt-17_2_2_1-parent a owl:Axiom ;
