c:IDT_11_4_5_1_3 a owl:Class ;
  rdfs:label "IDT 11.4.5.1.3 Electronic Navigation Facility" ;
  rdfs:comment "Radar beacon (RACON) and Long-range navigation system (LORAN-C) facilities used to provide navigation support on inland waterways and coastlines. " ;
  rdfs:subClassOf c:IDT_11_4_5_1 .
