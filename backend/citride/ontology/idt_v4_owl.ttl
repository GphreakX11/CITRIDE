  rdfs:label "IDT 11.2.1.2.1 Passenger Train Long Distance/Intercity" ;
  rdfs:comment "Trains that handle the movement of people by rail between cities and towns other than for daily commuting. " ;
  rdfs:subClassOf c:IDT_11_2_1_2 .
