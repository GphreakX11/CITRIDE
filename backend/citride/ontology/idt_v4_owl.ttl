c:IDT_16_3_3_1 a owl:Class ;
  rdfs:label "IDT 16.3.3.1 Canal" ;
  rdfs:comment "A constructed channel, usually open, to convey water by gravity. " ;
  rdfs:subClassOf c:IDT_16_3_3 .
