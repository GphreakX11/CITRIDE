c:IDT_15_1_1_4 a owl:Class ;
  rdfs:label "IDT 15.1.1.4 Embassy or Consulate" ;
  rdfs:comment "Government buildings used to facilitate foreign relations. Includes United States government embassies and consulates located in foreign countries, and foreign government embassies and consulates located in the United States." ;
  rdfs:subClassOf c:IDT_15_1_1 .
c:axiom-idt-15_1_1_4-parent a owl:Axiom ;
