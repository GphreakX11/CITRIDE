  rdfs:label "IDT 2.1.4.4 Physical Repository" ;
  rdfs:comment "Secured facilities where large quantities of currency and/or precious metals are stored.  Includes both government and private repositories.  " ;
  rdfs:subClassOf c:IDT_2_1_4 .
