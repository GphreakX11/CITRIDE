c:IDT_1_1_3_2_4 a owl:Class ;
  rdfs:label "IDT 1.1.3.2.4 Timber Piling and Pole Cutting" ;
  rdfs:comment "Facilities and operations primarily engaged in the operation of timber piling and pole cutting." ;
  rdfs:subClassOf c:IDT_1_1_3_2 .
c:axiom-idt-1_1_3_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_3_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_3_2 .

c:IDT_1_1_3_2_5 a owl:Class ;
  rdfs:label "IDT 1.1.3.2.5 Tree, Stump, and Wood Chipping" ;
  rdfs:comment "Facilities and operations primarily engaged in tree, stump, and wood chipping in the field." ;
  rdfs:subClassOf c:IDT_1_1_3_2 .
c:axiom-idt-1_1_3_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_3_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_3_2 .

c:IDT_1_1_4 a owl:Class ;
  rdfs:label "IDT 1.1.4 Fishing, Hunting and Trapping" ;
  rdfs:comment "Facilities primarily engaged in harvesting fish and other wild animals from their natural habitats and are dependent upon a continued supply of the natural resource. The harvesting of fish is the predominant economic activity of this sub-sector and it usually requires specialized vessels that, by the nature of their size, configuration and equipment, are not suitable for any other type of production, such as transportation. " ;
  rdfs:subClassOf c:IDT_1_1 .
c:axiom-idt-1_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1 .

c:IDT_1_1_4_1 a owl:Class ;
  rdfs:label "IDT 1.1.4.1 Fishing Operations" ;
  rdfs:comment "Harvesting of fish from their natural habitats. Usually requires specialized vessels that, by the nature of their size, configuration and equipment, are not suitable for any other type of production, such as transportation. Includes fishing for finfish, shellfish, and other marine animals." ;
  rdfs:subClassOf c:IDT_1_1_4 .
c:axiom-idt-1_1_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_4 .

c:IDT_1_1_4_1_1 a owl:Class ;
  rdfs:label "IDT 1.1.4.1.1 Shellfish Fishing" ;
  rdfs:comment "Facilities primarily engaged in the commercial catching or taking of shellfish (e.g., clams, crabs, lobsters, mussels, oysters, sea urchins, shrimp) from their natural habitat. " ;
  rdfs:subClassOf c:IDT_1_1_4_1 .
c:axiom-idt-1_1_4_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_4_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_4_1 .

c:IDT_1_1_4_1_2 a owl:Class ;
  rdfs:label "IDT 1.1.4.1.2 Finfish Fishing" ;
  rdfs:comment "Facilities primarily engaged in the commercial catching or taking of finfish (e.g., bluefish, salmon, trout, tuna) from their natural habitat. " ;
  rdfs:subClassOf c:IDT_1_1_4_1 .
c:axiom-idt-1_1_4_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_4_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_4_1 .

c:IDT_1_1_4_1_3 a owl:Class ;
  rdfs:label "IDT 1.1.4.1.3 Other Marine Fishing" ;
  rdfs:comment "Facilities primarily engaged in the commercial catching or taking of marine animals (except shellfish). " ;
  rdfs:subClassOf c:IDT_1_1_4_1 .
c:axiom-idt-1_1_4_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_4_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_4_1 .

c:IDT_1_1_4_2 a owl:Class ;
  rdfs:label "IDT 1.1.4.2 Hunting and Trapping Operations " ;
  rdfs:comment "Facilities primarily engaged in one or more of the following: (1) commercial hunting and trapping; (2) operating commercial game preserves, such as game retreats; and (3) operating hunting preserves. " ;
  rdfs:subClassOf c:IDT_1_1_4 .
c:axiom-idt-1_1_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_4 .

c:IDT_1_1_4_2_1 a owl:Class ;
  rdfs:label "IDT 1.1.4.2.1 Hunting Preserve" ;
  rdfs:comment "Facilities primarily engaged in operating hunting preserves. " ;
  rdfs:subClassOf c:IDT_1_1_4_2 .
c:axiom-idt-1_1_4_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_4_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_4_2 .

c:IDT_1_1_4_2_2 a owl:Class ;
  rdfs:label "IDT 1.1.4.2.2 Trapping Preserve" ;
  rdfs:comment "Facilities primarily engaged in operating trapping preserves." ;
  rdfs:subClassOf c:IDT_1_1_4_2 .
c:axiom-idt-1_1_4_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_4_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_4_2 .

c:IDT_1_1_4_2_3 a owl:Class ;
  rdfs:label "IDT 1.1.4.2.3 Fishing Preserve" ;
  rdfs:comment "Facilities primarily engaged in operating fishing reserves." ;
  rdfs:subClassOf c:IDT_1_1_4_2 .
