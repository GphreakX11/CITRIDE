c:IDT_5_3_6_1 a owl:Class ;
  rdfs:label "IDT 5.3.6.1 City Gate Station" ;
  rdfs:comment "Measuring, custody transfer, and pressure regulating stations where a natural gas distribution company receives gas from a transmission company and where pressure is reduced and odorant is added to meet distribution network requirements." ;
  rdfs:subClassOf c:IDT_5_3_6 .
c:axiom-idt-5_3_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
