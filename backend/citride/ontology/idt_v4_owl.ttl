  rdfs:label "IDT 15.1.1.1.3 Legislative Chamber or Office" ;
  rdfs:comment "Government buildings used to conduct and support the business of the legislative branch.  " ;
  rdfs:subClassOf c:IDT_15_1_1_1 .
