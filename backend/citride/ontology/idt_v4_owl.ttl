  owl:annotatedTarget c:IDT_10_1_1_2 .

c:IDT_10_1_1_3 a owl:Class ;
  rdfs:label "IDT 10.1.1.3 Children's Hospital" ;
  rdfs:comment "Hospitals primarily engaged in providing diagnostic and medical treatment to children. " ;
  rdfs:subClassOf c:IDT_10_1_1 .
c:axiom-idt-10_1_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_1 .

c:IDT_10_1_1_4 a owl:Class ;
  rdfs:label "IDT 10.1.1.4 Specialty Hospital" ;
  rdfs:comment "Hospitals primarily engaged in providing diagnostic and medical treatment to inpatients with a specific type of disease or medical condition (e.g., cancer hospital, orthopedic hospital)." ;
  rdfs:subClassOf c:IDT_10_1_1 .
c:axiom-idt-10_1_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_1 .

c:IDT_10_1_1_5 a owl:Class ;
  rdfs:label "IDT 10.1.1.5 Critical Access Hospital" ;
  rdfs:comment "Hospitals that receive funding and support from Medicare that are located in rural and mountainous regions that do not have access to traditional hospital systems. These critical access hospitals may not even be staffed by a physician 24 hours a day. These hospitals have a distinct set of rules and eligibility requirements and number over 1,200 across the nation." ;
  rdfs:subClassOf c:IDT_10_1_1 .
c:axiom-idt-10_1_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_1 .

c:IDT_10_1_1_6 a owl:Class ;
  rdfs:label "IDT 10.1.1.6 Emergency Department" ;
  rdfs:comment "Facilities in a hospital that provides initial care and stabilization for both urgent and non-urgent patients who may arrive by private or public vehicle. This facility acts as the forefront receiver for the patients from emergency responders, in addition to medical control and communication. It also provides equipment, supply and pharmaceutical caches, housing units for medical personnel and non-medical support members, and augments the final treatment plan (e.g., transfer, admission, treatment and discharge, operating room)." ;
  rdfs:subClassOf c:IDT_10_1_1 .
c:axiom-idt-10_1_1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_1 .

c:IDT_10_1_2 a owl:Class ;
  rdfs:label "IDT 10.1.2 Ambulatory Healthcare Facility" ;
  rdfs:comment "Facilities providing medical, diagnostic, and treatment services that include physician, nursing, and other health services to outpatients.  " ;
  rdfs:subClassOf c:IDT_10_1 .
c:axiom-idt-10_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1 .

c:IDT_10_1_2_1 a owl:Class ;
  rdfs:label "IDT 10.1.2.1 Family Planning Center" ;
  rdfs:comment "Establishments with medical staff primarily engaged in providing a range of family planning services on an outpatient basis, such as contraceptive services, genetic and prenatal counseling, voluntary sterilization, and therapeutic and medically indicated termination of pregnancy." ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_2_2 a owl:Class ;
  rdfs:label "IDT 10.1.2.2 Outpatient Mental Health or Substance Abuse Center" ;
  rdfs:comment "Establishments with medical staff primarily engaged in providing outpatient services related to the diagnosis and treatment of mental health disorders and alcohol and other substance abuse. These establishments generally treat patients who do not require inpatient treatment. They may provide a counseling staff and information regarding a wide range of mental health and substance abuse issues and/or refer patients to more extensive treatment programs, if necessary." ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_2_3 a owl:Class ;
  rdfs:label "IDT 10.1.2.3 Health Maintenance Organization (HMO) Medical Center" ;
  rdfs:comment "Establishments with physicians and other medical staff primarily engaged in providing a range of outpatient medical services to the health maintenance organization (HMO) subscribers with a focus generally on primary health care. These establishments are owned by the HMO." ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_2_4 a owl:Class ;
  rdfs:label "IDT 10.1.2.4 Kidney Dialysis Center" ;
  rdfs:comment "Establishments with medical staff primarily engaged in providing outpatient kidney or renal dialysis services." ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_2_5 a owl:Class ;
  rdfs:label "IDT 10.1.2.5 Freestanding Surgical Care Center" ;
  rdfs:comment "Establishments with physicians and other medical staff primarily engaged in providing surgical services (e.g., arthroscopic, cataract, plastic surgery) on an outpatient basis." ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_2_6 a owl:Class ;
  rdfs:label "IDT 10.1.2.6 Urgent Care Center" ;
  rdfs:comment "Establishments with physicians and other medical staff primarily engaged in providing treatment of unexpected sickness or injuries that are not life threatening but require immediate attention.  " ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_2_7 a owl:Class ;
  rdfs:label "IDT 10.1.2.7 Rehabilitation Facility" ;
  rdfs:comment "Establishments providing physical, occupational, and vocational therapy on an outpatient basis to patients recovering from an illness or injury.  " ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_2_8 a owl:Class ;
  rdfs:label "IDT 10.1.2.8 Birthing Center" ;
  rdfs:comment "Establishments offering a home-like setting for childbirth. Usually a woman labors, delivers, and recovers in the same room. It's designed for women with low-risk pregnancies.  " ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_2_9 a owl:Class ;
  rdfs:label "IDT 10.1.2.9 Prosthetic Limb Center" ;
  rdfs:comment "Establishments providing fitting and servicing of prosthetic limbs." ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_9-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_9 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_2_10 a owl:Class ;
  rdfs:label "IDT 10.1.2.10 Community Healthcare Center" ;
  rdfs:comment "Community-based, patient-directed facilities that serve populations with limited access to health care." ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_10-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_10 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_2_11 a owl:Class ;
  rdfs:label "IDT 10.1.2.11 Occupational Health Clinic" ;
  rdfs:comment "Facilities provide health services focused on the needs of employees.  Attached to specific industrial or other facilities.  " ;
  rdfs:subClassOf c:IDT_10_1_2 .
c:axiom-idt-10_1_2_11-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_2_11 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_2 .

c:IDT_10_1_3 a owl:Class ;
  rdfs:label "IDT 10.1.3 Extended Care Facility" ;
  rdfs:comment "Facilities providing residential care combined with either nursing, supervisory, or other types of care as required by the residents over an extended period of time. Includes facilities such as nursing homes, mental health and substance abuse homes, assisted living facilities, child group foster homes, disabled group homes, halfway houses, orphanages, and others." ;
  rdfs:subClassOf c:IDT_10_1 .
c:axiom-idt-10_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1 .

c:IDT_10_1_3_1 a owl:Class ;
  rdfs:label "IDT 10.1.3.1 Nursing Care Facility" ;
  rdfs:comment "Facilities primarily engaged in providing inpatient nursing and rehabilitative services. The care is generally provided for an extended period of time to individuals requiring nursing care. These establishments have a permanent core staff of registered or licensed practical nurses who, along with other staff, provide nursing and continuous personal care services." ;
  rdfs:subClassOf c:IDT_10_1_3 .
c:axiom-idt-10_1_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_3 .

c:IDT_10_1_3_2 a owl:Class ;
  rdfs:label "IDT 10.1.3.2 Residential Care Facility" ;
  rdfs:comment "Establishments primarily engaged in providing residential care and treatment for patients with mental health and substance abuse illnesses and for the elderly. These establishments provide room, board, supervision, counseling services and assistance in daily living, such as housekeeping services. Medical services may or may not be available at these establishments." ;
  rdfs:subClassOf c:IDT_10_1_3 .
c:axiom-idt-10_1_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_3 .

c:IDT_10_1_3_3 a owl:Class ;
  rdfs:label "IDT 10.1.3.3 Hospice" ;
  rdfs:comment "Establishments primarily engaged in providing services for terminally ill patients, generally with a prognosis of six months or less.  " ;
  rdfs:subClassOf c:IDT_10_1_3 .
c:axiom-idt-10_1_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_3 .

c:IDT_10_1_4 a owl:Class ;
  rdfs:label "IDT 10.1.4 Health Practitioner Office or Clinic" ;
  rdfs:comment "Offices and clinics of health practitioners having primarily engaged in the independent practice of general or specialized healthcare. Does not include public health offices." ;
  rdfs:subClassOf c:IDT_10_1 .
c:axiom-idt-10_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1 .

c:IDT_10_1_4_1 a owl:Class ;
  rdfs:label "IDT 10.1.4.1 Physicians Office" ;
  rdfs:comment "Offices of health practitioners having the degree of M.D. (Doctor of Medicine) or D.O. (Doctor of Osteopathy) primarily engaged in the independent practice of general or specialized medicine (e.g., anesthesiology, oncology, ophthalmology, psychiatry) or surgery. Includes offices of mental health specialists engaged in independent practice of psychiatry or psychoanalysis." ;
  rdfs:subClassOf c:IDT_10_1_4 .
c:axiom-idt-10_1_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_4 .

c:IDT_10_1_4_2 a owl:Class ;
  rdfs:label "IDT 10.1.4.2 Dental Office" ;
  rdfs:comment "Offices of health practitioners having the degree of D.M.D. (Doctor of Dental Medicine), D.D.S. (Doctor of Dental Surgery), or D.D.Sc. (Doctor of Dental Science) primarily engaged in the independent practice of general or specialized dentistry or dental surgery." ;
  rdfs:subClassOf c:IDT_10_1_4 .
c:axiom-idt-10_1_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_4 .

c:IDT_10_1_4_3 a owl:Class ;
  rdfs:label "IDT 10.1.4.3 Mental Health Practitioner Office" ;
  rdfs:comment "Offices of independent mental health practitioners (except physicians) primarily engaged in the diagnosis and treatment of mental, emotional, and behavioral disorders and/or the diagnosis and treatment of individual or group social dysfunction brought about by such causes as mental illness, alcohol and substance abuse, physical and emotional trauma, or stress." ;
  rdfs:subClassOf c:IDT_10_1_4 .
c:axiom-idt-10_1_4_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_4_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_4 .

c:IDT_10_1_5 a owl:Class ;
  rdfs:label "IDT 10.1.5 Home Healthcare" ;
  rdfs:comment "This industry comprises establishments primarily engaged in providing skilled nursing services in the home, along with a range of the following: personal care services, homemaker and companion services, physical therapy, medical social services, medications, medical equipment and supplies, counseling, 24-hour home care, occupation and vocational therapy, dietary and nutritional services, speech therapy, audiology and high-tech care, such as intravenous therapy." ;
  rdfs:subClassOf c:IDT_10_1 .
c:axiom-idt-10_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1 .

