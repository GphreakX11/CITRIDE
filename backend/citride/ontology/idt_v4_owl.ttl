c:IDT_6_2_4 a owl:Class ;
  rdfs:label "IDT 6.2.4 Fire & Emergency Services Investigation Laboratory" ;
  rdfs:comment "Facilities equipped to conduct forensic investigations on fires." ;
  rdfs:subClassOf c:IDT_6_2 .
