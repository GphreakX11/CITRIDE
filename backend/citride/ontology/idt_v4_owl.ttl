  rdfs:label "IDT 2.1.3.3 Business Lending" ;
  rdfs:comment "Establishments primarily engaged in lending funds to businesses (with or without real estate as collateral). Includes administrative offices, operations centers, data and information systems, and telecommunication systems." ;
  rdfs:subClassOf c:IDT_2_1_3 .
