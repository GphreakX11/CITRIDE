  rdfs:label "IDT 15.1.1.1.5 Data or Call Center" ;
  rdfs:comment "Government buildings providing data warehousing or informational support to department, agency, legislative, or judicial functions.  " ;
  rdfs:subClassOf c:IDT_15_1_1_1 .
c:axiom-idt-15_1_1_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
