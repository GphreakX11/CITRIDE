  rdfs:label "IDT 6.4.2.1 Public Safety Answering Point" ;
  rdfs:comment "Facilities (e.g., 911 Center) for receiving emergency calls and dispatching responders. Generally handles law enforcement, fire, hazardous material (HAZMAT), and emergency medical operations." ;
  rdfs:subClassOf c:IDT_6_4_2 .
