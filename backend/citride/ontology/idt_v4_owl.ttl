c:IDT_15_1_1_2 a owl:Class ;
  rdfs:label "IDT 15.1.1.2 Housing" ;
  rdfs:comment "Government buildings primarily used for living space.  Includes government-owned detached and attached houses, apartment buildings, and barracks whose primary purpose is to provide living quarters for government employees.  " ;
  rdfs:subClassOf c:IDT_15_1_1 .
c:axiom-idt-15_1_1_2-parent a owl:Axiom ;
