# IDT v4 (22 Jun 2011); source SHA-256 ffeddc10b98cca1cd15abd53d70ba8a2bafd593760c8704e76834860fcf193a2
# Local runtime hierarchy. No ontology declaration or external imports.
@prefix c: <urn:citride:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

c:IDT_1 a owl:Class ;
  rdfs:label "IDT 1 Agriculture and Food" ;
  rdfs:comment "Establishments primarily engaged in growing crops, raising animals, harvesting timber, and harvesting fish and other animals from a farm, ranch, or their natural habitats. Food establishments transform livestock and agricultural products into products for intermediate or final consumption. The industry groups are distinguished by the raw materials (generally of animal or vegetable origin) processed into food and beverage products. The food and beverage products manufactured in these establishments are typically sold to wholesalers or retailers for distribution to consumers." ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_1_1 a owl:Class ;
  rdfs:label "IDT 1.1 Supply" ;
  rdfs:comment "Facilities that supply the livestock and agricultural raw materials." ;
  rdfs:subClassOf c:IDT_1 .
c:axiom-idt-1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1 .

c:IDT_1_1_1 a owl:Class ;
  rdfs:label "IDT 1.1.1 Crop Production" ;
  rdfs:comment "Establishments, such as farms, orchards, groves, greenhouses, and nurseries, primarily engaged in growing crops, plants, vines, or trees and their seeds." ;
  rdfs:subClassOf c:IDT_1_1 .
c:axiom-idt-1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1 .

c:IDT_1_1_1_1 a owl:Class ;
  rdfs:label "IDT 1.1.1.1 Oilseed and Grain Farm" ;
  rdfs:comment "Farms engaged in growing oilseed and/or grain crops and/or producing oilseed and grain seeds. These crops have an annual life cycle and are typically grown in open fields. Includes soybeans, oilseeds, dry pea and beans, wheat, corn, oats, rice, and others." ;
  rdfs:subClassOf c:IDT_1_1_1 .
c:axiom-idt-1_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1 .

c:IDT_1_1_1_1_1 a owl:Class ;
  rdfs:label "IDT 1.1.1.1.1 Corn Farm" ;
  rdfs:comment "Farms primarily engaged in growing corn (except sweet corn) and/or producing corn seeds. " ;
  rdfs:subClassOf c:IDT_1_1_1_1 .
c:axiom-idt-1_1_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_1 .

c:IDT_1_1_1_1_2 a owl:Class ;
  rdfs:label "IDT 1.1.1.1.2 Dry Pea and Bean Farm" ;
  rdfs:comment "Farms primarily engaged in growing dry peas, beans, and/or lentils. " ;
  rdfs:subClassOf c:IDT_1_1_1_1 .
c:axiom-idt-1_1_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_1 .

c:IDT_1_1_1_1_3 a owl:Class ;
  rdfs:label "IDT 1.1.1.1.3 Oilseed Farm (Except Soybean)" ;
  rdfs:comment "Farms primarily engaged in growing fibrous oilseed producing plants and/or producing oilseed seeds, such as sunflower, safflower, flax, rape, canola, and sesame." ;
  rdfs:subClassOf c:IDT_1_1_1_1 .
c:axiom-idt-1_1_1_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_1 .

c:IDT_1_1_1_1_4 a owl:Class ;
  rdfs:label "IDT 1.1.1.1.4 Rice Farm" ;
  rdfs:comment "Farms primarily engaged in growing rice (except wild rice) and/or producing rice seeds. " ;
  rdfs:subClassOf c:IDT_1_1_1_1 .
c:axiom-idt-1_1_1_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_1 .

c:IDT_1_1_1_1_5 a owl:Class ;
  rdfs:label "IDT 1.1.1.1.5 Soybean Farm" ;
  rdfs:comment "Farms primarily engaged in growing soybeans and/or producing soybean seeds." ;
  rdfs:subClassOf c:IDT_1_1_1_1 .
c:axiom-idt-1_1_1_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_1 .

c:IDT_1_1_1_1_6 a owl:Class ;
  rdfs:label "IDT 1.1.1.1.6 Wheat Farm" ;
  rdfs:comment "Farms primarily engaged in growing wheat and/or producing wheat seeds." ;
  rdfs:subClassOf c:IDT_1_1_1_1 .
c:axiom-idt-1_1_1_1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_1 .

c:IDT_1_1_1_1_7 a owl:Class ;
  rdfs:label "IDT 1.1.1.1.7 Other Grain Farm (Except Wheat, Corn, and Rice)" ;
  rdfs:comment "Farms primarily engaged in (1) growing grain(s) and/or producing grain seeds (except wheat, corn, and rice) or (2) growing a combination of grain(s) and oilseed(s) with no one grain (or family of grains) or oilseed (or family of oilseeds)." ;
  rdfs:subClassOf c:IDT_1_1_1_1 .
c:axiom-idt-1_1_1_1_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_1_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_1 .

c:IDT_1_1_1_2 a owl:Class ;
  rdfs:label "IDT 1.1.1.2 Vegetable and Melon Farm" ;
  rdfs:comment "Farms primarily engaged in growing root and tuber crops (except sugar beets and peanuts) or edible plants and/or producing root and tuber or edible plant seeds. The crops included in this group have an annual growth cycle and are grown in open fields. Climate and cultural practices limit producing areas but often permit the growing of a combination of crops in a year. " ;
  rdfs:subClassOf c:IDT_1_1_1 .
c:axiom-idt-1_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1 .

c:IDT_1_1_1_2_1 a owl:Class ;
  rdfs:label "IDT 1.1.1.2.1 Vegetable and Melon Farm (Except Potato)" ;
  rdfs:comment "Farms primarily engaged in one or more of the following: (1) growing melons and/or vegetables (except potatoes; dry peas; dry beans; field, silage, or seed corn; and sugar beets); (2) producing vegetable and/or melon seeds; and (3) growing vegetable and/or melon bedding plants." ;
  rdfs:subClassOf c:IDT_1_1_1_2 .
c:axiom-idt-1_1_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_2 .

c:IDT_1_1_1_2_2 a owl:Class ;
  rdfs:label "IDT 1.1.1.2.2 Potato Farm" ;
  rdfs:comment "Farms primarily engaged in growing potatoes and/or producing seed potatoes (except sweet potatoes)." ;
  rdfs:subClassOf c:IDT_1_1_1_2 .
c:axiom-idt-1_1_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_2 .

c:IDT_1_1_1_3 a owl:Class ;
  rdfs:label "IDT 1.1.1.3 Fruit and Tree Nut Farm" ;
  rdfs:comment "Farms primarily engaged in growing fruit and/or tree nut crops. The crops included are generally not grown from seeds and have a perennial life cycle. Includes citrus and non-citrus fruits and nuts." ;
  rdfs:subClassOf c:IDT_1_1_1 .
c:axiom-idt-1_1_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1 .

c:IDT_1_1_1_3_1 a owl:Class ;
  rdfs:label "IDT 1.1.1.3.1 Apple Orchard" ;
  rdfs:comment "Farms primarily engaged in growing apples. " ;
  rdfs:subClassOf c:IDT_1_1_1_3 .
c:axiom-idt-1_1_1_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_3 .

c:IDT_1_1_1_3_2 a owl:Class ;
  rdfs:label "IDT 1.1.1.3.2 Fruit and Nut Tree Combination" ;
  rdfs:comment "Farms primarily engaged in one or more of the following: (1) growing non-citrus fruits (e.g., apples, grapes, berries, peaches); (2) growing tree nuts (e.g., pecans, almonds, pistachios); or (3) growing a combination of fruit(s) and tree nut(s) with no one fruit (or family of fruit) or family of tree nuts accounting for one-half of the establishments agriculture production (value of crops for market)." ;
  rdfs:subClassOf c:IDT_1_1_1_3 .
c:axiom-idt-1_1_1_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_3 .

c:IDT_1_1_1_3_3 a owl:Class ;
  rdfs:label "IDT 1.1.1.3.3 Grape Vineyard" ;
  rdfs:comment "Farms primarily engaged in growing grapes and/or growing grapes to sun dry into raisins. " ;
  rdfs:subClassOf c:IDT_1_1_1_3 .
c:axiom-idt-1_1_1_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_3 .

c:IDT_1_1_1_3_4 a owl:Class ;
  rdfs:label "IDT 1.1.1.3.4 Orange Grove" ;
  rdfs:comment "Farms primarily engaged in growing oranges." ;
  rdfs:subClassOf c:IDT_1_1_1_3 .
c:axiom-idt-1_1_1_3_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_3 .

c:IDT_1_1_1_3_5 a owl:Class ;
  rdfs:label "IDT 1.1.1.3.5 Berry Farm (Except Strawberry)" ;
  rdfs:comment "Farms primarily engaged in growing berries (except strawberries). " ;
  rdfs:subClassOf c:IDT_1_1_1_3 .
c:axiom-idt-1_1_1_3_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_3 .

c:IDT_1_1_1_3_6 a owl:Class ;
  rdfs:label "IDT 1.1.1.3.6 Non-Citrus Tree and Nut Farm" ;
  rdfs:comment "Farms primarily engaged in one or more of the following: (1) growing non-citrus fruits (e.g., apples, grapes, berries, peaches); (2) growing tree nuts (e.g., pecans, almonds, pistachios); or (3) growing a combination of fruit(s) and tree nut(s) with no one fruit (or family of fruit) or family of tree nuts accounting for one-half of the establishment's agriculture production (value of crops for market)." ;
  rdfs:subClassOf c:IDT_1_1_1_3 .
c:axiom-idt-1_1_1_3_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_3 .

c:IDT_1_1_1_3_7 a owl:Class ;
  rdfs:label "IDT 1.1.1.3.7 Tree Nut Farm" ;
  rdfs:comment "Farms primarily engaged in growing tree nuts." ;
  rdfs:subClassOf c:IDT_1_1_1_3 .
c:axiom-idt-1_1_1_3_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_3 .

c:IDT_1_1_1_3_8 a owl:Class ;
  rdfs:label "IDT 1.1.1.3.8 Citrus Grove (Except Orange)" ;
  rdfs:comment "Farms primarily engaged in growing citrus fruits (except oranges)." ;
  rdfs:subClassOf c:IDT_1_1_1_3 .
c:axiom-idt-1_1_1_3_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_3 .

c:IDT_1_1_1_3_9 a owl:Class ;
  rdfs:label "IDT 1.1.1.3.9 Strawberry Farm" ;
  rdfs:comment "Farms primarily engaged in growing strawberries." ;
  rdfs:subClassOf c:IDT_1_1_1_3 .
c:axiom-idt-1_1_1_3_9-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3_9 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_3 .

c:IDT_1_1_1_3_10 a owl:Class ;
  rdfs:label "IDT 1.1.1.3.10 Other Non-Citrus Fruit Farm" ;
  rdfs:comment "Farms primarily engaged in growing non-citrus fruits (except apples, grapes, berries, and fruit(s) and tree nut(s) combinations)." ;
  rdfs:subClassOf c:IDT_1_1_1_3 .
c:axiom-idt-1_1_1_3_10-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_3_10 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_3 .

c:IDT_1_1_1_4 a owl:Class ;
  rdfs:label "IDT 1.1.1.4 Greenhouse, Nursery, or Floriculture Facility" ;
  rdfs:comment "Facilities primarily engaged in growing crops of any kind under cover and/or growing nursery stock and flowers. \"Under cover\" is generally defined as greenhouses, cold frames, cloth houses, and lath houses. The crops grown are removed at various stages of maturity and have annual and perennial life cycles. The nursery stock includes short rotation woody crops that have growth cycles of 10 years or less." ;
  rdfs:subClassOf c:IDT_1_1_1 .
c:axiom-idt-1_1_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1 .

c:IDT_1_1_1_4_1 a owl:Class ;
  rdfs:label "IDT 1.1.1.4.1 Floriculture Production Facility" ;
  rdfs:comment "Production facilities/farms primarily engaged in growing and/or producing floriculture products (e.g., cut flowers and roses, cut cultivated greens, potted flowering and foliage plants, flower seeds) under cover and in open fields. " ;
  rdfs:subClassOf c:IDT_1_1_1_4 .
c:axiom-idt-1_1_1_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_4 .

c:IDT_1_1_1_4_2 a owl:Class ;
  rdfs:label "IDT 1.1.1.4.2 Mushroom Production Facility" ;
  rdfs:comment "Production facilities/farms primarily engaged in growing mushrooms under cover in mines underground, or in other controlled environments." ;
  rdfs:subClassOf c:IDT_1_1_1_4 .
c:axiom-idt-1_1_1_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_4 .

c:IDT_1_1_1_4_3 a owl:Class ;
  rdfs:label "IDT 1.1.1.4.3 Nursery and Tree Production Facility" ;
  rdfs:comment "Production facilities/farms primarily engaged in (1) growing nursery products, nursery stock, shrubbery, bulbs, fruit stock, and sod, under cover or in open fields and/or (2) growing short rotation woody trees with a growth and harvest cycle of 10 years or less for pulp or tree stock. " ;
  rdfs:subClassOf c:IDT_1_1_1_4 .
c:axiom-idt-1_1_1_4_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_4_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_4 .

c:IDT_1_1_1_4_4 a owl:Class ;
  rdfs:label "IDT 1.1.1.4.4 Other Food Crops Grown Under Cover" ;
  rdfs:comment "Production facilities/farms primarily engaged in growing food crops (except mushrooms) under glass or protective cover. " ;
  rdfs:subClassOf c:IDT_1_1_1_4 .
c:axiom-idt-1_1_1_4_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_4_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_4 .

c:IDT_1_1_1_5 a owl:Class ;
  rdfs:label "IDT 1.1.1.5 Tobacco, Peanut, and Other Crop Farm" ;
  rdfs:comment "Farms primarily engaged in growing tobacco, peanuts, cotton, hay, maple syrup, sugarcane, and sugar beet." ;
  rdfs:subClassOf c:IDT_1_1_1 .
c:axiom-idt-1_1_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1 .

c:IDT_1_1_1_5_1 a owl:Class ;
  rdfs:label "IDT 1.1.1.5.1 Cotton" ;
  rdfs:comment "Farms primarily engaged in growing cotton." ;
  rdfs:subClassOf c:IDT_1_1_1_5 .
c:axiom-idt-1_1_1_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_5 .

c:IDT_1_1_1_5_2 a owl:Class ;
  rdfs:label "IDT 1.1.1.5.2 Hay" ;
  rdfs:comment "Farms primarily engaged in growing hay, alfalfa, clover, and/or mixed hay." ;
  rdfs:subClassOf c:IDT_1_1_1_5 .
c:axiom-idt-1_1_1_5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_5_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_5 .

c:IDT_1_1_1_5_3 a owl:Class ;
  rdfs:label "IDT 1.1.1.5.3 Maple Sap" ;
  rdfs:comment "Farms primarily engaged in growing sugar maple, red maple, or black maple trees to produce sap syrup." ;
  rdfs:subClassOf c:IDT_1_1_1_5 .
c:axiom-idt-1_1_1_5_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_5_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_5 .

c:IDT_1_1_1_5_4 a owl:Class ;
  rdfs:label "IDT 1.1.1.5.4 Maple Syrup" ;
  rdfs:comment "Farms primarily engaged in growing sugar maple, red maple, or black maple trees to produce maple syrup." ;
  rdfs:subClassOf c:IDT_1_1_1_5 .
c:axiom-idt-1_1_1_5_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_1_5_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_1_5 .

