c:IDT_11_4_5_2_1 a owl:Class ;
  rdfs:label "IDT 11.4.5.2.1 U.S. Coast Guard Marine Emergency Response Facility" ;
  rdfs:comment "Coast Guard stations (marine, air) providing emergency search and rescue vessels, aircraft, equipment, communications, and personnel. " ;
  rdfs:subClassOf c:IDT_11_4_5_2 .
