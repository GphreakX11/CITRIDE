  rdfs:label "IDT 17.2.1.5.1 Category I Facility (Special Nuclear Materials) " ;
  rdfs:comment "Facilities handling special nuclear materials designated as Category I by the Nuclear Regulatory Commission (NRC)." ;
  rdfs:subClassOf c:IDT_17_2_1_5 .
c:axiom-idt-17_2_1_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
