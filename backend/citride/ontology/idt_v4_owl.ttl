  owl:annotatedTarget c:IDT_8_4 .

c:IDT_8_4_6 a owl:Class ;
  rdfs:label "IDT 8.4.6 Internet Backbone Link" ;
  rdfs:comment "High speed, high capacity communication lines (primarily fiber optic but also other technologies) connecting major metropolitan areas." ;
  rdfs:subClassOf c:IDT_8_4 .
c:axiom-idt-8_4_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_4_6 ;
