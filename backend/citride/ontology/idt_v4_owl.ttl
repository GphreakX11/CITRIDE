c:IDT_11_3_2_2 a owl:Class ;
  rdfs:label "IDT 11.3.2.2 Truck Terminal" ;
  rdfs:comment "Facilities operated by a trucking company handling a large number of truck arrivals and departures. Used for handling and temporary storage of freight pending transfer to other locations. In general, freight is stored at a terminal for relatively short periods (e.g., hours, days). Less-than-truckload (LTL) terminals have buildings where smaller quantities of freight are broken apart and reassembled based on destination. Truckload (TL) facilities handle only full truckloads and typically have large open spaces for truck parking and possibly small or no buildings. Both LTL and TL terminals generally have truck maintenance facilities." ;
  rdfs:subClassOf c:IDT_11_3_2 .
c:axiom-idt-11_3_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_3_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_3_2 .

c:IDT_11_3_2_2_1 a owl:Class ;
  rdfs:label "IDT 11.3.2.2.1 Truck Terminal Hazardous Materials Facility" ;
  rdfs:comment "Facilities at truck terminals specially designed to handle hazardous materials (HAZMAT). " ;
  rdfs:subClassOf c:IDT_11_3_2_2 .
c:axiom-idt-11_3_2_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_3_2_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_3_2_2 .

c:IDT_11_3_2_2_2 a owl:Class ;
  rdfs:label "IDT 11.3.2.2.2 Truck Terminal Non-Hazardous Materials Facility" ;
  rdfs:comment "Facilities at truck terminals designed to handle materials other than hazardous materials. " ;
  rdfs:subClassOf c:IDT_11_3_2_2 .
