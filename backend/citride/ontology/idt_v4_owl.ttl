  rdfs:label "IDT 1.2.2.3 Breakfast Cereal Manufacturing" ;
  rdfs:comment "Facilities engaged in manufacturing breakfast cereal foods. " ;
  rdfs:subClassOf c:IDT_1_2_2 .
