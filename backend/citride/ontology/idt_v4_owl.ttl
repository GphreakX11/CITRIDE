  owl:annotatedTarget c:IDT_5_3_5_2 .

c:IDT_5_3_6 a owl:Class ;
  rdfs:label "IDT 5.3.6 Natural Gas Distribution" ;
  rdfs:comment "Facilities, generally owned by local distribution companies (LDCs), to distribute natural gas to final consumers. " ;
  rdfs:subClassOf c:IDT_5_3 .
