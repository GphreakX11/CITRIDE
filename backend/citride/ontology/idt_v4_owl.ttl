  rdfs:label "IDT 11.6.1.1 Crude Oil Pipeline Component" ;
  rdfs:comment "Lengths of pipeline, interconnections, and valves. Includes above ground, under ground, river crossings, and other segments. " ;
  rdfs:subClassOf c:IDT_11_6_1 .
