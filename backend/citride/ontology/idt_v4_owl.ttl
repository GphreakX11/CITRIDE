c:IDT_5 a owl:Class ;
  rdfs:label "IDT 5 Energy" ;
  rdfs:comment "The Energy Sector is comprised of assets that relate to producing or supplying energy. This includes assets and facilities that produce or supply electricity, petroleum, natural gas, ethanol, biodiesel, hydrogen, coal, and renewable energies.  " ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_5_1 a owl:Class ;
  rdfs:label "IDT 5.1 Electricity" ;
  rdfs:comment "Facilities involved in the generation, transmission, distribution, marketing, and regulation of electricity." ;
  rdfs:subClassOf c:IDT_5 .
c:axiom-idt-5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5 .

c:IDT_5_1_1 a owl:Class ;
  rdfs:label "IDT 5.1.1 Electricity Generation" ;
  rdfs:comment "Facilities that convert other forms of energy into electricity. Other forms of energy converted include: water (e.g., hydroelectric), fossil fuels, uranium, wind, geothermal, and solar." ;
  rdfs:subClassOf c:IDT_5_1 .
c:axiom-idt-5_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1 .

c:IDT_5_1_1_1 a owl:Class ;
  rdfs:label "IDT 5.1.1.1 Hydroelectric Power Generation" ;
  rdfs:comment "Facilities using water power to drive a turbine and produce electricity." ;
  rdfs:subClassOf c:IDT_5_1_1 .
c:axiom-idt-5_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1 .

c:IDT_5_1_1_1_1 a owl:Class ;
  rdfs:label "IDT 5.1.1.1.1 Hydroelectric Dam" ;
  rdfs:comment "Facilities with a dam and a water storage reservoir where water is released at controlled rates through the turbines. The dams are categorized as high-, medium-, or low-head depending on their height." ;
  rdfs:subClassOf c:IDT_5_1_1_1 .
c:axiom-idt-5_1_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_1 .

c:IDT_5_1_1_1_2 a owl:Class ;
  rdfs:label "IDT 5.1.1.1.2 Pumped Storage Facility" ;
  rdfs:comment "Facilities with a dam and a water storage reservoir where water is pumped up behind the dam during low electricity demand periods. It is released to run through the turbines to generate electricity during peak load periods." ;
  rdfs:subClassOf c:IDT_5_1_1_1 .
c:axiom-idt-5_1_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_1 .

c:IDT_5_1_1_1_3 a owl:Class ;
  rdfs:label "IDT 5.1.1.1.3 Run-of-river Generator" ;
  rdfs:comment "Facilities without a dam, or only a relatively small one, and rely on the continuous flow of a river to operate the turbines.  " ;
  rdfs:subClassOf c:IDT_5_1_1_1 .
c:axiom-idt-5_1_1_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_1 .

c:IDT_5_1_1_2 a owl:Class ;
  rdfs:label "IDT 5.1.1.2 Renewable Energy Generation" ;
  rdfs:comment "Renewable energy source facilities, other than hydroelectric power, used to generate electricity.   " ;
  rdfs:subClassOf c:IDT_5_1_1 .
c:axiom-idt-5_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1 .

c:IDT_5_1_1_2_1 a owl:Class ;
  rdfs:label "IDT 5.1.1.2.1 Wind " ;
  rdfs:comment "Towers and turbines that are turned by wind to produce electricity. " ;
  rdfs:subClassOf c:IDT_5_1_1_2 .
c:axiom-idt-5_1_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_2 .

c:IDT_5_1_1_2_2 a owl:Class ;
  rdfs:label "IDT 5.1.1.2.2 Solar " ;
  rdfs:comment "Solar collectors and associated equipment designed to capture the sun's light and heat and convert it into electricity." ;
  rdfs:subClassOf c:IDT_5_1_1_2 .
c:axiom-idt-5_1_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_2 .

c:IDT_5_1_1_2_3 a owl:Class ;
  rdfs:label "IDT 5.1.1.2.3 Geothermal" ;
  rdfs:comment "Equipment and associated systems designed to capture heat from the earth and convert it into electricity.   " ;
  rdfs:subClassOf c:IDT_5_1_1_2 .
c:axiom-idt-5_1_1_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_2 .

c:IDT_5_1_1_3 a owl:Class ;
  rdfs:label "IDT 5.1.1.3 Fossil Fuel Electric Power Generation" ;
  rdfs:comment "Facilities that use fossil fuels, such as coal, oil, or natural gas, in steam turbine, internal combustion, or combustion turbine processes to produce electricity." ;
  rdfs:subClassOf c:IDT_5_1_1 .
c:axiom-idt-5_1_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1 .

c:IDT_5_1_1_3_1 a owl:Class ;
  rdfs:label "IDT 5.1.1.3.1 Coal-fired Generator" ;
  rdfs:comment "Facilities that use coal as their fuel source." ;
  rdfs:subClassOf c:IDT_5_1_1_3 .
c:axiom-idt-5_1_1_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_3 .

c:IDT_5_1_1_3_2 a owl:Class ;
  rdfs:label "IDT 5.1.1.3.2 Natural Gas-fired Generator" ;
  rdfs:comment "Facilities that use natural gas as their fuel source.  " ;
  rdfs:subClassOf c:IDT_5_1_1_3 .
c:axiom-idt-5_1_1_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_3 .

c:IDT_5_1_1_3_3 a owl:Class ;
  rdfs:label "IDT 5.1.1.3.3 Oil-Fired Generator" ;
  rdfs:comment "Facilities that use oil (e.g., residual fuel oil, diesel fuel) as their fuel source. " ;
  rdfs:subClassOf c:IDT_5_1_1_3 .
c:axiom-idt-5_1_1_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_3 .

c:IDT_5_1_1_4 a owl:Class ;
  rdfs:label "IDT 5.1.1.4 Nuclear Electric Power Generation" ;
  rdfs:comment "Facilities using nuclear power to produce electricity for use in the electric power grid." ;
  rdfs:subClassOf c:IDT_5_1_1 .
c:axiom-idt-5_1_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1 .

c:IDT_5_1_1_4_1 a owl:Class ;
  rdfs:label "IDT 5.1.1.4.1 Light Water Reactor Power Plant" ;
  rdfs:comment "Nuclear power plants with pressurized water reactors or boiling water reactors. Includes all equipment (e.g., steam generators, turbines, generators, transformers, switchgear) used to provide electricity to the grid." ;
  rdfs:subClassOf c:IDT_5_1_1_4 .
c:axiom-idt-5_1_1_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_4 .

c:IDT_5_1_1_4_2 a owl:Class ;
  rdfs:label "IDT 5.1.1.4.2 Other Reactor Power Plant" ;
  rdfs:comment "Nuclear power plants cooled by other than light water. There are no facilities of this type currently operating in the U.S., although there are several in Canada and other countries. Includes all equipment (e.g., steam generators, turbines, generators, transformers, switchgear) used to provide electricity to the grid." ;
  rdfs:subClassOf c:IDT_5_1_1_4 .
c:axiom-idt-5_1_1_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1_4 .

c:IDT_5_1_1_5 a owl:Class ;
  rdfs:label "IDT 5.1.1.5 Other Electric Power Generation" ;
  rdfs:comment "Facilities that convert other forms of energy into electricity." ;
  rdfs:subClassOf c:IDT_5_1_1 .
c:axiom-idt-5_1_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_1 .

c:IDT_5_1_2 a owl:Class ;
  rdfs:label "IDT 5.1.2 Electricity Transmission" ;
  rdfs:comment "Facilities used to transmit bulk quantities of electricity over relatively long distances using high voltages (usually > 69 kV)." ;
  rdfs:subClassOf c:IDT_5_1 .
c:axiom-idt-5_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1 .

c:IDT_5_1_2_1 a owl:Class ;
  rdfs:label "IDT 5.1.2.1 Transmission Line" ;
  rdfs:comment "Transmission towers and lines." ;
  rdfs:subClassOf c:IDT_5_1_2 .
c:axiom-idt-5_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_2 .

c:IDT_5_1_2_2 a owl:Class ;
  rdfs:label "IDT 5.1.2.2 Transmission Substation" ;
  rdfs:comment "Connection points in the transmission network and may include transformers, switches, reactors, circuit breakers, series or shunt capacitors, phase shifters, and switchgear.  " ;
  rdfs:subClassOf c:IDT_5_1_2 .
c:axiom-idt-5_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_2 .

c:IDT_5_1_2_3 a owl:Class ;
  rdfs:label "IDT 5.1.2.3 Direct Current (DC) Converter Station" ;
  rdfs:comment "Facilities that convert high voltage power between alternating current (AC) and direct current (DC) for improved efficiency in transmission. " ;
  rdfs:subClassOf c:IDT_5_1_2 .
c:axiom-idt-5_1_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_2 .

c:IDT_5_1_2_4 a owl:Class ;
  rdfs:label "IDT 5.1.2.4 Generation Dispatch and Transmission Control Center" ;
  rdfs:comment "Centers that control the dispatching of generators and the high voltage transmission system. Includes generation and transmission supervisory control and data acquisition (SCADA) systems. Includes independent system operator (ISO) facilities." ;
  rdfs:subClassOf c:IDT_5_1_2 .
c:axiom-idt-5_1_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_2 .

c:IDT_5_1_3 a owl:Class ;
  rdfs:label "IDT 5.1.3 Electricity Distribution" ;
  rdfs:comment "Facilities used to transmit electricity to final consumers at lower voltages (usually <69 kV)." ;
  rdfs:subClassOf c:IDT_5_1 .
c:axiom-idt-5_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1 .

c:IDT_5_1_3_1 a owl:Class ;
  rdfs:label "IDT 5.1.3.1 Distribution Line" ;
  rdfs:comment "Facilities that include lines, poles, transformers, and meters.  " ;
  rdfs:subClassOf c:IDT_5_1_3 .
c:axiom-idt-5_1_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_3 .

c:IDT_5_1_3_2 a owl:Class ;
  rdfs:label "IDT 5.1.3.2 Distribution Substation" ;
  rdfs:comment "Connection points in the distribution system and from the distribution system to the transmission system. May include transformers, capacitors, and switchgear." ;
  rdfs:subClassOf c:IDT_5_1_3 .
c:axiom-idt-5_1_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_3 .

c:IDT_5_1_3_3 a owl:Class ;
  rdfs:label "IDT 5.1.3.3 Distribution Control and Dispatch Center" ;
  rdfs:comment "Centers that control the lower voltage distribution system. Includes distribution supervisory control and data acquisition (SCADA) systems.  " ;
  rdfs:subClassOf c:IDT_5_1_3 .
c:axiom-idt-5_1_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_3 .

c:IDT_5_1_4 a owl:Class ;
  rdfs:label "IDT 5.1.4 Electricity Market" ;
  rdfs:comment "Business operations that deal in the sale and purchase of electricity on the wholesale level." ;
  rdfs:subClassOf c:IDT_5_1 .
c:axiom-idt-5_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1 .

c:IDT_5_1_4_1 a owl:Class ;
  rdfs:label "IDT 5.1.4.1 Generation Market" ;
  rdfs:comment "Markets into which generation companies bid capacity.  May be operated by an independent system operator (ISO).  " ;
  rdfs:subClassOf c:IDT_5_1_4 .
c:axiom-idt-5_1_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_4 .

c:IDT_5_1_4_2 a owl:Class ;
  rdfs:label "IDT 5.1.4.2 Transmission Market" ;
  rdfs:comment "Markets for transmission capacity. May be operated by an independent system operator (ISO) or a transmission company. Includes open access same-time information systems (OASIS).  " ;
  rdfs:subClassOf c:IDT_5_1_4 .
c:axiom-idt-5_1_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_4 .

c:IDT_5_1_5 a owl:Class ;
  rdfs:label "IDT 5.1.5 Electric Vehicle Charging Station" ;
  rdfs:comment "Facility where plug-in electric vehicles can charge their batteries." ;
  rdfs:subClassOf c:IDT_5_1 .
c:axiom-idt-5_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1 .

c:IDT_5_1_5_1 a owl:Class ;
  rdfs:label "IDT 5.1.5.1 Electric Vehicle Rapid-charging Station" ;
  rdfs:comment "Facility where plug-in electric vehicles can have their batteries charged up to at least one half capacity in 30 minutes or less." ;
  rdfs:subClassOf c:IDT_5_1_5 .
c:axiom-idt-5_1_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_5 .

c:IDT_5_1_5_2 a owl:Class ;
  rdfs:label "IDT 5.1.5.2 Electric Vehicle Standard-charging Station" ;
  rdfs:comment "Facility where plug-in electric vehicles can have their batteries fully charged in four to eight hours." ;
  rdfs:subClassOf c:IDT_5_1_5 .
c:axiom-idt-5_1_5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_5_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1_5 .

c:IDT_5_1_6 a owl:Class ;
  rdfs:label "IDT 5.1.6 Other Electricity Facility" ;
  rdfs:comment "Facilities and assets not elsewhere categorized.  " ;
  rdfs:subClassOf c:IDT_5_1 .
c:axiom-idt-5_1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_1 .

c:IDT_5_2 a owl:Class ;
  rdfs:label "IDT 5.2 Petroleum" ;
  rdfs:comment "Facilities involved in the exploration, supply, processing, storage, transport, distribution, marketing, and regulation of petroleum. Includes crude oil and refined petroleum products." ;
  rdfs:subClassOf c:IDT_5 .
c:axiom-idt-5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5 .

c:IDT_5_2_1 a owl:Class ;
  rdfs:label "IDT 5.2.1 Crude Oil Supply " ;
  rdfs:comment "These facilities are involved in supplying crude oil." ;
  rdfs:subClassOf c:IDT_5_2 .
c:axiom-idt-5_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2 .

c:IDT_5_2_1_1 a owl:Class ;
  rdfs:label "IDT 5.2.1.1 Drilling Rig" ;
  rdfs:comment "Drilling, monitoring, and testing equipment that creates long-lasting stable boreholes into the ground or sea bottom and connects to an oil and gas reservoir so that a producing well can be established.  The drilling equipment samples soil and rock so that an appropriate and sustainable borehole can be encased and protected from changes in pressure and the environment to allow the borehole to safely produce oil and/or gas for many decades.     " ;
  rdfs:subClassOf c:IDT_5_2_1 .
c:axiom-idt-5_2_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_1 .

c:IDT_5_2_1_2 a owl:Class ;
  rdfs:label "IDT 5.2.1.2 On-Shore Well" ;
  rdfs:comment "Land-based facilities used for the extraction of crude oil from the ground. A number of wells may be grouped closely together to extract oil from a reservoir. Includes equipment such as gathering lines used to bring the output of several wells to a central point, storage tanks, and other equipment. Note: Natural gas is sometimes extracted from the same wells that are used to extract oil. This is referred to as \"associated gas.\"" ;
  rdfs:subClassOf c:IDT_5_2_1 .
c:axiom-idt-5_2_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_1 .

c:IDT_5_2_1_3 a owl:Class ;
  rdfs:label "IDT 5.2.1.3 Off-Shore Well" ;
  rdfs:comment "Sea-based facilities used for the extraction of crude oil. Includes equipment such as gathering lines used to bring the output on shore. Note: Natural gas is sometimes extracted from the same wells that are used to extract oil. This is referred to as \"associated gas.\"" ;
  rdfs:subClassOf c:IDT_5_2_1 .
c:axiom-idt-5_2_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_1 .

c:IDT_5_2_1_4 a owl:Class ;
  rdfs:label "IDT 5.2.1.4 Crude Oil Production from Other Sources" ;
  rdfs:comment "Facilities designed to extract crude oil from other sources. " ;
  rdfs:subClassOf c:IDT_5_2_1 .
c:axiom-idt-5_2_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_1 .

c:IDT_5_2_1_5 a owl:Class ;
  rdfs:label "IDT 5.2.1.5 Gas-Oil Separation Plant" ;
  rdfs:comment "Facilities designed to separate gases and contaminants from the crude oil." ;
  rdfs:subClassOf c:IDT_5_2_1 .
c:axiom-idt-5_2_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_1 .

c:IDT_5_2_1_6 a owl:Class ;
  rdfs:label "IDT 5.2.1.6 Oil Shale Production " ;
  rdfs:comment "Equipment and facilities used to produce oil from oil shale.  This usually includes mining equipment to extract the oil shale, retort equipment to heat the oil shale into a liquid, and an upgrade facility to produce the synthetic crude oil from the oil shale.  Where in situ processing occurs, the oil shale is not mined, but drilling equipment is required to place heaters in the oil shale to heat it in place. Drilling equipment is then required to create boreholes into (the now) liquid reservoirs and to put wells in place for production. " ;
  rdfs:subClassOf c:IDT_5_2_1 .
c:axiom-idt-5_2_1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_1 .

c:IDT_5_2_2 a owl:Class ;
  rdfs:label "IDT 5.2.2 Crude Oil Storage" ;
  rdfs:comment "Facilities for storing crude oil other than storage at refineries.  " ;
  rdfs:subClassOf c:IDT_5_2 .
c:axiom-idt-5_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2 .

c:IDT_5_2_2_1 a owl:Class ;
  rdfs:label "IDT 5.2.2.1 Strategic Petroleum Reserve" ;
  rdfs:comment "The Strategic Petroleum Reserve is a U.S. Government complex of four sites created in deep underground salt caverns along the Texas and Louisiana Gulf Coast that stores+H62 emergency supplies of crude oil." ;
  rdfs:subClassOf c:IDT_5_2_2 .
c:axiom-idt-5_2_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_2 .

c:IDT_5_2_2_2 a owl:Class ;
  rdfs:label "IDT 5.2.2.2 Crude Oil Bulk Storage" ;
  rdfs:comment "Facilities used for the storage and/or marketing of crude oil. Includes storage tanks, pipes and pumps, control machinery, and other equipment. Does not include storage at refineries." ;
  rdfs:subClassOf c:IDT_5_2_2 .
c:axiom-idt-5_2_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_2 .

c:IDT_5_2_2_2_1 a owl:Class ;
  rdfs:label "IDT 5.2.2.2.1 Crude Oil Land-based Terminal" ;
  rdfs:comment "Land-based terminals for storing crude oil. Generally receives and distributes crude oil via pipeline from either domestic or import suppliers. Includes the valves, piping, control machinery, and other equipment to connect to the pipelines serving it." ;
  rdfs:subClassOf c:IDT_5_2_2_2 .
c:axiom-idt-5_2_2_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_2_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_2_2 .

c:IDT_5_2_2_2_2 a owl:Class ;
  rdfs:label "IDT 5.2.2.2.2 Crude Oil Marine Terminal" ;
  rdfs:comment "Terminals located on a waterway. Generally receives and distributes crude oil via pipeline, barge, or marine tanker from either domestic or import suppliers. Includes storage tanks, piping, control machinery, and other equipment." ;
  rdfs:subClassOf c:IDT_5_2_2_2 .
c:axiom-idt-5_2_2_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_2_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_2_2 .

c:IDT_5_2_3 a owl:Class ;
  rdfs:label "IDT 5.2.3 Crude Oil Transport" ;
  rdfs:comment "Facilities for the transport of crude oil. " ;
  rdfs:subClassOf c:IDT_5_2 .
c:axiom-idt-5_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2 .

c:IDT_5_2_3_1 a owl:Class ;
  rdfs:label "IDT 5.2.3.1 Crude Oil Pipeline" ;
  rdfs:comment "Pipeline facilities for the transport of crude oil.  " ;
  rdfs:subClassOf c:IDT_5_2_3 .
c:axiom-idt-5_2_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_3 .

c:IDT_5_2_3_1_1 a owl:Class ;
  rdfs:label "IDT 5.2.3.1.1 Crude Oil Pipeline Segment" ;
  rdfs:comment "Components of pipelines such as interconnections and valves.  Includes above ground, under ground, river crossings, and other segments.  " ;
  rdfs:subClassOf c:IDT_5_2_3_1 .
c:axiom-idt-5_2_3_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_3_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_3_1 .

c:IDT_5_2_3_1_2 a owl:Class ;
  rdfs:label "IDT 5.2.3.1.2 Crude Oil Pipeline Pumping Station" ;
  rdfs:comment "Stations along the length of a pipeline. Includes pumps, valves, control machinery and breakout storage." ;
  rdfs:subClassOf c:IDT_5_2_3_1 .
c:axiom-idt-5_2_3_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_3_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_3_1 .

c:IDT_5_2_3_1_3 a owl:Class ;
  rdfs:label "IDT 5.2.3.1.3 Crude Oil Pipeline Control Center" ;
  rdfs:comment "Central control facilities that monitor and operate a pipeline(s). Includes supervisory control and data acquisition (SCADA) system control centers.  " ;
  rdfs:subClassOf c:IDT_5_2_3_1 .
c:axiom-idt-5_2_3_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_3_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_3_1 .

c:IDT_5_2_3_2 a owl:Class ;
  rdfs:label "IDT 5.2.3.2 Crude Oil Marine Transport" ;
  rdfs:comment "Marine facilities and assets for transporting crude oil." ;
  rdfs:subClassOf c:IDT_5_2_3 .
c:axiom-idt-5_2_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_3 .

c:IDT_5_2_3_2_1 a owl:Class ;
  rdfs:label "IDT 5.2.3.2.1 Crude Oil Tanker" ;
  rdfs:comment "Marine vessels for moving crude oil. Includes crude carriers for importing crude oil, tankers and barges for movement of crude oil on coastal and inland waterways." ;
  rdfs:subClassOf c:IDT_5_2_3_2 .
c:axiom-idt-5_2_3_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_3_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_3_2 .

c:IDT_5_2_3_2_2 a owl:Class ;
  rdfs:label "IDT 5.2.3.2.2 Port Handling Crude Oil" ;
  rdfs:comment "Port facilities for mooring, docking, loading, and unloading marine vessels with crude oil. Includes shuttle tankers to off-load larger vessels. Note: Port may also handle other marine cargo." ;
  rdfs:subClassOf c:IDT_5_2_3_2 .
c:axiom-idt-5_2_3_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_3_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_3_2 .

c:IDT_5_2_4 a owl:Class ;
  rdfs:label "IDT 5.2.4 Petroleum Processing" ;
  rdfs:comment "Facilities involved in producing petroleum products from crude oil." ;
  rdfs:subClassOf c:IDT_5_2 .
c:axiom-idt-5_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2 .

c:IDT_5_2_4_1 a owl:Class ;
  rdfs:label "IDT 5.2.4.1 Petroleum Refinery" ;
  rdfs:comment "Facilities that manufacture petroleum products (e.g., gasoline and blending components, diesel fuel, jet fuel) from crude oil, natural gas liquids, or other sources. Includes on-site storage." ;
  rdfs:subClassOf c:IDT_5_2_4 .
c:axiom-idt-5_2_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_4 .

c:IDT_5_2_5 a owl:Class ;
  rdfs:label "IDT 5.2.5 Petroleum Product Storage" ;
  rdfs:comment "Facilities for storing petroleum products. Does not include storage at refineries, in production fields, and breakout storage along pipeline routes." ;
  rdfs:subClassOf c:IDT_5_2 .
c:axiom-idt-5_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2 .

c:IDT_5_2_5_1 a owl:Class ;
  rdfs:label "IDT 5.2.5.1 Petroleum Product Bulk Storage" ;
  rdfs:comment "Facilities used for the storage and/or marketing of petroleum products. Includes storage tanks, pipes and pumps, control machinery, and other equipment. These facilities are not used to store petroleum products for final consumption. Does not include storage at refineries. Also referred to as tank farms." ;
  rdfs:subClassOf c:IDT_5_2_5 .
c:axiom-idt-5_2_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_5 .

c:IDT_5_2_5_1_1 a owl:Class ;
  rdfs:label "IDT 5.2.5.1.1 Petroleum Product Land-based Bulk Terminal" ;
  rdfs:comment "Large land-based terminals (generally >50,000 barrels storage capacity). Generally receives and distributes its petroleum products via pipeline from either domestic or import suppliers. Includes the valves, piping, control machinery, and other equipment to connect to the pipelines serving it." ;
  rdfs:subClassOf c:IDT_5_2_5_1 .
c:axiom-idt-5_2_5_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_5_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_5_1 .

c:IDT_5_2_5_1_2 a owl:Class ;
  rdfs:label "IDT 5.2.5.1.2 Petroleum Product Marine Bulk Terminal" ;
  rdfs:comment "Large terminal (generally >50,000 barrels storage capacity) located on a waterway. Generally receives and distributes its petroleum via pipeline, barge, or marine tanker from either domestic or foreign suppliers." ;
  rdfs:subClassOf c:IDT_5_2_5_1 .
c:axiom-idt-5_2_5_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_5_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_5_1 .

c:IDT_5_2_5_1_3 a owl:Class ;
  rdfs:label "IDT 5.2.5.1.3 Petroleum Product Bulk Plant" ;
  rdfs:comment "Smaller facilities (generally <50,000 barrels storage capacity) used for the storage and/or marketing of petroleum products. Includes storage tanks, pipes and pumps, control machinery, and other equipment. If distributing gasoline, also includes terminal rack facilities for tanker trucks and will usually have ethanol blending facilities as well. May receive fuel by pipeline, vessel, rail car, or tanker truck; usually distributes to customers via tanker truck. Also referred to as bulk stations." ;
  rdfs:subClassOf c:IDT_5_2_5_1 .
c:axiom-idt-5_2_5_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_5_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_5_1 .

c:IDT_5_2_5_2 a owl:Class ;
  rdfs:label "IDT 5.2.5.2 Underground Petroleum Gas Storage" ;
  rdfs:comment "Underground facilities (e.g., salt caverns) used to store large quantities of petroleum gases (e.g., liquefied petroleum gas [LPG]). Note: Does not include underground storage of natural gas, which is categorized elsewhere." ;
  rdfs:subClassOf c:IDT_5_2_5 .
c:axiom-idt-5_2_5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_5_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_5 .

c:IDT_5_2_5_3 a owl:Class ;
  rdfs:label "IDT 5.2.5.3 Petroleum Product Storage for Retail Distribution" ;
  rdfs:comment "Facilities used to store petroleum products for retail distribution to end-use customers.  " ;
  rdfs:subClassOf c:IDT_5_2_5 .
c:axiom-idt-5_2_5_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_5_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_5 .

c:IDT_5_2_5_3_1 a owl:Class ;
  rdfs:label "IDT 5.2.5.3.1 Motor Vehicle Fueling Station" ;
  rdfs:comment "Facilities dispensing motor vehicle fuels (e.g., gasoline, diesel, gasohol) to consumers. May include maintenance and repair facilities." ;
  rdfs:subClassOf c:IDT_5_2_5_3 .
c:axiom-idt-5_2_5_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_5_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_5_3 .

c:IDT_5_2_5_3_2 a owl:Class ;
  rdfs:label "IDT 5.2.5.3.2 Heating Oil Dealer" ;
  rdfs:comment "Facilities for retailing heating oil to consumers with deliveries made by truck." ;
  rdfs:subClassOf c:IDT_5_2_5_3 .
c:axiom-idt-5_2_5_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_5_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_5_3 .

c:IDT_5_2_5_3_3 a owl:Class ;
  rdfs:label "IDT 5.2.5.3.3 Liquefied Petroleum Gas (LPG) Dealer" ;
  rdfs:comment "Facilities for retailing liquefied petroleum gas (LPG). Deliveries generally made by truck or in consumer-sized tanks." ;
  rdfs:subClassOf c:IDT_5_2_5_3 .
c:axiom-idt-5_2_5_3_3-parent a owl:Axiom ;
