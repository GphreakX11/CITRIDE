c:IDT_6_4_2_2 a owl:Class ;
  rdfs:label "IDT 6.4.2.2 Mutual Aid and Multi-Agency Coordination System (Emergency Operations Center [EOC]) " ;
  rdfs:comment "Communication facilities designed to connect agencies in different jurisdictions and allow for coordinated response to emergencies.  May be operated in conjunction with other communication systems." ;
  rdfs:subClassOf c:IDT_6_4_2 .
