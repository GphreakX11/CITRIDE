c:IDT_15_2_1_1 a owl:Class ;
  rdfs:label "IDT 15.2.1.1 Emergency Services" ;
  rdfs:comment "Government buildings used to provide emergency services." ;
  rdfs:subClassOf c:IDT_15_2_1 .
c:axiom-idt-15_2_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_15_2_1_1 ;
