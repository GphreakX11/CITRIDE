  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_6_3 .

c:IDT_5_2_6_4 a owl:Class ;
  rdfs:label "IDT 5.2.6.4 Petroleum Product Road Transport" ;
  rdfs:comment "Road assets for transporting petroleum products." ;
  rdfs:subClassOf c:IDT_5_2_6 .
c:axiom-idt-5_2_6_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_6_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_6 .

c:IDT_5_2_6_4_1 a owl:Class ;
  rdfs:label "IDT 5.2.6.4.1 Tanker Truck" ;
  rdfs:comment "Trucks (generally semi-trailers) designed to carry petroleum products.  " ;
  rdfs:subClassOf c:IDT_5_2_6_4 .
c:axiom-idt-5_2_6_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
