c:IDT_1_1_3 a owl:Class ;
  rdfs:label "IDT 1.1.3 Forestry and Logging" ;
  rdfs:comment "Facilities and operations that grow and harvest timber on a long production cycle (e.g., 10 years or more). Includes forest tract operations, forest nurseries, gathering of forest products (e.g., gum, aromatic woods), and logging (e.g., cutting of trees)." ;
  rdfs:subClassOf c:IDT_1_1 .
c:axiom-idt-1_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1 .

c:IDT_1_1_3_1 a owl:Class ;
  rdfs:label "IDT 1.1.3.1 Forestry" ;
  rdfs:comment "Facilities and operations that grow timber on a long production cycle (e.g., 10 years or more). Includes forest tract operations, forest nurseries, gathering of forest products (e.g., gum, aromatic woods)." ;
  rdfs:subClassOf c:IDT_1_1_3 .
c:axiom-idt-1_1_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_3 .

c:IDT_1_1_3_1_1 a owl:Class ;
  rdfs:label "IDT 1.1.3.1.1 Timber Tract Operation" ;
  rdfs:comment "Facilities primarily engaged in the operation of timber tracts for the purpose of selling standing timber." ;
  rdfs:subClassOf c:IDT_1_1_3_1 .
c:axiom-idt-1_1_3_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_3_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_3_1 .

c:IDT_1_1_3_1_2 a owl:Class ;
  rdfs:label "IDT 1.1.3.1.2 Forest Nursery and Gathering of Forest Products" ;
  rdfs:comment "Facilities primarily engaged in (1) growing trees for reforestation and/or (2) gathering forest products, such as gums, barks, balsam needles, rhizomes, fibers, Spanish moss, ginseng, and truffles." ;
  rdfs:subClassOf c:IDT_1_1_3_1 .
c:axiom-idt-1_1_3_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_3_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_3_1 .

c:IDT_1_1_3_2 a owl:Class ;
  rdfs:label "IDT 1.1.3.2 Logging" ;
  rdfs:comment "Facilities and operations primarily engaged in one or more of the following: (1) cutting timber; (2) cutting and transporting timber; and (3) producing wood chips in the field." ;
  rdfs:subClassOf c:IDT_1_1_3 .
c:axiom-idt-1_1_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_3 .

c:IDT_1_1_3_2_1 a owl:Class ;
  rdfs:label "IDT 1.1.3.2.1 Cutting and Transporting Timber" ;
  rdfs:comment "Facilities and operations primarily engaged in cutting and transporting (harvesting) of timber." ;
  rdfs:subClassOf c:IDT_1_1_3_2 .
c:axiom-idt-1_1_3_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_3_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_3_2 .

c:IDT_1_1_3_2_2 a owl:Class ;
  rdfs:label "IDT 1.1.3.2.2 Pulpwood Logging Camp" ;
  rdfs:comment "Facilities and operations primarily established as logging camps engaged in cutting and transporting (harvesting) of pulpwood." ;
  rdfs:subClassOf c:IDT_1_1_3_2 .
c:axiom-idt-1_1_3_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
