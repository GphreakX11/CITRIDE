  rdfs:label "IDT 1.5.2.2 Packaged Frozen Food Merchant Wholesaler" ;
  rdfs:comment "Establishments primarily engaged in the merchant wholesale distribution of packaged frozen foods (except dairy products)." ;
  rdfs:subClassOf c:IDT_1_5_2 .
