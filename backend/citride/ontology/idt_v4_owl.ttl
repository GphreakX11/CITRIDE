  rdfs:label "IDT 11.4.4.1 Inland Waterway" ;
  rdfs:comment "Natural waterways (e.g., rivers, lakes, bayous, estuaries) capable of carrying marine traffic. " ;
  rdfs:subClassOf c:IDT_11_4_4 .
c:axiom-idt-11_4_4_1-parent a owl:Axiom ;
