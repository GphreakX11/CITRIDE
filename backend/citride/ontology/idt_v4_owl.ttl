  owl:annotatedTarget c:IDT_11_6 .

c:IDT_11_6_4_1 a owl:Class ;
  rdfs:label "IDT 11.6.4.1 City Gate Station" ;
  rdfs:comment "Facilities where a local distribution company (LDC) receives gas from a transmission company. Activities at the facility include: measuring, custody transfer, pressure regulating, and odorization to meet distribution network requirements. " ;
  rdfs:subClassOf c:IDT_11_6_4 .
c:axiom-idt-11_6_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
