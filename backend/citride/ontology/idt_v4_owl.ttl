  rdfs:label "IDT 11.6.2.4 Petroleum Product Storage" ;
  rdfs:comment "Facilities used for the storage and/or marketing of petroleum products. Includes storage tanks, pipes and pumps, control machinery, and other equipment. Does not include storage at refineries. Also referred to as tank farms." ;
  rdfs:subClassOf c:IDT_11_6_2 .
