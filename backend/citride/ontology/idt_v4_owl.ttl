  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_3 .

c:IDT_6_3_2 a owl:Class ;
  rdfs:label "IDT 6.3.2 Emergency Medical Services Operational Facility" ;
  rdfs:comment "Facilities used for day-to-day Emergency Medical Services (EMS) operations. Includes vehicle bays for EMS apparatus and sleeping quarters for EMS personnel. " ;
  rdfs:subClassOf c:IDT_6_3 .
c:axiom-idt-6_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_3 .

c:IDT_6_3_3 a owl:Class ;
  rdfs:label "IDT 6.3.3 Emergency Medical Apparatus" ;
  rdfs:comment "Includes heliports for medivac helicopters and vehicles used in emergency medical activities (e.g., ambulances, mobile intensive care units, medivac helicopters)." ;
  rdfs:subClassOf c:IDT_6_3 .
c:axiom-idt-6_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_3 .

c:IDT_6_3_4 a owl:Class ;
  rdfs:label "IDT 6.3.4 Other Specialized Emergency Medical Services " ;
  rdfs:comment "Facilities housing specially trained medical personnel and their equipment (e.g., National Disaster Medical System units, Disaster Medical Assistance Teams, Disaster Mortuary Operational Response Teams)." ;
  rdfs:subClassOf c:IDT_6_3 .
c:axiom-idt-6_3_4-parent a owl:Axiom ;
