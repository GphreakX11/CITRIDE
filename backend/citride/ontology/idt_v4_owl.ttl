c:IDT_11_4_2_2_1 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.1 Deep Draft General Cargo Terminal" ;
  rdfs:comment "Terminals designed to handle a variety of general cargo. These facilities may have transit sheds, open storage areas, and warehouses on site. Includes break bulk, container, heavy-lift, roll-on/roll-off (RO/RO), and parcel-sized dry bulk shipments." ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_2 .

c:IDT_11_4_2_2_2 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.2 Deep Draft Containerized Cargo Terminal" ;
  rdfs:comment "Terminals designed to move cargo containers to and from vessels. These terminals have rail-mounted gantry cranes on the wharf, a container yard served by rubber-tired gantries (RTGs), straddle carriers, top-lift or side-lift forklifts, and a container freight station for stuffing and unstuffing containers." ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_2 .

c:IDT_11_4_2_2_3 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.3 Deep Draft Dry Bulk Cargo Terminal" ;
  rdfs:comment "Terminals designed to load or unload flowable dry commodities. These facilities may have ship loaders or unloaders on the wharf, or may utilize mobile cranes. Storage may be in structures (e.g., silos, sheds) or open (e.g., on pads, in bins)." ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_2 .

c:IDT_11_4_2_2_4 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.4 Deep Draft Liquid Bulk Cargo Terminal - Crude/Product" ;
  rdfs:comment "Terminals designed to load or unload liquid commodities. These facilities have pipelines and manifolds at the waterside. They may or may not have wharves. Those without wharves have cells or \"dolphins\" for tying up vessels. These terminals may have tank storage on site or may feed pipelines directly from the vessel." ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_2 .

c:IDT_11_4_2_2_5 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.5 Deep Draft Liquid Bulk Cargo Terminal - Chemical" ;
  rdfs:comment "Terminals designed to load or unload liquid chemical commodities. These facilities have pipelines and manifolds at the waterside. They may or may not have wharves. Those without wharves have cells or \"dolphins\" for tying up vessels. These terminals may have tank storage on site or may feed pipelines directly from the vessel." ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_2 .

c:IDT_11_4_2_2_6 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.6 Deep Draft Bulk Gas Cargo Terminal" ;
  rdfs:comment "Terminals designed to load or unload gas commodities. These facilities have pipelines and manifolds at the waterside. They may or may not have wharves. Those without wharves have cells or \"dolphins\" for tying up vessels. These terminals may have tank storage on site or may feed pipelines directly from the vessel." ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_2_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_2 .

c:IDT_11_4_2_2_7 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.7 Deep Draft Industrial Cargo Terminal" ;
  rdfs:comment "Terminals co-located with an industrial facility (e.g., industrial factory, refinery). Generally handle dry or liquid bulk materials that are processed at the industrial facility. " ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_2_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_2 .

c:IDT_11_4_2_2_8 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.8 Off-Shore Terminal or Platform" ;
  rdfs:comment "Terminals designed to handle bulk liquid or gas shipments in open seas. Berthing of vessels is normally done at anchoring buoys. Currently used mostly for crude oil and liquefied natural gas (LNG) cargo. Does not include oil and gas exploration or production platforms." ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_2_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_2 .

c:IDT_11_4_2_2_9 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.9 Outer Continental Shelf Crude Oil Platform" ;
  rdfs:comment "Sea-based facilities used for the extraction of crude oil. This category includes equipment such as gathering lines used to bring the output on shore. Also referred to as off-shore drilling platforms or off-shore rigs. Note: Natural gas is sometimes extracted from the same wells that are used to extract oil. This is referred to as \"associated gas.\" " ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_9-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_2_9 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_2 .

c:IDT_11_4_2_2_10 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.10 Outer Continental Shelf Natural Gas Platform" ;
  rdfs:comment "Sea-based facilities used for the extraction of natural gas. This category includes equipment such as gathering lines used to bring the output on shore. Also referred to as off-shore drilling platforms or off-shore rigs." ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_10-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_4_2_2_10 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_4_2_2 .

c:IDT_11_4_2_2_11 a owl:Class ;
  rdfs:label "IDT 11.4.2.2.11 Cruise Ship Passenger Terminal" ;
  rdfs:comment "Terminals designed to handle ocean-going cruise ships." ;
  rdfs:subClassOf c:IDT_11_4_2_2 .
c:axiom-idt-11_4_2_2_11-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
