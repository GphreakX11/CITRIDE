c:IDT_9_1_3_5 a owl:Class ;
  rdfs:label "IDT 9.1.3.5 Other United States Postal Service Mail Center" ;
  rdfs:comment "Other centralized mail processing facilities and assets not elsewhere categorized ( e.g., transportation hubs)." ;
  rdfs:subClassOf c:IDT_9_1_3 .
c:axiom-idt-9_1_3_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
