c:IDT_1_5_3 a owl:Class ;
  rdfs:label "IDT 1.5.3 Food and Beverage Store" ;
  rdfs:comment "Establishments retailing food and beverage merchandise from fixed point-of-sale locations. Generally have special equipment (e.g., freezers, refrigerated display cases, refrigerators) for displaying food and beverage goods. Staff are generally trained in the processing of food products to guarantee the proper storage and sanitary conditions required by regulatory authority." ;
  rdfs:subClassOf c:IDT_1_5 .
c:axiom-idt-1_5_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5 .

c:IDT_1_5_3_1 a owl:Class ;
  rdfs:label "IDT 1.5.3.1 Grocery Store" ;
  rdfs:comment "Establishments, generally known as supermarkets, grocery stores and convenience stores, primarily engaged in retailing a general line of food, such as canned and frozen foods, fresh fruits and vegetables, and fresh and prepared meats, fish, and poultry. Included are delicatessen-type establishments primarily engaged in retailing a general line of food." ;
  rdfs:subClassOf c:IDT_1_5_3 .
c:axiom-idt-1_5_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3 .

c:IDT_1_5_3_1_1 a owl:Class ;
  rdfs:label "IDT 1.5.3.1.1 Supermarket and Other Grocery Store (Except Convenience)" ;
  rdfs:comment "Establishments generally known as supermarkets and grocery stores, primarily engaged in retailing a general line of food, such as canned and frozen foods; fresh fruits and vegetables; and fresh and prepared meats, fish, and poultry. Included in this industry are delicatessen-type establishments primarily engaged in retailing a general line of food." ;
  rdfs:subClassOf c:IDT_1_5_3_1 .
c:axiom-idt-1_5_3_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3_1 .

c:IDT_1_5_3_1_2 a owl:Class ;
  rdfs:label "IDT 1.5.3.1.2 Convenience Store" ;
  rdfs:comment "Establishments known as convenience stores or food marts primarily engaged in retailing a limited line of goods that generally includes milk, bread, soda, and snacks. May be co-located with a motor vehicle refueling station." ;
  rdfs:subClassOf c:IDT_1_5_3_1 .
c:axiom-idt-1_5_3_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3_1 .

c:IDT_1_5_3_2 a owl:Class ;
  rdfs:label "IDT 1.5.3.2 Specialty Food Store" ;
  rdfs:comment "Establishments primarily engaged in retailing specialized lines of food. Includes meat markets, fish and seafood markets, fruit and vegetable markets, baked goods stores, and others." ;
  rdfs:subClassOf c:IDT_1_5_3 .
c:axiom-idt-1_5_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3 .

c:IDT_1_5_3_2_1 a owl:Class ;
  rdfs:label "IDT 1.5.3.2.1 Meat Market" ;
  rdfs:comment "Establishments primarily engaged in retailing fresh, frozen, or cured meats and poultry. Delicatessen-type establishments primarily engaged in retailing fresh, frozen, or cured meats and poultry. Delicatessen-type establishments primarily engaged in retailing fresh meat are included in this industry. " ;
  rdfs:subClassOf c:IDT_1_5_3_2 .
c:axiom-idt-1_5_3_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3_2 .

c:IDT_1_5_3_2_2 a owl:Class ;
  rdfs:label "IDT 1.5.3.2.2 Fish and Seafood Market" ;
  rdfs:comment "Establishments primarily engaged in retailing fresh, frozen, or cured fish and seafood products. " ;
  rdfs:subClassOf c:IDT_1_5_3_2 .
c:axiom-idt-1_5_3_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3_2 .

c:IDT_1_5_3_2_3 a owl:Class ;
  rdfs:label "IDT 1.5.3.2.3 Fruit and Vegetable Market" ;
  rdfs:comment "Establishments primarily engaged in retailing fresh fruit and vegetables." ;
  rdfs:subClassOf c:IDT_1_5_3_2 .
c:axiom-idt-1_5_3_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3_2 .

c:IDT_1_5_3_2_4 a owl:Class ;
  rdfs:label "IDT 1.5.3.2.4 Baked Goods Store" ;
  rdfs:comment "Establishments primarily engaged in retailing baked goods not for immediate consumption and not made on the premises. " ;
  rdfs:subClassOf c:IDT_1_5_3_2 .
c:axiom-idt-1_5_3_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3_2 .

c:IDT_1_5_3_2_5 a owl:Class ;
  rdfs:label "IDT 1.5.3.2.5 Confectionery and Nut Store" ;
  rdfs:comment "Establishments primarily engaged in retailing candy and other confections, nuts, and popcorn not for immediate consumption and not made on the premises. " ;
  rdfs:subClassOf c:IDT_1_5_3_2 .
c:axiom-idt-1_5_3_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3_2 .

c:IDT_1_5_3_2_6 a owl:Class ;
  rdfs:label "IDT 1.5.3.2.6 Other Specialty Food Store" ;
  rdfs:comment "Establishments primarily engaged in retailing miscellaneous specialty foods (except meat, fish, seafood, fruit and vegetables, confections, nuts, popcorn, and baked goods) not for immediate consumption and not made on the premises. " ;
  rdfs:subClassOf c:IDT_1_5_3_2 .
c:axiom-idt-1_5_3_2_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_2_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3_2 .

c:IDT_1_5_3_3 a owl:Class ;
  rdfs:label "IDT 1.5.3.3 Beer, Wine, and Liquor Store" ;
  rdfs:comment "Establishments primarily engaged in retailing packaged alcoholic beverages, such as ale, beer, wine, and liquor." ;
  rdfs:subClassOf c:IDT_1_5_3 .
c:axiom-idt-1_5_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_3 .

c:IDT_1_5_4 a owl:Class ;
  rdfs:label "IDT 1.5.4 General Merchandise Store" ;
  rdfs:comment "Facilities that retail new general merchandise from fixed point-of-sale locations. Establishments are unique in that they have the equipment and staff capable of retailing a large variety of goods from a single location. This includes a variety of display equipment and staff trained to provide information on many lines of products." ;
  rdfs:subClassOf c:IDT_1_5 .
c:axiom-idt-1_5_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5 .

c:IDT_1_5_4_1 a owl:Class ;
  rdfs:label "IDT 1.5.4.1 Department Store" ;
  rdfs:comment "Establishments that have separate departments for various merchandise lines, such as apparel, jewelry, home furnishings, and linens, each with separate cash registers and sales associates. Department stores in this industry generally do not have central customer checkout and cash register facilities. " ;
  rdfs:subClassOf c:IDT_1_5_4 .
c:axiom-idt-1_5_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_4 .

c:IDT_1_5_4_2 a owl:Class ;
  rdfs:label "IDT 1.5.4.2 Other General Merchandise Store" ;
  rdfs:comment "Establishments primarily engaged in retailing new goods in general merchandise stores (except department stores)." ;
  rdfs:subClassOf c:IDT_1_5_4 .
c:axiom-idt-1_5_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_4 .

c:IDT_1_5_4_2_1 a owl:Class ;
  rdfs:label "IDT 1.5.4.2.1 Warehouse Club and Supercenter" ;
  rdfs:comment "Establishments known as warehouse clubs, superstores, or supercenters primarily engaged in retailing a general line of groceries in combination with general lines of new merchandise, such as apparel, furniture, and appliances." ;
  rdfs:subClassOf c:IDT_1_5_4_2 .
c:axiom-idt-1_5_4_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_4_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_4_2 .

c:IDT_1_5_4_2_2 a owl:Class ;
  rdfs:label "IDT 1.5.4.2.2 All Other General Merchandise Store" ;
  rdfs:comment "Establishments primarily engaged in retailing new goods in general merchandise stores (except department stores, warehouse clubs, superstores, and supercenters). These establishments retail a general line of new merchandise, such as apparel, automotive parts, dry goods, hardware, groceries, housewares or home furnishings, and other lines in limited amounts, with none of the lines predominating." ;
  rdfs:subClassOf c:IDT_1_5_4_2 .
c:axiom-idt-1_5_4_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_4_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_4_2 .

c:IDT_1_5_5 a owl:Class ;
  rdfs:label "IDT 1.5.5 Non-Store Retailer" ;
  rdfs:comment "Establishments primarily engaged in retailing merchandise using methods, such as the broadcasting of infomercials, the broadcasting and publishing of direct-response advertising, the publishing of paper and electronic catalogs, door-to-door solicitation, in-home demonstration, selling from portable stalls and distribution through vending machines. Establishments include mail-order houses, vending machine operators, home delivery sales, door-to-door sales, party plan sales, electronic shopping, and sales through portable stalls (e.g., street vendors). Establishments engaged in the direct (i.e., non-store) sale of products are included. " ;
  rdfs:subClassOf c:IDT_1_5 .
c:axiom-idt-1_5_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5 .

c:IDT_1_5_5_1 a owl:Class ;
  rdfs:label "IDT 1.5.5.1 Electronic Shopping and Mail-Order House" ;
  rdfs:comment "Establishments primarily engaged in retailing all types of merchandise using non-store means, such as catalogs, toll-free telephone numbers, or electronic media, such as interactive television or computer. Included in this industry are establishments primarily engaged in retailing from catalog showrooms or mail-order houses. " ;
  rdfs:subClassOf c:IDT_1_5_5 .
c:axiom-idt-1_5_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_5 .

c:IDT_1_5_5_2 a owl:Class ;
  rdfs:label "IDT 1.5.5.2 Vending Machine Operator" ;
  rdfs:comment "Establishments primarily engaged in retailing merchandise through vending machines that they service." ;
  rdfs:subClassOf c:IDT_1_5_5 .
c:axiom-idt-1_5_5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_5_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_5 .

c:IDT_1_5_5_3 a owl:Class ;
  rdfs:label "IDT 1.5.5.3 Direct Selling Establishment" ;
  rdfs:comment "Establishments primarily engaged in non-store retailing (except electronic, mail-order, or vending machine sales). These establishments typically go to the customer's location rather than the customer coming to them (e.g., door-to-door sales, home parties). Examples of establishments in this industry are locker meat provisioners; frozen food and freezer plan providers; coffee-break services providers; and bottled water or water softener services." ;
  rdfs:subClassOf c:IDT_1_5_5 .
c:axiom-idt-1_5_5_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_5_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_5 .

c:IDT_1_5_6 a owl:Class ;
  rdfs:label "IDT 1.5.6 Food Services and Drinking Place" ;
  rdfs:comment "Establishments primarily engaged in the preparation of meals, snacks, and beverages to customer order for immediate on-premise and off-premise consumption. Some provide food and drink only; while others may provide seating, waiter/waitress service, and incidental amenities, such as limited entertainment. Food and beverage services at hotels and motels; amusement parks, theaters, casinos, country clubs, and similar recreational facilities. Civic and social organizations are included only if these services are provided by a separate establishment primarily engaged in providing food and beverage services. Excluded are establishments operating dinner cruises and scenic and sightseeing transportation." ;
  rdfs:subClassOf c:IDT_1_5 .
c:axiom-idt-1_5_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5 .

c:IDT_1_5_6_1 a owl:Class ;
  rdfs:label "IDT 1.5.6.1 Full Service Restaurant" ;
  rdfs:comment "Establishments primarily engaged in providing food services to patrons who order and are served while seated (e.g., waiter/waitress service) and pay after eating. May also provide other services, such as takeout services. May be stand-alone facilities or may be attached to another facility (e.g., hotel)." ;
  rdfs:subClassOf c:IDT_1_5_6 .
c:axiom-idt-1_5_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6 .

c:IDT_1_5_6_2 a owl:Class ;
  rdfs:label "IDT 1.5.6.2 Limited-Service Eating Place" ;
  rdfs:comment "Establishments primarily engaged in providing food services where patrons generally order or select items and pay before eating. Most establishments do not have waiter/waitress service. Includes carry out restaurants, delicatessen restaurants, fast food restaurants, pizzerias, sandwich shops, cafeterias, snack bars, ice cream stands, doughnut shops, mobile food service vehicles, and similar facilities." ;
  rdfs:subClassOf c:IDT_1_5_6 .
c:axiom-idt-1_5_6_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6 .

c:IDT_1_5_6_2_1 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.1 Limited-Service Restaurant" ;
  rdfs:comment "Establishments primarily engaged in providing food services (except snack and non-alcoholic beverage bars) where patrons generally order or select items and pay before eating. Food and drink may be consumed on premises, taken out, or delivered to the customers' location. Some establishments in this industry may provide these food services in combination with the selling of alcoholic beverages. " ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_2_2 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.2 Cafeteria" ;
  rdfs:comment "Establishments, known as cafeterias, buffets, or grill buffets, primarily engaged in preparing and serving meals for immediate consumption using cafeteria-style or buffet serving equipment, such as steam tables, refrigerated areas, display grills, and self-service non-alcoholic beverage dispensing equipment. Patrons select from food and drink items on display in a continuous cafeteria line or from buffet stations. " ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_2_3 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.3 Animal Exhibition - Fair" ;
  rdfs:comment "Establishments primarily engaged in providing food services at an animal exhibition - fair." ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_2_4 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.4 Commissary Operations" ;
  rdfs:comment "Establishments primarily engaged in providing food services at a commissary." ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_2_5 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.5 Fast Food" ;
  rdfs:comment "Establishments primarily engaged in providing fast food services." ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_2_6 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.6 Food Exhibition - Fair" ;
  rdfs:comment "Establishments primarily engaged in providing food services at a food exhibition - fair." ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_2_7 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.7 Hospital Kitchen" ;
  rdfs:comment "Establishments primarily engaged in providing food services at a hospital kitchen." ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_2_8 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.8 Independent Food Service" ;
  rdfs:comment "Establishments primarily engaged in providing independent food services." ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_2_9 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.9 Institutional" ;
  rdfs:comment "Establishments primarily engaged in providing institutional food services." ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_9-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_9 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_2_10 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.10 School Kitchen" ;
  rdfs:comment "Establishments primarily engaged in providing school kitchen food services." ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_10-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_10 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_2_11 a owl:Class ;
  rdfs:label "IDT 1.5.6.2.11 Snack and Non-Alcoholic Beverage Bar" ;
  rdfs:comment "Establishments primarily engaged in (1) preparing and/or serving a specialty snack, such as ice cream, frozen yogurt, cookies, or popcorn or (2) serving non-alcoholic beverages, such as coffee, juices, or sodas for consumption on or near the premises. These establishments may carry and sell a combination of snack, non-alcoholic beverage, and other related products (e.g., coffee beans, mugs, coffee makers) but generally promote and sell a unique snack or non-alcoholic beverage. " ;
  rdfs:subClassOf c:IDT_1_5_6_2 .
c:axiom-idt-1_5_6_2_11-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_2_11 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_2 .

c:IDT_1_5_6_3 a owl:Class ;
  rdfs:label "IDT 1.5.6.3 Special Food Services" ;
  rdfs:comment "Establishments primarily engaged in providing food services at one or more of the following locations: (1) the customers' location; (2) a location designated by the customer; or (3) from motorized vehicles or non-motorized carts." ;
  rdfs:subClassOf c:IDT_1_5_6 .
c:axiom-idt-1_5_6_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6 .

c:IDT_1_5_6_3_1 a owl:Class ;
  rdfs:label "IDT 1.5.6.3.1 Food Service Contractor" ;
  rdfs:comment "Establishments primarily engaged in providing food services at institutional, governmental, commercial, or industrial locations based on contractual arrangements with these types of organizations for a specified period of time. The establishments of this industry provide food services for the convenience of the contracting organization or the contracting organizations' customers. The contractual arrangement of these establishments may vary based on the type of facility operated (e.g., cafeteria, restaurant, fast-food eating place), revenue sharing structure, cost structure, and the staffing. Management staff is always provided by the food service contractor." ;
  rdfs:subClassOf c:IDT_1_5_6_3 .
c:axiom-idt-1_5_6_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_3 .

c:IDT_1_5_6_3_2 a owl:Class ;
  rdfs:label "IDT 1.5.6.3.2 Caterer" ;
  rdfs:comment "Establishments primarily engaged in providing single event-based food services. These establishments generally have equipment and vehicles to transport meals and snacks to events and/or prepare food at an off-premise site. Banquet halls with catering staff are included in this industry. Examples of events catered by establishments in this industry are graduation parties, wedding receptions, business or retirement luncheons, and trade shows. " ;
  rdfs:subClassOf c:IDT_1_5_6_3 .
c:axiom-idt-1_5_6_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_3 .

c:IDT_1_5_6_3_3 a owl:Class ;
  rdfs:label "IDT 1.5.6.3.3 Mobile Food Service" ;
  rdfs:comment "Establishments primarily engaged in preparing and serving meals and snacks for immediate consumption from motorized vehicles or non-motorized carts. The establishment is the central location from which the caterer route is serviced, not each vehicle or cart. Included in this industry are establishments primarily engaged in providing food services from vehicles, such as hot dog carts and ice cream trucks. " ;
  rdfs:subClassOf c:IDT_1_5_6_3 .
c:axiom-idt-1_5_6_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6_3 .

c:IDT_1_5_6_4 a owl:Class ;
  rdfs:label "IDT 1.5.6.4 Drinking Place (Alcoholic Beverages)" ;
  rdfs:comment "Facilities serving alcoholic beverages and with regular live entertainment and/or dancing." ;
  rdfs:subClassOf c:IDT_1_5_6 .
c:axiom-idt-1_5_6_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_5_6_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_5_6 .

c:IDT_1_6 a owl:Class ;
  rdfs:label "IDT 1.6 Agriculture and Food Supporting Facility" ;
  rdfs:comment "Facilities providing supporting services to agriculture and food establishments." ;
  rdfs:subClassOf c:IDT_1 .
c:axiom-idt-1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1 .

c:IDT_1_6_1 a owl:Class ;
  rdfs:label "IDT 1.6.1 Agricultural Chemical Manufacturing" ;
  rdfs:comment "Establishments primarily engaged in manufacturing chemicals for agricultural activities; includes fertilizers, pesticides, and other chemicals." ;
  rdfs:subClassOf c:IDT_1_6 .
c:axiom-idt-1_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_6_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_6 .

c:IDT_1_6_1_1 a owl:Class ;
  rdfs:label "IDT 1.6.1.1 Fertilizer" ;
  rdfs:comment "Establishments primarily engaged in one or more of the following: (1) manufacturing nitrogenous or phosphatic fertilizer materials; (2) manufacturing fertilizers from sewage or animal waste; (3) manufacturing nitrogenous or phosphatic materials and mixing with other ingredients into fertilizers; and (4) mixing ingredients made elsewhere into fertilizers." ;
  rdfs:subClassOf c:IDT_1_6_1 .
c:axiom-idt-1_6_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_6_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_6_1 .

c:IDT_1_6_1_1_1 a owl:Class ;
  rdfs:label "IDT 1.6.1.1.1 Organic" ;
  rdfs:comment "Establishments primarily engaged in manufacturing organic fertilizers." ;
  rdfs:subClassOf c:IDT_1_6_1_1 .
c:axiom-idt-1_6_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_6_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_6_1_1 .

c:IDT_1_6_1_1_2 a owl:Class ;
  rdfs:label "IDT 1.6.1.1.2 Inert Chemical" ;
  rdfs:comment "Establishments primarily engaged in manufacturing inert chemical fertilizers." ;
  rdfs:subClassOf c:IDT_1_6_1_1 .
c:axiom-idt-1_6_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_6_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_6_1_1 .

c:IDT_1_6_1_2 a owl:Class ;
  rdfs:label "IDT 1.6.1.2 Pesticide" ;
  rdfs:comment "Establishments primarily engaged in the formulation and preparation of agricultural and household pest control chemicals (except fertilizers)." ;
  rdfs:subClassOf c:IDT_1_6_1 .
c:axiom-idt-1_6_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_6_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_6_1 .

c:IDT_1_6_1_2_1 a owl:Class ;
  rdfs:label "IDT 1.6.1.2.1 Poultry" ;
  rdfs:comment "Establishments primarily engaged in manufacturing pesticides for use in poultry." ;
  rdfs:subClassOf c:IDT_1_6_1_2 .
c:axiom-idt-1_6_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_6_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_6_1_2 .

c:IDT_1_6_1_2_2 a owl:Class ;
  rdfs:label "IDT 1.6.1.2.2 Livestock" ;
  rdfs:comment "Establishments primarily engaged in manufacturing pesticides for use in livestock." ;
  rdfs:subClassOf c:IDT_1_6_1_2 .
c:axiom-idt-1_6_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_6_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_6_1_2 .

c:IDT_1_6_2 a owl:Class ;
