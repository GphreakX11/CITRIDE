c:IDT_1_2_3_1_1 a owl:Class ;
  rdfs:label "IDT 1.2.3.1.1 Sugarcane Mill" ;
  rdfs:comment "Facilities primarily engaged in processing sugarcane. " ;
  rdfs:subClassOf c:IDT_1_2_3_1 .
c:axiom-idt-1_2_3_1_1-parent a owl:Axiom ;
