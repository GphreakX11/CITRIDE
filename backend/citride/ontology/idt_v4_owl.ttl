  rdfs:label "IDT 5.2.6.1.1 Petroleum Product Pipeline Segment" ;
  rdfs:comment "Lengths of pipeline, interconnections, valves. Includes above ground, underground, river crossings, and other segments." ;
  rdfs:subClassOf c:IDT_5_2_6_1 .
