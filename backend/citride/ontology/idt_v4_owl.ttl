  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1 .

c:IDT_8_1_8 a owl:Class ;
  rdfs:label "IDT 8.1.8 Cable" ;
  rdfs:comment "Two or more wires running side by side and bonded, twisted or braided together to form a single assembly." ;
  rdfs:subClassOf c:IDT_8_1 .
c:axiom-idt-8_1_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1 .

c:IDT_8_1_8_1 a owl:Class ;
  rdfs:label "IDT 8.1.8.1 Business/Operations Office" ;
  rdfs:comment "Central offices where day-to-day business/operations are conducted." ;
  rdfs:subClassOf c:IDT_8_1_8 .
c:axiom-idt-8_1_8_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_8_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_8 .

c:IDT_8_1_8_2 a owl:Class ;
  rdfs:label "IDT 8.1.8.2 Headend" ;
  rdfs:comment "Control centers of a cable-television system, where incoming signals are amplified, converted, processed, and combined into a common cable for transmission to subscribers." ;
  rdfs:subClassOf c:IDT_8_1_8 .
c:axiom-idt-8_1_8_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_8_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_8 .

c:IDT_8_1_8_3 a owl:Class ;
  rdfs:label "IDT 8.1.8.3 Distribution Hub" ;
  rdfs:comment "Location serving as a central point for distribution of communication services. The hub facility will distribute most types of communications services (e.g., voice, data, video, telemetry) to the outlying buildings served from the hub location." ;
  rdfs:subClassOf c:IDT_8_1_8 .
c:axiom-idt-8_1_8_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_8_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_8 .

c:IDT_8_1_8_4 a owl:Class ;
  rdfs:label "IDT 8.1.8.4 Fiber Node" ;
  rdfs:comment "Optical fiber to a junction box (node). Fiber is terminated in a street cabinet up to several kilometers away from the customer premises, with the final connection being copper." ;
  rdfs:subClassOf c:IDT_8_1_8 .
c:axiom-idt-8_1_8_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_1_8_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_1_8 .

c:IDT_8_2 a owl:Class ;
  rdfs:label "IDT 8.2 Wireless Communication" ;
  rdfs:comment "Establishments primarily engaged in operating, maintaining or providing access to facilities for the transmission of voice, data, text, sound, and video using wireless communications networks. Transmission facilities may be based on a single technology or a combination of technologies. Note: Does not include satellite communications systems, which are described in sub-sector 8.3." ;
  rdfs:subClassOf c:IDT_8 .
c:axiom-idt-8_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8 .

c:IDT_8_2_1 a owl:Class ;
  rdfs:label "IDT 8.2.1 Cellular Telephone Facility" ;
  rdfs:comment "Establishments engaged in operating cellular communications. These facilities generally provide two-way communication capability." ;
  rdfs:subClassOf c:IDT_8_2 .
c:axiom-idt-8_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2 .

c:IDT_8_2_1_1 a owl:Class ;
  rdfs:label "IDT 8.2.1.1 Cell Phone Tower" ;
  rdfs:comment "Towers, receivers, and transmitters that handle cell phone traffic within a relatively small area or cell. Also referred to as cell base stations." ;
  rdfs:subClassOf c:IDT_8_2_1 .
c:axiom-idt-8_2_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_1 .

c:IDT_8_2_1_2 a owl:Class ;
  rdfs:label "IDT 8.2.1.2 Cell Phone Switching Center" ;
  rdfs:comment "A facility that controls the operation of all the cell phone towers in an area and connects the wireless telecommunication system to the wired telecommunication network. Also referred to as mobile telephone switching offices. " ;
  rdfs:subClassOf c:IDT_8_2_1 .
c:axiom-idt-8_2_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_1 .

c:IDT_8_2_1_3 a owl:Class ;
  rdfs:label "IDT 8.2.1.3 Cellular Phone Network Operations Center" ;
  rdfs:comment "Central facilities from which large portions of a cell phone network, perhaps nationwide, are monitored and managed. In general, each wireless communications company has its own network operations center. Larger companies may have more than one center, including backup facilities." ;
  rdfs:subClassOf c:IDT_8_2_1 .
c:axiom-idt-8_2_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_1 .

c:IDT_8_2_1_4 a owl:Class ;
  rdfs:label "IDT 8.2.1.4 Mobile Switching Office" ;
  rdfs:comment "Primary service delivery node for Global System for Mobile Communication / Code Division Multiple Access (GSM/CDMA), responsible for routing voice calls and Short Message Service (SMS) as well as other services (such as conference calls, FAX and circuit switched data)." ;
  rdfs:subClassOf c:IDT_8_2_1 .
c:axiom-idt-8_2_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_1 .

c:IDT_8_2_2 a owl:Class ;
  rdfs:label "IDT 8.2.2 Pager Facility" ;
  rdfs:comment "Establishments engaged in operating pager communications. These facilities generally provide one-way text message communication capability although some provide two-way message capability. Note: Some cellular telephone companies provide paging services." ;
  rdfs:subClassOf c:IDT_8_2 .
c:axiom-idt-8_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2 .

c:IDT_8_2_2_1 a owl:Class ;
  rdfs:label "IDT 8.2.2.1 Pager Tower" ;
  rdfs:comment "Towers, receivers, and transmitters that handle pager traffic.  " ;
  rdfs:subClassOf c:IDT_8_2_2 .
c:axiom-idt-8_2_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_2 .

c:IDT_8_2_2_2 a owl:Class ;
  rdfs:label "IDT 8.2.2.2 Pager Operations Center" ;
  rdfs:comment "Facilities that accept messages to be sent and direct them to pager towers for transmittal.  " ;
  rdfs:subClassOf c:IDT_8_2_2 .
c:axiom-idt-8_2_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_2 .

c:IDT_8_2_3 a owl:Class ;
  rdfs:label "IDT 8.2.3 Wireless Telecommunication Service Provider Facility" ;
  rdfs:comment "Administrative facilities of companies that own and operate wireless communications networks.  " ;
  rdfs:subClassOf c:IDT_8_2 .
c:axiom-idt-8_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2 .

c:IDT_8_2_4 a owl:Class ;
  rdfs:label "IDT 8.2.4 Operations Management" ;
  rdfs:comment "Facilities and assets where operational activities and procedures take place that address critical infrastructure  coordination efforts of operational activities toward improving the physical and cyber security protection of Communications Sector assets. Includes capabilities to ease the flow of information within the sector, across sectors, and with designated federal agencies; also includes addressing issues related to response and recovery under all hazards to assure the continued operation of vital communications services." ;
  rdfs:subClassOf c:IDT_8_2 .
c:axiom-idt-8_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2 .

c:IDT_8_2_4_1 a owl:Class ;
  rdfs:label "IDT 8.2.4.1 Network Operations Center" ;
  rdfs:comment "Central facilities from which large portions of the telephone network are monitored and managed. In general, each communications company has its own network operations center. Larger companies may have more than one center, including backup facilities.  " ;
  rdfs:subClassOf c:IDT_8_2_4 .
c:axiom-idt-8_2_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_4 .

c:IDT_8_2_4_2 a owl:Class ;
  rdfs:label "IDT 8.2.4.2 Call Center / Customer Service Center" ;
  rdfs:comment "Central locations where telephone agents, or operators, make outgoing calls or field inbound calls for a company or organization." ;
  rdfs:subClassOf c:IDT_8_2_4 .
c:axiom-idt-8_2_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_4 .

c:IDT_8_2_4_3 a owl:Class ;
  rdfs:label "IDT 8.2.4.3 Billing Center" ;
  rdfs:comment "Central location that collects invoice information from clients and generates bills on their behalf." ;
  rdfs:subClassOf c:IDT_8_2_4 .
c:axiom-idt-8_2_4_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_4_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_4 .

c:IDT_8_2_4_4 a owl:Class ;
  rdfs:label "IDT 8.2.4.4 Emergency Operations Center" ;
  rdfs:comment "Central command and control facilities responsible for carrying out the principles of emergency preparedness and emergency management, or disaster management functions at a strategic level in an emergency situation, and ensuring the continuity of operation of a organization or company." ;
  rdfs:subClassOf c:IDT_8_2_4 .
c:axiom-idt-8_2_4_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_4_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_4 .

c:IDT_8_2_4_5 a owl:Class ;
  rdfs:label "IDT 8.2.4.5 Data Center" ;
  rdfs:comment "Facilities that house the computer systems and related equipment, including the data library. Data entry and systems programming may also come under its jurisdiction. A control section is usually provided that accepts work from and releases output to user departments." ;
  rdfs:subClassOf c:IDT_8_2_4 .
c:axiom-idt-8_2_4_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_2_4_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_2_4 .

c:IDT_8_3 a owl:Class ;
  rdfs:label "IDT 8.3 Satellite Communication" ;
  rdfs:comment "Establishments primarily engaged in providing point-to-point communications services to other establishments in the communications and broadcasting industries by forwarding and receiving communications signals via a system of satellites or reselling satellite communications. Communications conveyed by satellite include voice, data, video, television, radio, text, sound, and other material." ;
  rdfs:subClassOf c:IDT_8 .
c:axiom-idt-8_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8 .

c:IDT_8_3_1 a owl:Class ;
  rdfs:label "IDT 8.3.1 Satellite Communications Ground Station" ;
  rdfs:comment "Facilities that transmit and receive signals from satellites and process communication traffic.  These stations can also provide the connections to other communication networks (e.g., telephone, broadcast television).  " ;
  rdfs:subClassOf c:IDT_8_3 .
c:axiom-idt-8_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3 .

c:IDT_8_3_2 a owl:Class ;
  rdfs:label "IDT 8.3.2 Operations Management" ;
  rdfs:comment "Central facilities from which multiple ground stations are monitored and managed.  " ;
  rdfs:subClassOf c:IDT_8_3 .
c:axiom-idt-8_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3 .

c:IDT_8_3_2_1 a owl:Class ;
  rdfs:label "IDT 8.3.2.1 Network Operations Center" ;
  rdfs:comment "Locations that monitor the operation of a network and usually provide efforts to solve connectivity and network problems. The network operations center (NOC) provides management of the terrestrial infrastructure by looking at configuration management and lock-down status/network systems monitoring. Network systems monitoring control sit in the NOC on the terrestrial side and monitor traffic to and from the terrestrial NOC." ;
  rdfs:subClassOf c:IDT_8_3_2 .
c:axiom-idt-8_3_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3_2 .

c:IDT_8_3_2_2 a owl:Class ;
  rdfs:label "IDT 8.3.2.2 Satellite Operations Center" ;
  rdfs:comment "One or more facilities that supports space segment operations by providing pre-launch planning, launch and early orbit support, and satellite control functions. Satellite operation center (SOC) personnel perform satellite command and control during launch, on-orbit test, and deployment, and assist in major anomaly resolution." ;
  rdfs:subClassOf c:IDT_8_3_2 .
c:axiom-idt-8_3_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3_2 .

c:IDT_8_3_2_3 a owl:Class ;
  rdfs:label "IDT 8.3.2.3 Call Center" ;
  rdfs:comment "\nFacilities that operate 24/7 to ensure available and reliable terrestrial network services to customers and enterprises." ;
  rdfs:subClassOf c:IDT_8_3_2 .
c:axiom-idt-8_3_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3_2 .

c:IDT_8_3_2_4 a owl:Class ;
  rdfs:label "IDT 8.3.2.4 Billing Center" ;
  rdfs:comment "Central locations that collect invoice information from their clients and generate bills on their behalf." ;
  rdfs:subClassOf c:IDT_8_3_2 .
c:axiom-idt-8_3_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3_2 .

c:IDT_8_3_2_5 a owl:Class ;
  rdfs:label "IDT 8.3.2.5 Emergency Operations Center" ;
  rdfs:comment "Centralized locations where satellite operators implement protocols to aide in terrestrial critical infrastructure restoration efforts in the event of an emergency or crisis operation." ;
  rdfs:subClassOf c:IDT_8_3_2 .
c:axiom-idt-8_3_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3_2 .

c:IDT_8_3_2_6 a owl:Class ;
  rdfs:label "IDT 8.3.2.6 Data Center" ;
  rdfs:comment "Satellite information repositories where precise orbit data and maneuver plans from the operator’s fleets are stored." ;
  rdfs:subClassOf c:IDT_8_3_2 .
c:axiom-idt-8_3_2_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_2_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3_2 .

c:IDT_8_3_3 a owl:Class ;
  rdfs:label "IDT 8.3.3 Satellite Control Station" ;
  rdfs:comment "Facilities that provide monitoring and control of satellite orbits, orientation, performance, and related parameters. May be co-located with network operations centers." ;
  rdfs:subClassOf c:IDT_8_3 .
c:axiom-idt-8_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3 .

c:IDT_8_3_4 a owl:Class ;
  rdfs:label "IDT 8.3.4 Satellite Telecommunication Ground Link" ;
  rdfs:comment "Ground communication links in the satellite communications network that connect ground stations, network operations centers, satellite control stations and administration offices. These links also connect ground stations to end user facilities. Includes copper wire, fiber optic, microwave and other technologies." ;
  rdfs:subClassOf c:IDT_8_3 .
c:axiom-idt-8_3_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3 .

c:IDT_8_3_5 a owl:Class ;
  rdfs:label "IDT 8.3.5 Communication Satellite" ;
  rdfs:comment "The network of low earth orbit and geostationary orbit communication satellites." ;
  rdfs:subClassOf c:IDT_8_3 .
c:axiom-idt-8_3_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3 .

c:IDT_8_3_6 a owl:Class ;
  rdfs:label "IDT 8.3.6 Satellite Telecommunication Service Provider Facility" ;
  rdfs:comment "Administrative facilities of companies that own and operate satellite communications networks.  " ;
  rdfs:subClassOf c:IDT_8_3 .
c:axiom-idt-8_3_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3 .

c:IDT_8_3_7 a owl:Class ;
  rdfs:label "IDT 8.3.7 User Terminal" ;
  rdfs:comment "Satellite user terminals establish command and control streams with various satellite constellations." ;
  rdfs:subClassOf c:IDT_8_3 .
c:axiom-idt-8_3_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3 .

c:IDT_8_3_7_1 a owl:Class ;
  rdfs:label "IDT 8.3.7.1 Broadband Global Area Network" ;
  rdfs:comment "Global satellite internet network with telephony using portable terminals. The terminals are normally used to connect a laptop computer to broadband Internet in remote locations; however, as long as line-of-sight to the satellite exists, the terminal can be used anywhere. The value of broadband global area network (BGAN) terminals is that unlike other satellite Internet services which require bulky and heavy satellite dishes to connect, a BGAN terminal is about the size of a laptop and can be carried easily. The network is provided by Inmarsat and uses three geostationary satellites called I-4 to provide almost global coverage." ;
  rdfs:subClassOf c:IDT_8_3_7 .
c:axiom-idt-8_3_7_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_7_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_3_7 .

c:IDT_8_3_7_2 a owl:Class ;
  rdfs:label "IDT 8.3.7.2 Very Small Aperture Terminal" ;
  rdfs:comment "Satellite communications system that serves home and business users. A Very Small Aperture Terminal (VSAT) end user needs a box that interfaces between the user's computer and an outside antenna with a transceiver. The transceiver receives or sends a signal to a satellite transponder in the sky. The satellite sends and receives signals from an earth station computer that acts as a hub for the system. Each end user is interconnected with the hub station via the satellite in a star topology. For one end user to communicate with another, each transmission has to first go to the hub station which retransmits it via the satellite to the other end user's VSAT. VSAT handles data, voice, and video signals." ;
  rdfs:subClassOf c:IDT_8_3_7 .
c:axiom-idt-8_3_7_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_3_7_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
