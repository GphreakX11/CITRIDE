  owl:annotatedTarget c:IDT_17_2_2 .

c:IDT_17_2_3 a owl:Class ;
  rdfs:label "IDT 17.2.3 Radioactive Material User" ;
  rdfs:comment "Facilities that have radioactive materials on site. Includes those facilities requiring certification and licensing and which are regulated by the Nuclear Regulatory Commission (NRC) or by Agreement States as per Section 274 of the Atomic Energy Act of 1954." ;
  rdfs:subClassOf c:IDT_17_2 .
c:axiom-idt-17_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_17_2 .

c:IDT_17_2_3_1 a owl:Class ;
  rdfs:label "IDT 17.2.3.1 Medical Facility with Radioactive Materials" ;
  rdfs:comment "Medical facilities that have radioactive materials on site in sufficient quantities to require licensing by the Nuclear Regulatory Commission (NRC) or by Agreement States as per Section 274 of the Atomic Energy Act of 1954. " ;
  rdfs:subClassOf c:IDT_17_2_3 .
c:axiom-idt-17_2_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17_2_3_1 ;
