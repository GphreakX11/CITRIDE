  rdfs:label "IDT 6.4.1 Emergency Management Administrative Office/Headquarters" ;
  rdfs:comment "Central offices where emergency management planning and administrative activities in a jurisdiction are carried out." ;
  rdfs:subClassOf c:IDT_6_4 .
