  rdfs:label "IDT 11.6.1.2 Crude Oil Pipeline Pumping Station" ;
  rdfs:comment "Stations along the length of a pipeline. Includes pumps, valves, control machinery, and breakout storage." ;
  rdfs:subClassOf c:IDT_11_6_1 .
c:axiom-idt-11_6_1_2-parent a owl:Axiom ;
