  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10_1_1_1 .

c:IDT_10_1_1_1_2 a owl:Class ;
  rdfs:label "IDT 10.1.1.1.2 Federal General Medical and Surgical Hospital" ;
  rdfs:comment "Hospitals operated by government organizations (e.g., veterans hospital). " ;
  rdfs:subClassOf c:IDT_10_1_1_1 .
c:axiom-idt-10_1_1_1_2-parent a owl:Axiom ;
