  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_2_3_5 .

c:IDT_2_3_5_3 a owl:Class ;
  rdfs:label "IDT 2.3.5.3 Insurance Industry Organization" ;
  rdfs:comment "Industry organizations that provide industry-wide support.  " ;
  rdfs:subClassOf c:IDT_2_3_5 .
