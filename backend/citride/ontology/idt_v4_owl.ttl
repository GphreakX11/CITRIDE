c:IDT_1_5_2 a owl:Class ;
  rdfs:label "IDT 1.5.2 Grocery and Related Product Wholesaler" ;
  rdfs:comment "Establishments primarily engaged in the merchant wholesale distribution of a general line (wide range) of groceries. Includes general line groceries, packaged frozen foods, dairy products, poultry products, confectionaries, fish and seafood products, meat and meat products, fresh fruits and vegetables, and others." ;
  rdfs:subClassOf c:IDT_1_5 .
