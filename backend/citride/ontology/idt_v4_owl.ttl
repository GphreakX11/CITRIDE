c:IDT_5_2_6_1_2 a owl:Class ;
  rdfs:label "IDT 5.2.6.1.2 Petroleum Product Pipeline Pumping Station" ;
  rdfs:comment "Stations along the length of a pipeline. Includes pumps, valves, control machinery, and breakout storage.  " ;
  rdfs:subClassOf c:IDT_5_2_6_1 .
