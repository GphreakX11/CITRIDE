c:IDT_3 a owl:Class ;
  rdfs:label "IDT 3 Chemical and Hazardous Materials Industry" ;
  rdfs:comment "The Chemical Sector consists of facilities that transform natural, raw materials obtained from the earth, sea and air into products that are used every day, to include the transportation of these chemicals to intermediate or end users." ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_3_1 a owl:Class ;
  rdfs:label "IDT 3.1 Chemical Manufacturing or Processing Plant" ;
  rdfs:comment "Assets that manufacture or process chemicals by transforming natural raw materials from the earth, sea and air into products that are used daily." ;
  rdfs:subClassOf c:IDT_3 .
c:axiom-idt-3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3 .

c:IDT_3_1_1 a owl:Class ;
  rdfs:label "IDT 3.1.1 Basic Chemical Production" ;
  rdfs:comment "Assets involved in chemical production of large volumes resulting in chemical composition specifications that are homogeneous in nature. There is no product differentiation. " ;
  rdfs:subClassOf c:IDT_3_1 .
c:axiom-idt-3_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1 .

c:IDT_3_1_1_1 a owl:Class ;
  rdfs:label "IDT 3.1.1.1 Inorganic Chemical Production" ;
  rdfs:comment "Assets involved in the production of chemicals generally derived from metal and non-metallics (including salt). Inorganic chemicals do not generally contain carbon as a principal element." ;
  rdfs:subClassOf c:IDT_3_1_1 .
c:axiom-idt-3_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1 .

c:IDT_3_1_1_1_1 a owl:Class ;
  rdfs:label "IDT 3.1.1.1.1 Alkali and Chlorine" ;
  rdfs:comment "Assets involved in the production of chemicals generally derived from alkali, a basic, ionic salt of an alkali metal or alkaline earth metal element, or chlorine. (Alkali is a basic, ionic salt of an alkali metal or alkaline earth metal element, also defined as a base that dissolves in water. A solution of a soluble base that has a pH greater than 7. Chlorine is an element, halogen, commonly found as an ion in salt.)" ;
  rdfs:subClassOf c:IDT_3_1_1_1 .
c:axiom-idt-3_1_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1_1 .

c:IDT_3_1_1_1_2 a owl:Class ;
  rdfs:label "IDT 3.1.1.1.2 Industrial Gas" ;
  rdfs:comment "Assets involved in the production of chemicals generally derived from industrial gases, which are a group of gases that are commercially manufactured and sold for uses in other applications.  These gases are mainly used in industrial processes. They may be both organic and inorganic, are produced by extraction from the air by a process of separation or are produced by chemical synthesis, and will take various forms such as compressed, liquid, or solid." ;
  rdfs:subClassOf c:IDT_3_1_1_1 .
c:axiom-idt-3_1_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1_1 .

c:IDT_3_1_1_1_3 a owl:Class ;
  rdfs:label "IDT 3.1.1.1.3 Inorganic Pigment" ;
  rdfs:comment "Assets involved in the production of chemicals generally derived from an inorganic pigment (a material that changes the color of reflected or transmitted light as the result of wavelength-selective absorption)." ;
  rdfs:subClassOf c:IDT_3_1_1_1 .
c:axiom-idt-3_1_1_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1_1 .

c:IDT_3_1_1_1_4 a owl:Class ;
  rdfs:label "IDT 3.1.1.1.4 Acid" ;
  rdfs:comment "Assets involved in the production of chemicals generally derived from acids (a substance that tastes sour, reacts with metals and carbonates, turns blue litmus paper red, and has a pH less than 7.0 in its standard state)." ;
  rdfs:subClassOf c:IDT_3_1_1_1 .
c:axiom-idt-3_1_1_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1_1 .

c:IDT_3_1_1_1_5 a owl:Class ;
  rdfs:label "IDT 3.1.1.1.5 Other Inorganic Material" ;
  rdfs:comment "Inorganic chemical production facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_3_1_1_1 .
c:axiom-idt-3_1_1_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1_1 .

c:IDT_3_1_1_2 a owl:Class ;
  rdfs:label "IDT 3.1.1.2 Petrochemical and Derivative" ;
  rdfs:comment "Assets involved in the production of chemicals generally derived from organic chemicals and other chemical products derived from bulk petrochemicals, organic intermediates and other sources of carbon molecules. In many cases, these chemicals are compounded with inorganic chemicals and other materials. These products in turn are used in downstream derivatives. " ;
  rdfs:subClassOf c:IDT_3_1_1 .
c:axiom-idt-3_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1 .

c:IDT_3_1_1_2_1 a owl:Class ;
  rdfs:label "IDT 3.1.1.2.1 Organic Chemical" ;
  rdfs:comment "Assets involved in the production of chemicals generally derived from an organic compound whose molecules contain carbon." ;
  rdfs:subClassOf c:IDT_3_1_1_2 .
c:axiom-idt-3_1_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1_2 .

c:IDT_3_1_1_2_2 a owl:Class ;
  rdfs:label "IDT 3.1.1.2.2 Synthetic Material" ;
  rdfs:comment "Assets involved in the production of chemicals generally derived from material not made from natural (animal, plant) materials." ;
  rdfs:subClassOf c:IDT_3_1_1_2 .
c:axiom-idt-3_1_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1_2 .

c:IDT_3_1_1_2_3 a owl:Class ;
  rdfs:label "IDT 3.1.1.2.3 Other Organic Material" ;
  rdfs:comment "Petrochemical and derivative facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_3_1_1_2 .
c:axiom-idt-3_1_1_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1_2 .

c:IDT_3_1_1_3 a owl:Class ;
  rdfs:label "IDT 3.1.1.3 Other Industrial Chemical" ;
  rdfs:comment "Basic chemical production facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_3_1_1 .
c:axiom-idt-3_1_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_1 .

c:IDT_3_1_2 a owl:Class ;
  rdfs:label "IDT 3.1.2 Specialty Chemical Production" ;
  rdfs:comment "Assets engaged in manufacturing differentiated products, or low-volume, high-value compounds sold on the basis of what they do, not what they are. These are generally blended with other compounds according to proprietary formulations." ;
  rdfs:subClassOf c:IDT_3_1 .
c:axiom-idt-3_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1 .

c:IDT_3_1_2_1 a owl:Class ;
  rdfs:label "IDT 3.1.2.1 Coating" ;
  rdfs:comment "Assets involved in the production of chemicals used as materials applied to surfaces to protect and/or decorate." ;
  rdfs:subClassOf c:IDT_3_1_2 .
c:axiom-idt-3_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_2 .

c:IDT_3_1_2_2 a owl:Class ;
  rdfs:label "IDT 3.1.2.2 Explosive" ;
  rdfs:comment "Assets involved in the production of chemicals that contain a great amount of stored energy that can produce an explosion and/or a sudden expansion of the material after initiation, usually accompanied by the production or light, heat, sound and pressure." ;
  rdfs:subClassOf c:IDT_3_1_2 .
c:axiom-idt-3_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_2 .

c:IDT_3_1_2_3 a owl:Class ;
  rdfs:label "IDT 3.1.2.3 Other Specialty" ;
  rdfs:comment "Other specialty chemical production facilities and assets not elsewhere categorized.                                                                                " ;
  rdfs:subClassOf c:IDT_3_1_2 .
c:axiom-idt-3_1_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_2 .

c:IDT_3_1_3 a owl:Class ;
  rdfs:label "IDT 3.1.3 Agricultural Chemical Production" ;
  rdfs:comment "Assets that manufacture or process chemicals used mainly in the farming industry as fertilizers or for crop protection." ;
  rdfs:subClassOf c:IDT_3_1 .
c:axiom-idt-3_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1 .

c:IDT_3_1_3_1 a owl:Class ;
  rdfs:label "IDT 3.1.3.1 Fertilizer" ;
  rdfs:comment "Assets involved in the production of various combinations of nitrogen, phosphorus and potassium that are added to soil to replace or supplement essential nutrients to promote plant growth." ;
  rdfs:subClassOf c:IDT_3_1_3 .
c:axiom-idt-3_1_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_3 .

c:IDT_3_1_3_2 a owl:Class ;
  rdfs:label "IDT 3.1.3.2 Crop Protection" ;
  rdfs:comment "Assets involved in the production of chemical products that help control weeds, harmful insect pests, and plant diseases that afflict crops, as well as products used to control germs and pests." ;
  rdfs:subClassOf c:IDT_3_1_3 .
c:axiom-idt-3_1_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_3 .

c:IDT_3_1_3_2_1 a owl:Class ;
  rdfs:label "IDT 3.1.3.2.1 Pesticide" ;
  rdfs:comment "Assets involved in the production of chemical products intended to prevent, destroy, repel, or mitigate any pest." ;
  rdfs:subClassOf c:IDT_3_1_3_2 .
c:axiom-idt-3_1_3_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_3_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_3_2 .

c:IDT_3_1_3_2_2 a owl:Class ;
  rdfs:label "IDT 3.1.3.2.2 Herbicide" ;
  rdfs:comment "Assets involved in the production of chemical products used to kill unwanted plants. " ;
  rdfs:subClassOf c:IDT_3_1_3_2 .
c:axiom-idt-3_1_3_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_3_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_3_2 .

c:IDT_3_1_3_2_3 a owl:Class ;
  rdfs:label "IDT 3.1.3.2.3 Other Crop Protection Chemical" ;
  rdfs:comment "Crop protection facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_3_1_3_2 .
c:axiom-idt-3_1_3_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_3_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1_3_2 .

c:IDT_3_1_4 a owl:Class ;
  rdfs:label "IDT 3.1.4 Pharmaceutical Production" ;
  rdfs:comment "Assets involved in the production of prescription and over-the-counter drugs; in-vitro and other diagnostic substances to diagnose or monitor the state of human health or veterinary health; bacterial and virus vaccines; toxoids; serums; plasma and other biological products for human and veterinary health; and vitamins and other pharmaceutical preparations for both human and veterinary use. This segment also includes biotechnology, with applications in crop seeds, traits and value-added grains and enzymes among others. " ;
  rdfs:subClassOf c:IDT_3_1 .
c:axiom-idt-3_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1 .

c:IDT_3_1_5 a owl:Class ;
  rdfs:label "IDT 3.1.5 Consumer Product" ;
  rdfs:comment "Assets involved in the production of highly differentiated product lines that are packaged along branding lines. These are widely known as household products." ;
  rdfs:subClassOf c:IDT_3_1 .
c:axiom-idt-3_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1 .

c:IDT_3_1_6 a owl:Class ;
  rdfs:label "IDT 3.1.6 Potential Chemical Weapon Agent and Precursor" ;
  rdfs:comment "Assets involved in the production of chemicals that, due to their dual use characteristics, may represent a security risk as defined under the Chemical Weapons Convention (CWC)." ;
  rdfs:subClassOf c:IDT_3_1 .
c:axiom-idt-3_1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_1 .

c:IDT_3_2 a owl:Class ;
  rdfs:label "IDT 3.2 Hazardous Chemical Transport" ;
  rdfs:comment "Assets used to transport hazardous chemicals.  " ;
  rdfs:subClassOf c:IDT_3 .
c:axiom-idt-3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3 .

c:IDT_3_2_1 a owl:Class ;
  rdfs:label "IDT 3.2.1 Pipeline" ;
  rdfs:comment "Pipelines used for the transport of hazardous chemicals.  " ;
  rdfs:subClassOf c:IDT_3_2 .
c:axiom-idt-3_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_2 .

c:IDT_3_2_1_1 a owl:Class ;
  rdfs:label "IDT 3.2.1.1 Pipeline Component" ;
  rdfs:comment "Lengths of pipeline, interconnections, and valves. Includes above ground, underground, river crossings, and other segments.  " ;
  rdfs:subClassOf c:IDT_3_2_1 .
c:axiom-idt-3_2_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
