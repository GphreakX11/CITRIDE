  owl:annotatedTarget c:IDT_11_6_4 .

c:IDT_11_6_4_2 a owl:Class ;
  rdfs:label "IDT 11.6.4.2 Natural Gas Distribution Pipeline Network" ;
  rdfs:comment "The network of lower pressure pipelines that provide natural gas to consumers. " ;
  rdfs:subClassOf c:IDT_11_6_4 .
c:axiom-idt-11_6_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_6_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_6_4 .

c:IDT_11_6_4_3 a owl:Class ;
  rdfs:label "IDT 11.6.4.3 Natural Gas Distribution Control or Dispatch Center" ;
  rdfs:comment "Centers that control the lower pressure gas distribution system. Includes distribution supervisory control and data acquisition (SCADA) systems." ;
  rdfs:subClassOf c:IDT_11_6_4 .
c:axiom-idt-11_6_4_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_6_4_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_6_4 .

c:IDT_11_6_4_4 a owl:Class ;
  rdfs:label "IDT 11.6.4.4 Natural Gas Distribution Storage" ;
  rdfs:comment "Natural gas distribution storage facilities for storing natural gas for peak shaving and distribution." ;
