c:IDT_17_3_1 a owl:Class ;
  rdfs:label "IDT 17.3.1 Low Level Radioactive Waste Processing or Storage Facility" ;
  rdfs:comment "Facilities handling low level radioactive wastes such as contaminated clothing, medical equipment, laboratory animal carcasses, etc.  Low level waste is categorized by Nuclear Regulatory Commission (NRC) as Class A, B, or C based on the concentration of specific radionuclides, with Class A being the least radioactive.  " ;
  rdfs:subClassOf c:IDT_17_3 .
c:axiom-idt-17_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17_3_1 ;
