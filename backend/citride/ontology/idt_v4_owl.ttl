c:IDT_11_6_1 a owl:Class ;
  rdfs:label "IDT 11.6.1 Crude Oil Pipeline" ;
  rdfs:comment "Pipeline facilities for the transport of crude oil. " ;
  rdfs:subClassOf c:IDT_11_6 .
