  rdfs:label "IDT 1.5.2.9 Other Grocery and Related Products Merchant Wholesaler" ;
  rdfs:comment "Other grocery and related product wholesalers not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_1_5_2 .
