c:IDT_5_3_6_2 a owl:Class ;
  rdfs:label "IDT 5.3.6.2 Natural Gas Distribution Pipeline Network" ;
  rdfs:comment "The network of lower pressure pipelines that provide natural gas to consumers.  " ;
  rdfs:subClassOf c:IDT_5_3_6 .
