  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_2_6 .

c:IDT_1_1_2_6_4 a owl:Class ;
  rdfs:label "IDT 1.1.2.6.4 Other Animal Production (Except Apiculture, Equine or Fur-Bearing)" ;
  rdfs:comment "Facilities primarily engaged in farm-raising other animal production (not apiculture, equine, or fur-bearing animal production)." ;
  rdfs:subClassOf c:IDT_1_1_2_6 .
c:axiom-idt-1_1_2_6_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
