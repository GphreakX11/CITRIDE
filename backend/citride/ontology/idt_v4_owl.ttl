c:IDT_11_2_3_1 a owl:Class ;
  rdfs:label "IDT 11.2.3.1 Rail Yard - Local" ;
  rdfs:comment "A railroad yard used primarily for makeup and breakdown of local trains. Provides storage and maintenance of rail cars and/or locomotives. May also contain an area to load and unload cars. " ;
  rdfs:subClassOf c:IDT_11_2_3 .
c:axiom-idt-11_2_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
