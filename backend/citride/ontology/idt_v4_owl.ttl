c:IDT_9_2_3 a owl:Class ;
  rdfs:label "IDT 9.2.3 Courier Processing Center" ;
  rdfs:comment "Centralized facilities for sorting and processing letters and parcels.  Some vehicle maintenance might also be performed at these centers.    " ;
  rdfs:subClassOf c:IDT_9_2 .
c:axiom-idt-9_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_9_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_9_2 .

c:IDT_9_2_3_1 a owl:Class ;
  rdfs:label "IDT 9.2.3.1 Courier International/National Hub" ;
  rdfs:comment "Facilities at airports that receive, concentrate, transfer, dispatch, and distribute letters and parcels to and from international locations and have reach to all hubs and gateways." ;
  rdfs:subClassOf c:IDT_9_2_3 .
c:axiom-idt-9_2_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_9_2_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_9_2_3 .

c:IDT_9_2_3_2 a owl:Class ;
  rdfs:label "IDT 9.2.3.2 Courier Regional Hub" ;
  rdfs:comment "Facilities that receive, concentrate, transfer, dispatch, and distribute letters and parcels primarily within a region, but may also have reach to other regional hubs.  These can be at air facilities, trucking hubs, or a combination of both.  " ;
  rdfs:subClassOf c:IDT_9_2_3 .
c:axiom-idt-9_2_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_9_2_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_9_2_3 .

c:IDT_9_2_3_3 a owl:Class ;
  rdfs:label "IDT 9.2.3.3 Courier Air Gateway" ;
  rdfs:comment "Facilities at airports that receive, concentrate, transfer, dispatch, and distribute letters and parcels via air, truck, or rail for transport between regional hubs and pickup/delivery stations.  " ;
  rdfs:subClassOf c:IDT_9_2_3 .
c:axiom-idt-9_2_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_9_2_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_9_2_3 .

c:IDT_9_2_3_4 a owl:Class ;
  rdfs:label "IDT 9.2.3.4 Courier Pickup/Delivery Station" ;
  rdfs:comment "Local facilities that receive, concentrate, transfer, dispatch, and distribute letters and parcels to/from customers.  " ;
  rdfs:subClassOf c:IDT_9_2_3 .
c:axiom-idt-9_2_3_4-parent a owl:Axiom ;
