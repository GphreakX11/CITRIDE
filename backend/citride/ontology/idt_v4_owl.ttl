c:IDT_3_2_2 a owl:Class ;
  rdfs:label "IDT 3.2.2 Marine Transport" ;
  rdfs:comment "Marine assets used for transporting hazardous chemicals." ;
  rdfs:subClassOf c:IDT_3_2 .
c:axiom-idt-3_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_2 .

c:IDT_3_2_2_1 a owl:Class ;
  rdfs:label "IDT 3.2.2.1 Tanker" ;
  rdfs:comment "Marine vessels for moving hazardous chemicals. Includes ocean-going tankers for movement of imported and domestic hazardous chemicals and tankers and barges for movement of hazardous chemicals on coastal and inland waterways." ;
  rdfs:subClassOf c:IDT_3_2_2 .
c:axiom-idt-3_2_2_1-parent a owl:Axiom ;
