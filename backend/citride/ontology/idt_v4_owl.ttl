  rdfs:label "IDT 17.2.4.4 Radioactive Source Manufacturing" ;
  rdfs:comment "Facilities associated with organizations that produce radioisotopes in bulk by irradiation of targets or reprocessing spent reactor fuel." ;
  rdfs:subClassOf c:IDT_17_2_4 .
