c:IDT_1_5_2_5 a owl:Class ;
  rdfs:label "IDT 1.5.2.5 Confectionery Merchant Wholesaler" ;
  rdfs:comment "Establishments primarily engaged in the merchant wholesale distribution of confectioneries; salted or roasted nuts; popcorn; potato, corn, and similar chips; and/or fountain fruits and syrups." ;
  rdfs:subClassOf c:IDT_1_5_2 .
