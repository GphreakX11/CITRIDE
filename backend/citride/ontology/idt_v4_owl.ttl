  owl:annotatedTarget c:IDT_3_3 .

c:IDT_3_3_3 a owl:Class ;
  rdfs:label "IDT 3.3.3 Storage at Non-Manufacturing Facility" ;
  rdfs:comment "Establishments that are not manufacturers but that have hazardous chemicals on-site to use in their activities. Note: Facilities in this category are listed in their primary categorization (e.g., wastewater treatment plants). If they have hazardous chemicals on site (e.g., chlorine), this concept is added." ;
  rdfs:subClassOf c:IDT_3_3 .
c:axiom-idt-3_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_3 .

c:IDT_3_4 a owl:Class ;
  rdfs:label "IDT 3.4 Regulatory, Oversight, or Industry Organization" ;
  rdfs:comment "Organizations that provide technical, operation, pricing, and business oversight and support to the chemical industry." ;
  rdfs:subClassOf c:IDT_3 .
