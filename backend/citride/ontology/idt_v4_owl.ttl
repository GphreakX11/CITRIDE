c:IDT_1_2_2_1_1 a owl:Class ;
  rdfs:label "IDT 1.2.2.1.1 Flour Milling" ;
  rdfs:comment "Facilities primarily engaged in (1) milling flour or meal from grains (except rice) or vegetables and/or (2) milling flour and preparing flour mixes or doughs. " ;
  rdfs:subClassOf c:IDT_1_2_2_1 .
c:axiom-idt-1_2_2_1_1-parent a owl:Axiom ;
