c:IDT_1_2_2_1_2 a owl:Class ;
  rdfs:label "IDT 1.2.2.1.2 Rice Milling" ;
  rdfs:comment "Facilities primarily engaged in one of the following: (1) milling rice; (2) cleaning and polishing rice; or (3) milling, cleaning, and polishing rice. The establishments in this industry may package the rice they mill with other ingredients" ;
  rdfs:subClassOf c:IDT_1_2_2_1 .
c:axiom-idt-1_2_2_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_2_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_2_1 .

c:IDT_1_2_2_1_3 a owl:Class ;
  rdfs:label "IDT 1.2.2.1.3 Malt Manufacturing" ;
  rdfs:comment "Facilities primarily engaged in manufacturing malt from barley, rye, or other grains." ;
  rdfs:subClassOf c:IDT_1_2_2_1 .
c:axiom-idt-1_2_2_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_2_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_2_1 .

c:IDT_1_2_2_2 a owl:Class ;
  rdfs:label "IDT 1.2.2.2 Starch, Vegetable Fat, and Oil Manufacturing" ;
  rdfs:comment "Facilities primarily engaged in one or more of the following: (1) wet milling corn and vegetables; (2) crushing oilseeds and tree nuts; (3) refining and/or blending vegetable oils; (4) manufacturing shortening and margarine; and (5) blending purchased animal fats with vegetable fats." ;
  rdfs:subClassOf c:IDT_1_2_2 .
c:axiom-idt-1_2_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_2 .

c:IDT_1_2_2_2_1 a owl:Class ;
  rdfs:label "IDT 1.2.2.2.1 Wet Corn Milling" ;
  rdfs:comment "Facilities primarily engaged in wet milling corn and other vegetables (except to make ethyl alcohol). Examples of products made in these establishments are corn sweeteners, such as glucose, dextrose, and fructose; corn oil; and starches (except laundry). " ;
  rdfs:subClassOf c:IDT_1_2_2_2 .
c:axiom-idt-1_2_2_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_2_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_2_2 .

c:IDT_1_2_2_2_2 a owl:Class ;
  rdfs:label "IDT 1.2.2.2.2 Soybean Processing  " ;
  rdfs:comment "Facilities primarily engaged in crushing soybeans. Examples of products produced in these establishments are soybean oil, soybean cake and meal, and soybean protein isolates and concentrates. " ;
  rdfs:subClassOf c:IDT_1_2_2_2 .
c:axiom-idt-1_2_2_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_2_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_2_2 .

c:IDT_1_2_2_2_3 a owl:Class ;
  rdfs:label "IDT 1.2.2.2.3 Other Oilseed Processing " ;
  rdfs:comment "Facilities primarily engaged in crushing oilseeds (except soybeans) and tree nuts, such as cottonseeds, linseeds, peanuts, and sunflower seeds." ;
  rdfs:subClassOf c:IDT_1_2_2_2 .
c:axiom-idt-1_2_2_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_2_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_2_2 .

c:IDT_1_2_2_2_4 a owl:Class ;
  rdfs:label "IDT 1.2.2.2.4 Fats and Oils Refining and Blending " ;
  rdfs:comment "Facilities primarily engaged in one or more of the following: (1) manufacturing shortening and margarine from purchased fats and oils; (2) refining and/or blending vegetable, oilseed, and tree nut oils from purchased oils; and (3) blending purchased animal fats with purchased vegetable fats. " ;
  rdfs:subClassOf c:IDT_1_2_2_2 .
