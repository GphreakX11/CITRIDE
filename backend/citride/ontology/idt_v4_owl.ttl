c:IDT_8_4_2 a owl:Class ;
  rdfs:label "IDT 8.4.2 Point of Presence" ;
  rdfs:comment "Locations where internet service providers (ISPs) have equipment to connect their customers to the rest of the Internet. Such equipment includes routers, digital/analog aggregators, servers, and switches. Larger ISPs have multiple points of presence (POPs). The POP may be located at a facility owned by a communications company. More than one ISP may have POP equipment at the same location." ;
  rdfs:subClassOf c:IDT_8_4 .
c:axiom-idt-8_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_4 .

c:IDT_8_4_3 a owl:Class ;
  rdfs:label "IDT 8.4.3 Network Access Point" ;
  rdfs:comment "Points of access to the Internet used by internet service providers (ISPs) and providers of Internet regional and local subnets. Network access points (NAPs) provide a junction where ISPs exchange traffic and routes. NAPs provide a means of direct connection to the Internet, rather than an intermediate point of exchanging commercial traffic." ;
  rdfs:subClassOf c:IDT_8_4 .
c:axiom-idt-8_4_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_4_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_4 .

c:IDT_8_4_4 a owl:Class ;
  rdfs:label "IDT 8.4.4 Peering Point" ;
  rdfs:comment "Points where Internet Service Providers (ISPs), usually the larger ones, exchange traffic under peering arrangements. Frequently, peering points are located at network access points." ;
  rdfs:subClassOf c:IDT_8_4 .
c:axiom-idt-8_4_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_4_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_8_4 .

c:IDT_8_4_5 a owl:Class ;
  rdfs:label "IDT 8.4.5 Domain Name Server" ;
  rdfs:comment "The set of computers and databases that translate Internet domain names, which are alphabetic, into numerical Internet Protocol (IP) addresses. Used to locate each computer on the Internet. " ;
  rdfs:subClassOf c:IDT_8_4 .
c:axiom-idt-8_4_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_8_4_5 ;
