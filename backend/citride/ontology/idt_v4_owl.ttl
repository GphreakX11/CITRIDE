  rdfs:label "IDT 17.3.3.1 Spent Nuclear Fuel Wet Storage Facility" ;
  rdfs:comment "Facilities where spent fuel is stored in a pool of water. Generally located adjacent to an operating reactor site. " ;
  rdfs:subClassOf c:IDT_17_3_3 .
