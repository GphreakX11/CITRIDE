c:IDT_14_2_3 a owl:Class ;
  rdfs:label "IDT 14.2.3 Permanently-Moored Casino" ;
  rdfs:comment "Casinos operating from a permanently moored vessel and/or have been taken out of navigation." ;
  rdfs:subClassOf c:IDT_14_2 .
