c:IDT_5_6 a owl:Class ;
  rdfs:label "IDT 5.6 Biodiesel" ;
  rdfs:comment "Facilities involved in the supply, processing, storage, transport, distribution, marketing, and regulation of biodiesel, a fuel typically made from soybean, canola, or other vegetable oils, animal fats, and recycled grease. It can serve as a substitute for petroleum-derived diesel or distillate fuel." ;
  rdfs:subClassOf c:IDT_5 .
c:axiom-idt-5_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5 .

c:IDT_5_6_1 a owl:Class ;
  rdfs:label "IDT 5.6.1 Biodiesel Feed Material Supply" ;
  rdfs:comment "Facilities involved in supplying feed material, organic non-fossil material of biological origin that is usually a byproduct or a discarded product. Biodiesel feedstock includes municipal solid waste from biogenic sources, landfill gas, sludge waste, agricultural crops and byproducts, straw and other biomass solids, liquids, and gases; can include recycled cooking oil." ;
  rdfs:subClassOf c:IDT_5_6 .
c:axiom-idt-5_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_6_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_6 .

c:IDT_5_6_2 a owl:Class ;
  rdfs:label "IDT 5.6.2 Biodiesel Production Facility" ;
  rdfs:comment "Assets that manufacture biodiesel from organic non-fossil material, usually manufactured from vegetable oils, animal fats, and recycled cooking oils. " ;
  rdfs:subClassOf c:IDT_5_6 .
c:axiom-idt-5_6_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_6_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_6 .

c:IDT_5_6_3 a owl:Class ;
  rdfs:label "IDT 5.6.3 Biodiesel Storage Facility" ;
  rdfs:comment "Facilities with tanks to store and/or market biodiesel. Includes storage tanks, pipes and pumps, control machinery, and other equipment." ;
  rdfs:subClassOf c:IDT_5_6 .
c:axiom-idt-5_6_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_6_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_6 .

c:IDT_5_6_4 a owl:Class ;
  rdfs:label "IDT 5.6.4 Biodiesel Transport Facility" ;
  rdfs:comment "Transport facilities that are either at the biorefinery where the biodiesel is made or at the terminal where it will be delivered to the customer. Movement from production facility to storage tanks or to end user is usually done via a tanker truck." ;
  rdfs:subClassOf c:IDT_5_6 .
c:axiom-idt-5_6_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_6_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_6 .

c:IDT_5_6_5 a owl:Class ;
  rdfs:label "IDT 5.6.5 Biodiesel Distribution Facility" ;
  rdfs:comment "Facilities made up of storage tanks and fuel dispensing equipment to fuel biodiesel vehicles." ;
  rdfs:subClassOf c:IDT_5_6 .
c:axiom-idt-5_6_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_6_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_6 .

c:IDT_5_6_5_1 a owl:Class ;
  rdfs:label "IDT 5.6.5.1 Biodiesel Fueling Station" ;
  rdfs:comment "Fuel dispensing equipment to fuel biodiesel vehicles. Often customers use a blend of biodiesel with regular diesel. May have diesel storage on site and blending equipment to make an appropriate biodiesel blend. " ;
  rdfs:subClassOf c:IDT_5_6_5 .
c:axiom-idt-5_6_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_6_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_6_5 .

c:IDT_5_6_6 a owl:Class ;
  rdfs:label "IDT 5.6.6 Other Biodiesel Supporting Facility" ;
  rdfs:comment "Biodiesel facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_5_6 .
c:axiom-idt-5_6_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_6_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_6 .

c:IDT_5_7 a owl:Class ;
  rdfs:label "IDT 5.7 Hydrogen" ;
  rdfs:comment "Facilities associated with hydrogen, the lightest of all gases, occurring chiefly in combination with oxygen in water. Hydrogen exists also in acids, bases, alcohols, petroleum, and other hydrocarbons; it is an energy carrier not an energy source." ;
  rdfs:subClassOf c:IDT_5 .
c:axiom-idt-5_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5 .

c:IDT_5_7_1 a owl:Class ;
  rdfs:label "IDT 5.7.1 Hydrogen Source Material Supply" ;
  rdfs:comment "Facilities associated with supplying the source material for hydrogen. It is usually produced from hydrocarbons, most frequently natural gas or methane; biomass; or it can be separated from oxygen in water with enough heat, electricity or by using microbes. " ;
  rdfs:subClassOf c:IDT_5_7 .
c:axiom-idt-5_7_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_7_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_7 .

c:IDT_5_7_2 a owl:Class ;
  rdfs:label "IDT 5.7.2 Hydrogen Production Facility" ;
  rdfs:comment "Facilities and the associated equipment that produce hydrogen." ;
  rdfs:subClassOf c:IDT_5_7 .
c:axiom-idt-5_7_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_7_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_7 .

c:IDT_5_7_3 a owl:Class ;
  rdfs:label "IDT 5.7.3 Hydrogen Storage Facility" ;
  rdfs:comment "Storage facilities for hydrogen are located at production facilities, refineries, and chemical plants that use hydrogen. " ;
  rdfs:subClassOf c:IDT_5_7 .
c:axiom-idt-5_7_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_7_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_7 .

c:IDT_5_7_4 a owl:Class ;
  rdfs:label "IDT 5.7.4 Hydrogen Transport Facility" ;
  rdfs:comment "Facilities with storage and fueling equipment to load trucks carrying compressed hydrogen to end-users." ;
  rdfs:subClassOf c:IDT_5_7 .
c:axiom-idt-5_7_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_7_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_7 .

c:IDT_5_7_5 a owl:Class ;
  rdfs:label "IDT 5.7.5 Hydrogen Distribution Facility" ;
  rdfs:comment "Facilities supporting the fueling of end-user hydrogen vehicles." ;
  rdfs:subClassOf c:IDT_5_7 .
c:axiom-idt-5_7_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_7_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_7 .

c:IDT_5_7_5_1 a owl:Class ;
  rdfs:label "IDT 5.7.5.1 Hydrogen Fueling Station" ;
  rdfs:comment "Storage tanks and dispensing equipment to refill hydrogen-fueled vehicles. " ;
  rdfs:subClassOf c:IDT_5_7_5 .
c:axiom-idt-5_7_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_7_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_7_5 .

c:IDT_5_7_6 a owl:Class ;
  rdfs:label "IDT 5.7.6 Other Hydrogen Supporting Facility" ;
  rdfs:comment "Hydrogen facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_5_7 .
c:axiom-idt-5_7_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_7_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_7 .

c:IDT_5_8 a owl:Class ;
  rdfs:label "IDT 5.8 Other Energy Conversion System" ;
  rdfs:comment "Energy conversion systems not listed elsewhere." ;
  rdfs:subClassOf c:IDT_5 .
c:axiom-idt-5_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5 .

c:IDT_5_8_1 a owl:Class ;
  rdfs:label "IDT 5.8.1 District Energy System" ;
  rdfs:comment "Systems that produce and distribute electricity, hot water, steam, and chilled water from a central \"trigeneration\" power/energy plant's location." ;
  rdfs:subClassOf c:IDT_5_8 .
c:axiom-idt-5_8_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_8_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_8 .

c:IDT_5_8_1_1 a owl:Class ;
  rdfs:label "IDT 5.8.1.1 District Heating" ;
  rdfs:comment "Facilities or assets associated with steam or hot water from an outside source used as an energy source in a building. The steam or hot water is produced in a central plant and piped into the building. The district heat may be purchased from a utility or provided by a physical plant in a separate building that is part of the same facility (for example, a hospital complex or university)." ;
  rdfs:subClassOf c:IDT_5_8_1 .
c:axiom-idt-5_8_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_8_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_8_1 .

c:IDT_5_8_1_2 a owl:Class ;
  rdfs:label "IDT 5.8.1.2 District Cooling" ;
  rdfs:comment "Facilities or assets associated with chilled water from an outside source used as an energy source in a building; the chilled water is produced in a central plant and piped into the building. The district coolant may be purchased from a utility or provided by a physical plant in a separate building that is part of the same facility (for example, a hospital complex or university)." ;
  rdfs:subClassOf c:IDT_5_8_1 .
c:axiom-idt-5_8_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_8_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_8_1 .

c:IDT_5_8_1_3 a owl:Class ;
  rdfs:label "IDT 5.8.1.3 District Power" ;
  rdfs:comment "Facilities or assets associated with electricity from an outside source used as an energy source in a building. The electricity is produced in a central plant and transmitted to the building. The district electricity may be purchased from a utility or provided by a physical plant in a separate building that is part of the same facility (for example, a hospital complex or university)." ;
  rdfs:subClassOf c:IDT_5_8_1 .
c:axiom-idt-5_8_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_8_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_8_1 .

c:IDT_5_8_1_4 a owl:Class ;
  rdfs:label "IDT 5.8.1.4 Combined Heat and Power" ;
  rdfs:comment "A plant designed to produce both heat and electricity from a single heat source. Note: Combined heat and power is used in place of the U.S. Energy Information Administration term \"cogenerator\" as this term better describes the facility because some of the plants do not produce heat and power in a sequential fashion and, as a result, do not meet the legal definition of cogeneration specified in the Public Utility Regulatory Policies Act (PURPA)." ;
  rdfs:subClassOf c:IDT_5_8_1 .
c:axiom-idt-5_8_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_8_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_8_1 .

c:IDT_5_9 a owl:Class ;
  rdfs:label "IDT 5.9 Regulatory, Oversight, or Industry Organization" ;
  rdfs:comment "Organizations that provide technical, operation, pricing, and business oversight and support to the energy system. " ;
  rdfs:subClassOf c:IDT_5 .
c:axiom-idt-5_9-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_9 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5 .

c:IDT_5_9_1 a owl:Class ;
  rdfs:label "IDT 5.9.1 Federal Energy Agency" ;
  rdfs:comment "Federal agencies that deal with the energy system e.g., Department of Energy, Federal Energy Regulatory Commission, and Department of Transportation." ;
  rdfs:subClassOf c:IDT_5_9 .
c:axiom-idt-5_9_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_9_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_9 .

c:IDT_5_9_2 a owl:Class ;
  rdfs:label "IDT 5.9.2 State, Local, Regional Energy Agency" ;
  rdfs:comment "State, local, and regional agencies regulating energy companies operating in their jurisdiction including public utility commissions, environmental agencies, and others." ;
  rdfs:subClassOf c:IDT_5_9 .
c:axiom-idt-5_9_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_9_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_9 .

c:IDT_5_9_3 a owl:Class ;
  rdfs:label "IDT 5.9.3 Energy Industry Organization" ;
  rdfs:comment "Industry organizations (e.g., National Electric Reliability Council (NERC), American Petroleum Institute, American Gas Association) that provide industry-wide support.  " ;
  rdfs:subClassOf c:IDT_5_9 .
c:axiom-idt-5_9_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_9_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_9 .

c:IDT_5_9_4 a owl:Class ;
  rdfs:label "IDT 5.9.4 International Energy Organization" ;
  rdfs:comment "International organizations dealing with global energy issues." ;
  rdfs:subClassOf c:IDT_5_9 .
c:axiom-idt-5_9_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_9_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_9 .

c:IDT_6 a owl:Class ;
  rdfs:label "IDT 6 Emergency Services" ;
  rdfs:comment "Assets involved in emergency response designed to save lives, protect property and the environment, assist in the management of disasters (both natural and manmade), and aid in recovery." ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_6_1 a owl:Class ;
  rdfs:label "IDT 6.1 Law Enforcement" ;
  rdfs:comment "Federal, state, and local law enforcement assets used to protect the public, conduct criminal investigations, gather evidence, and apprehend criminal perpetrators." ;
  rdfs:subClassOf c:IDT_6 .
c:axiom-idt-6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6 .

c:IDT_6_1_1 a owl:Class ;
  rdfs:label "IDT 6.1.1 Law Enforcement Administrative Office/Headquarters" ;
  rdfs:comment "Central office that manages law enforcement activities in a given jurisdiction.  Note: In many communities, this office is located in a police station." ;
  rdfs:subClassOf c:IDT_6_1 .
c:axiom-idt-6_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1 .

c:IDT_6_1_2 a owl:Class ;
  rdfs:label "IDT 6.1.2 Law Enforcement Operational Facility" ;
  rdfs:comment "Local facilities, to include police stations, used for the day-to-day law enforcement operations.  Smaller communities may have only one station serving their jurisdiction, while larger communities may have several." ;
  rdfs:subClassOf c:IDT_6_1 .
c:axiom-idt-6_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1 .

c:IDT_6_1_2_1 a owl:Class ;
  rdfs:label "IDT 6.1.2.1 Tactical Unit" ;
  rdfs:comment "Specialized law enforcement units focused on dealing with specific situations (e.g., Special Weapons and Tactics [SWAT] teams, gang crimes units).  Generally have specialized training and equipment (e.g., automatic weapons, night vision equipment)." ;
  rdfs:subClassOf c:IDT_6_1_2 .
c:axiom-idt-6_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2 .

c:IDT_6_1_2_1_1 a owl:Class ;
  rdfs:label "IDT 6.1.2.1.1 Special Weapons and Tactics (SWAT) Team" ;
  rdfs:comment "Special Weapons and Tactics (SWAT) teams are specially trained to handle high-risk situations and specialized tactical needs. Team members have advanced skills beyond that of typical patrol officers." ;
  rdfs:subClassOf c:IDT_6_1_2_1 .
c:axiom-idt-6_1_2_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2_1 .

c:IDT_6_1_2_1_2 a owl:Class ;
  rdfs:label "IDT 6.1.2.1.2 Riot/Crowd Control" ;
  rdfs:comment "Police units trained in handling large crowds and riot situations, including specialized training in crowd dispersal, tactics, and special weapons." ;
  rdfs:subClassOf c:IDT_6_1_2_1 .
c:axiom-idt-6_1_2_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2_1 .

c:IDT_6_1_2_1_3 a owl:Class ;
  rdfs:label "IDT 6.1.2.1.3 Bomb Squad/Explosives Unit" ;
  rdfs:comment "A public safety agency specializing in the investigation and disarming of suspected explosive devices." ;
  rdfs:subClassOf c:IDT_6_1_2_1 .
c:axiom-idt-6_1_2_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2_1 .

c:IDT_6_1_2_1_4 a owl:Class ;
  rdfs:label "IDT 6.1.2.1.4 Public Safety Dive Team" ;
  rdfs:comment "Underwater teams used to recover evidence, drowned victims, and lost vessels." ;
  rdfs:subClassOf c:IDT_6_1_2_1 .
c:axiom-idt-6_1_2_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2_1 .

c:IDT_6_1_2_1_5 a owl:Class ;
  rdfs:label "IDT 6.1.2.1.5 Law Enforcement Patrol Team (Strike Team)" ;
  rdfs:comment "A set number of resources of the same kind and type that have an established minimum number of personnel." ;
  rdfs:subClassOf c:IDT_6_1_2_1 .
c:axiom-idt-6_1_2_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2_1 .

c:IDT_6_1_2_2 a owl:Class ;
  rdfs:label "IDT 6.1.2.2 Crime Scene Investigation Unit" ;
  rdfs:comment "Specialized law enforcement units focused on gathering evidence and information at the scene of an incident. Generally have specialized training and equipment (e.g., photographic equipment, fingerprint equipment)." ;
  rdfs:subClassOf c:IDT_6_1_2 .
c:axiom-idt-6_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2 .

c:IDT_6_1_2_3 a owl:Class ;
  rdfs:label "IDT 6.1.2.3 Canine (K-9) Unit" ;
  rdfs:comment "Trained canine units providing law enforcement with a non-lethal means of apprehending dangerous criminal offenders; detecting intruders and alerting handlers to their presence; pursuing, attacking, and holding criminal offenders who resist apprehension; searching and clearing buildings and large open areas for criminals; tracking lost children or other persons; detecting the presence of certain narcotics, explosives, and tobacco products; locating deceased subjects, crime scenes, and minute physical evidence; and providing a strong psychological deterrent to certain types of criminal conduct." ;
  rdfs:subClassOf c:IDT_6_1_2 .
c:axiom-idt-6_1_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2 .

c:IDT_6_1_2_4 a owl:Class ;
  rdfs:label "IDT 6.1.2.4 Marine and Port Law Enforcement Unit" ;
  rdfs:comment "Aquatic law enforcement units focused on drug interdiction, smuggling, etc. Includes supporting facilities for vessels (e.g., docks, fueling stations for law enforcement boats)." ;
  rdfs:subClassOf c:IDT_6_1_2 .
c:axiom-idt-6_1_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2 .

c:IDT_6_1_2_5 a owl:Class ;
  rdfs:label "IDT 6.1.2.5 Aviation Unit" ;
  rdfs:comment "Specialized law enforcement units that use aircraft for law enforcement, surveillance, and search and rescue purposes." ;
  rdfs:subClassOf c:IDT_6_1_2 .
c:axiom-idt-6_1_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2 .

c:IDT_6_1_2_5_1 a owl:Class ;
  rdfs:label "IDT 6.1.2.5.1 Fixed-Wing Airplane" ;
  rdfs:comment "Fixed-wing aircraft of various sizes used for surveillance, extraditions, personnel, and cargo transportation." ;
  rdfs:subClassOf c:IDT_6_1_2_5 .
c:axiom-idt-6_1_2_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2_5 .

c:IDT_6_1_2_5_2 a owl:Class ;
  rdfs:label "IDT 6.1.2.5.2 Helicopter" ;
  rdfs:comment "Helicopters of various sizes to provide multifunction aerial support for ground operations." ;
  rdfs:subClassOf c:IDT_6_1_2_5 .
c:axiom-idt-6_1_2_5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_5_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2_5 .

c:IDT_6_1_2_6 a owl:Class ;
  rdfs:label "IDT 6.1.2.6 Search and Rescue Unit" ;
  rdfs:comment "Units Involved in the location, rescue (extrication), and initial medical stabilization of victims trapped in confined spaces." ;
  rdfs:subClassOf c:IDT_6_1_2 .
c:axiom-idt-6_1_2_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2 .

c:IDT_6_1_2_7 a owl:Class ;
  rdfs:label "IDT 6.1.2.7 Other Specialized Law Enforcement Operational Facility" ;
  rdfs:comment "Facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_6_1_2 .
c:axiom-idt-6_1_2_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2 .

c:IDT_6_1_2_8 a owl:Class ;
  rdfs:label "IDT 6.1.2.8 Hazardous Materials (HAZMAT) Response Unit" ;
  rdfs:comment "Units that are trained and equipped to perform work to control actual or potential leaks, spills, discharges, or releases of Hazardous Materials (HAZMAT), requiring possible close approach to the material. The team/equipment may include external or contracted resources." ;
  rdfs:subClassOf c:IDT_6_1_2 .
c:axiom-idt-6_1_2_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_2_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_2 .

c:IDT_6_1_3 a owl:Class ;
  rdfs:label "IDT 6.1.3 Correctional Facility" ;
  rdfs:comment "Federal, state, and local facilities for the treatment of offenders through a system of penal incarceration, rehabilitation, probation, and parole, or the administrative system that implements these functions." ;
  rdfs:subClassOf c:IDT_6_1 .
c:axiom-idt-6_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1 .

c:IDT_6_1_4 a owl:Class ;
  rdfs:label "IDT 6.1.4 Law Enforcement Training Facility" ;
  rdfs:comment "Federal, state, and local facilities that specialize in personnel training programs." ;
  rdfs:subClassOf c:IDT_6_1 .
c:axiom-idt-6_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1 .

c:IDT_6_1_5 a owl:Class ;
  rdfs:label "IDT 6.1.5 Law Enforcement Maintenance Facility" ;
  rdfs:comment "Federal, state, and local facilities specializing in repair or maintenance of law enforcement vehicles and/or equipment." ;
  rdfs:subClassOf c:IDT_6_1 .
c:axiom-idt-6_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1 .

c:IDT_6_1_6 a owl:Class ;
  rdfs:label "IDT 6.1.6 Law Enforcement Communication Facility" ;
  rdfs:comment "Facilities where communication equipment (e.g., radios, transmitter and repeater towers, communication centers) are used or stored by law enforcement.  Note: This equipment is frequently shared with other emergency response organizations and government public service agencies. " ;
  rdfs:subClassOf c:IDT_6_1 .
c:axiom-idt-6_1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1 .

c:IDT_6_1_6_1 a owl:Class ;
  rdfs:label "IDT 6.1.6.1 Mobile Communications Unit" ;
  rdfs:comment "Units that provide on-scene dispatch and radio assistance to law enforcement personnel responding to various incidents." ;
  rdfs:subClassOf c:IDT_6_1_6 .
c:axiom-idt-6_1_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_6_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1_6 .

c:IDT_6_1_7 a owl:Class ;
  rdfs:label "IDT 6.1.7 Law Enforcement Supply Facility" ;
  rdfs:comment "Pre-identified storage and staging areas for law enforcement supplies and equipment." ;
  rdfs:subClassOf c:IDT_6_1 .
c:axiom-idt-6_1_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1 .

c:IDT_6_1_8 a owl:Class ;
  rdfs:label "IDT 6.1.8 Private Security Guard Office" ;
  rdfs:comment "Administrative facilities for private security force." ;
  rdfs:subClassOf c:IDT_6_1 .
c:axiom-idt-6_1_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1 .

c:IDT_6_1_9 a owl:Class ;
  rdfs:label "IDT 6.1.9 Other Law Enforcement Facility" ;
  rdfs:comment "Facilities and assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_6_1 .
c:axiom-idt-6_1_9-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_1_9 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_1 .

c:IDT_6_2 a owl:Class ;
  rdfs:label "IDT 6.2 Fire and Emergency Services" ;
  rdfs:comment "Federal, state, and local facilities and assets used by trained personnel in fire suppression, fire prevention, hazardous materials (HAZMAT) control, emergency rescue, building code enforcement, and public fire safety education. Includes assets used to respond to chemical/biological/radiological incidents." ;
  rdfs:subClassOf c:IDT_6 .
c:axiom-idt-6_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6 .

c:IDT_6_2_1 a owl:Class ;
  rdfs:label "IDT 6.2.1 Fire & Emergency Services Administrative Office/Headquarters" ;
  rdfs:comment "Central offices where fire and hazardous materials (HAZMAT) activities are managed in a given jurisdiction. Note: In many communities these offices are located in a fire station." ;
  rdfs:subClassOf c:IDT_6_2 .
c:axiom-idt-6_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2 .

c:IDT_6_2_2 a owl:Class ;
  rdfs:label "IDT 6.2.2 Fire & Emergency Services Operational Facility" ;
  rdfs:comment "Local facilities, to include fire stations, used for day-to-day operations and staffed by response personnel.  Includes vehicle bays for fire apparatus and crew sleeping quarters.  " ;
  rdfs:subClassOf c:IDT_6_2 .
c:axiom-idt-6_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2 .

c:IDT_6_2_2_1 a owl:Class ;
  rdfs:label "IDT 6.2.2.1 Hazardous Materials (HAZMAT) Entry Team" ;
  rdfs:comment "Units specialized in responding to hazardous materials (HAZMAT) emergencies." ;
  rdfs:subClassOf c:IDT_6_2_2 .
c:axiom-idt-6_2_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_2 .

c:IDT_6_2_2_2 a owl:Class ;
  rdfs:label "IDT 6.2.2.2 Marine Emergency Unit" ;
  rdfs:comment "Aquatic units specialized in emergency operations (e.g., water rescue, firefighting).  Includes supporting facilities for emergency vessels (e.g., docks, fueling stations for fireboats)." ;
  rdfs:subClassOf c:IDT_6_2_2 .
c:axiom-idt-6_2_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_2 .

c:IDT_6_2_2_3 a owl:Class ;
  rdfs:label "IDT 6.2.2.3 Air Emergency Unit" ;
  rdfs:comment "A rotary-wing aircraft configured, staffed, and equipped to respond, care for, and transport patients. A rotary-wing aircraft must be approved/licensed by a State." ;
  rdfs:subClassOf c:IDT_6_2_2 .
c:axiom-idt-6_2_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_2 .

c:IDT_6_2_2_3_1 a owl:Class ;
  rdfs:label "IDT 6.2.2.3.1 Area Command Team, Firefighting" ;
  rdfs:comment "An interagency organization under the auspices of National Wildfire Coordination Group (NWCG) that oversees the management of multiple incidents which are supervised by an incident management team (IMT) organization; or that oversees the management of a very large incident that has multiple IMTs assigned to it. Area Command has the responsibility to set overall strategy and priorities, allocate critical resources based on priorities, ensure incidents are properly managed, objectives are met and strategies followed." ;
  rdfs:subClassOf c:IDT_6_2_2_3 .
c:axiom-idt-6_2_2_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_2_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_2_3 .

c:IDT_6_2_2_3_2 a owl:Class ;
  rdfs:label "IDT 6.2.2.3.2 Air Search Team (Fixed-Wing)" ;
  rdfs:comment "Teams that provide airborne search, emergency airlift, airborne communications, and other special services. Varying levels of specialized management support and command and control capabilities are included in team structures." ;
  rdfs:subClassOf c:IDT_6_2_2_3 .
c:axiom-idt-6_2_2_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_2_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_2_3 .

c:IDT_6_2_2_3_3 a owl:Class ;
  rdfs:label "IDT 6.2.2.3.3 Air Search and Rescue" ;
  rdfs:comment "Teams that provide search and rescue emergency airlift and other special services at the request of, and to support, state and county agency needs." ;
  rdfs:subClassOf c:IDT_6_2_2_3 .
c:axiom-idt-6_2_2_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_2_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_2_3 .

c:IDT_6_2_2_4 a owl:Class ;
  rdfs:label "IDT 6.2.2.4 Tactical Team" ;
  rdfs:comment "Specialized firefighting units focused on dealing with specific situations (e.g., crew transport, wildland fire suppression).  Tactical units generally have specialized training and equipment that increases the unit’s proficiency in responding to an emergency. " ;
  rdfs:subClassOf c:IDT_6_2_2 .
c:axiom-idt-6_2_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_2 .

c:IDT_6_2_2_4_1 a owl:Class ;
  rdfs:label "IDT 6.2.2.4.1 Crew Transport (Firefighting Crew)" ;
  rdfs:comment "Vehicles capable of transporting a specified number of crew personnel in a specified manner." ;
  rdfs:subClassOf c:IDT_6_2_2_4 .
c:axiom-idt-6_2_2_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_2_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_2_4 .

c:IDT_6_2_2_4_2 a owl:Class ;
  rdfs:label "IDT 6.2.2.4.2 Hand Crew" ;
  rdfs:comment "Units specialized in combating wildland fires. Hand Crews, teams of multi-skilled professional firefighters, serve as the frontline forces during wildland fire responses." ;
  rdfs:subClassOf c:IDT_6_2_2_4 .
c:axiom-idt-6_2_2_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_2_2_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_2_2_4 .

c:IDT_6_2_2_5 a owl:Class ;
  rdfs:label "IDT 6.2.2.5 Search and Rescue Unit" ;
  rdfs:comment "Units specialized in structural collapse, trench, confined space, and rope rescue. Includes response to: caves, collapses, mines and tunnels, mountain areas, radio direction finding, swift water/flood incidents, urban and wilderness areas, and other search and rescue requests." ;
  rdfs:subClassOf c:IDT_6_2_2 .
