  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14 .

c:IDT_14_2_1 a owl:Class ;
  rdfs:label "IDT 14.2.1 Gaming Complex" ;
  rdfs:comment "Establishments that are either land- or water-based primarily engaged in gaming activities that are part of a complex that includes lodging, convention facilities, entertainment, and shopping facilities." ;
  rdfs:subClassOf c:IDT_14_2 .
c:axiom-idt-14_2_1-parent a owl:Axiom ;
