c:IDT_16_2 a owl:Class ;
  rdfs:label "IDT 16.2 Flood Damage Reduction System" ;
  rdfs:comment "A combination of multiple facilities and structures with the primary purpose of furnishing some level of protection from seasonal high water, precipitation, and/or extreme weather events." ;
  rdfs:subClassOf c:IDT_16 .
