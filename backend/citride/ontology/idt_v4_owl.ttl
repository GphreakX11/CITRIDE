  rdfs:label "IDT 15.1.1.1.2 Field, District, or Satellite Office" ;
  rdfs:comment "Field offices that house federal, state, or local agency operations that are agency specific or administrative in nature.  " ;
  rdfs:subClassOf c:IDT_15_1_1_1 .
