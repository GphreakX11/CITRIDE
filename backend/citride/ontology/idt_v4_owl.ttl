  owl:annotatedTarget c:IDT_1_5_2 .

c:IDT_1_5_2_6 a owl:Class ;
  rdfs:label "IDT 1.5.2.6 Fish and Seafood Merchant Wholesaler" ;
  rdfs:comment "Establishments primarily engaged in the merchant wholesale distribution of fish and seafood (except canned or packaged frozen)." ;
  rdfs:subClassOf c:IDT_1_5_2 .
c:axiom-idt-1_5_2_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
