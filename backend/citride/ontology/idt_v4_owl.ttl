  rdfs:label "IDT 2.1.4 Banking or Credit Supporting Facility" ;
  rdfs:comment "Establishments primarily engaged in facilitating credit intermediation by performing activities, such as arranging loans by bringing borrowers and lenders together and clearing checks and credit card transactions." ;
  rdfs:subClassOf c:IDT_2_1 .
