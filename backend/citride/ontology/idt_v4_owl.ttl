  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_5_1 .

c:IDT_14_5_1_2 a owl:Class ;
  rdfs:label "IDT 14.5.1.2 Office District" ;
  rdfs:comment "A number of office buildings that are in a common area ( e.g., central business district) but are not under common management.  May not have dedicated parking.  " ;
  rdfs:subClassOf c:IDT_14_5_1 .
c:axiom-idt-14_5_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_5_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_5_1 .

c:IDT_14_5_1_3 a owl:Class ;
  rdfs:label "IDT 14.5.1.3 Office Park" ;
  rdfs:comment "Groupings of office buildings in a common area.  Buildings generally under common management for operation and maintenance.  May have dedicated parking.  " ;
  rdfs:subClassOf c:IDT_14_5_1 .
c:axiom-idt-14_5_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_5_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_5_1 .

c:IDT_14_5_2 a owl:Class ;
  rdfs:label "IDT 14.5.2 Residential Unit" ;
  rdfs:comment "Residential facilities including single and multi-family.  " ;
  rdfs:subClassOf c:IDT_14_5 .
c:axiom-idt-14_5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_5_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_5 .

c:IDT_14_5_2_1 a owl:Class ;
  rdfs:label "IDT 14.5.2.1 Multi-Family Residence" ;
  rdfs:comment "Residences with more than one household." ;
  rdfs:subClassOf c:IDT_14_5_2 .
c:axiom-idt-14_5_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_5_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_5_2 .

c:IDT_14_5_2_2 a owl:Class ;
  rdfs:label "IDT 14.5.2.2 Single-Family Residence" ;
  rdfs:comment "Residences with a notable owner or that are a significant structure.  " ;
  rdfs:subClassOf c:IDT_14_5_2 .
c:axiom-idt-14_5_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_5_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_5_2 .

c:IDT_14_5_3 a owl:Class ;
  rdfs:label "IDT 14.5.3 Self-Storage Facility" ;
  rdfs:comment "Establishments engaged in renting space, used for storing personal and household items, typically known as units, rooms, or lockers." ;
  rdfs:subClassOf c:IDT_14_5 .
c:axiom-idt-14_5_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_5_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_5 .

c:IDT_14_5_4 a owl:Class ;
  rdfs:label "IDT 14.5.4 Mixed Use Property" ;
  rdfs:comment "Facilities that combine more than one type of use, e.g., residential and commercial, in a building or set of buildings." ;
  rdfs:subClassOf c:IDT_14_5 .
c:axiom-idt-14_5_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_5_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_5 .

c:IDT_14_6 a owl:Class ;
  rdfs:label "IDT 14.6 Retail Facility" ;
  rdfs:comment "This comprises two main types of retailers: store and non-store retailers." ;
  rdfs:subClassOf c:IDT_14 .
c:axiom-idt-14_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14 .

c:IDT_14_6_1 a owl:Class ;
  rdfs:label "IDT 14.6.1 Store Retailer" ;
  rdfs:comment "Establishments operating fixed point-of-sale locations, located and designed to attract a high volume of walk-in customers.  " ;
  rdfs:subClassOf c:IDT_14_6 .
c:axiom-idt-14_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_6_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_6 .

c:IDT_14_6_1_1 a owl:Class ;
  rdfs:label "IDT 14.6.1.1 Shopping Center, Mall, or Shopping District" ;
  rdfs:comment "A number of stores in a central facility or in a common area ( e.g., a downtown shopping district, commercial shopping area along a roadway).  May or may not have dedicated parking.  Includes shopping centers that are located on large plots of land and smaller \"strip malls\" that are located along roads.  May include recreational and entertainment facilities ( e.g., theaters, game arcades) and/or restaurants." ;
  rdfs:subClassOf c:IDT_14_6_1 .
c:axiom-idt-14_6_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_6_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_6_1 .

c:IDT_14_6_1_2 a owl:Class ;
  rdfs:label "IDT 14.6.1.2 Stand-Alone Store" ;
  rdfs:comment "Stores that are separated from other stores.  May be large facilities with dedicated parking or small independent shops in an isolated location." ;
  rdfs:subClassOf c:IDT_14_6_1 .
c:axiom-idt-14_6_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_6_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_6_1 .

c:IDT_14_6_2 a owl:Class ;
  rdfs:label "IDT 14.6.2 Non-Store Retailer" ;
  rdfs:comment "Establishments serving the general public without using fixed store locations.  Includes merchandise retailed by catalogs, television \"infomercials\", Internet advertising, portable stalls, and other such techniques.  Generally includes a warehouse location where merchandise is stored and shipped from.  " ;
  rdfs:subClassOf c:IDT_14_6 .
c:axiom-idt-14_6_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_6_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_6 .

c:IDT_14_7 a owl:Class ;
  rdfs:label "IDT 14.7 Other Commercial Facility" ;
  rdfs:comment "Commercial assets not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_14 .
