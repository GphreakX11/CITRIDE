  rdfs:label "IDT 15.1.2 Personnel-Oriented Land" ;
  rdfs:comment "Government land surrounding and supporting the function and activities of personnel-centric buildings or planned buildings and structures.  Includes areas used to provide training on weapons systems.  Also includes land held in trust by the government.  " ;
  rdfs:subClassOf c:IDT_15_1 .
