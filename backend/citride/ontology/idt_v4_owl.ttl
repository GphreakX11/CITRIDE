  rdfs:label "IDT 17.3.3 Spent Nuclear Fuel Processing or Storage Facility" ;
  rdfs:comment "Facilities for storing spent reactor fuel assemblies. " ;
  rdfs:subClassOf c:IDT_17_3 .
