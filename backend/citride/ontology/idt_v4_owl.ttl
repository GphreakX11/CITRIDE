c:IDT_11_4_4_2 a owl:Class ;
  rdfs:label "IDT 11.4.4.2 Intracoastal Waterway" ;
  rdfs:comment "Partly natural, partly manmade waterways providing sheltered passage for commercial and leisure boats along the U.S. Atlantic coast and along the Gulf of Mexico coast. " ;
  rdfs:subClassOf c:IDT_11_4_4 .
c:axiom-idt-11_4_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
