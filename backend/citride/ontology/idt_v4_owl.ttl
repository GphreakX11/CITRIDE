c:IDT_11_4_2_1_1 a owl:Class ;
  rdfs:label "IDT 11.4.2.1.1 Shallow Draft General Cargo Terminal" ;
  rdfs:comment "Terminals designed to handle a variety of general cargo. These facilities may have transit sheds, open storage areas, and warehouses on site. " ;
  rdfs:subClassOf c:IDT_11_4_2_1 .
c:axiom-idt-11_4_2_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
