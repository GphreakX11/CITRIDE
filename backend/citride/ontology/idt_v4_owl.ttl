  rdfs:label "IDT 15.1.1.1.4 Judicial Chamber or Office" ;
  rdfs:comment "Government buildings used to conduct and support the business of the judicial branch, including courthouses.  " ;
  rdfs:subClassOf c:IDT_15_1_1_1 .
