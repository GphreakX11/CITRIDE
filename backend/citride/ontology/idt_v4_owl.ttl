  rdfs:label "IDT 15.2.1.5 Library" ;
  rdfs:comment "Government buildings used to store and facilitate public access to reference and reading material. This includes public and presidential libraries.  " ;
  rdfs:subClassOf c:IDT_15_2_1 .
