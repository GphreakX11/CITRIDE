c:IDT_5_2_6_2 a owl:Class ;
  rdfs:label "IDT 5.2.6.2 Petroleum Product Marine Transport" ;
  rdfs:comment "Marine facilities for transporting petroleum products. " ;
  rdfs:subClassOf c:IDT_5_2_6 .
c:axiom-idt-5_2_6_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_6_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
