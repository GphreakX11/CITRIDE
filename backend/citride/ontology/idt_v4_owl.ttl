  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_2_2 .

c:IDT_3_2_3 a owl:Class ;
  rdfs:label "IDT 3.2.3 Rail Transport" ;
  rdfs:comment "Railroad assets used for transporting hazardous chemicals.  " ;
  rdfs:subClassOf c:IDT_3_2 .
c:axiom-idt-3_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_3_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_2 .

c:IDT_3_2_3_1 a owl:Class ;
  rdfs:label "IDT 3.2.3.1 Railroad Tank Car" ;
  rdfs:comment "Railroad tank cars designed for carrying hazardous chemicals. Note: Railroad tank cars are sometimes used as mobile storage: that is, the product is not off-loaded into a stationary tank but is used directly from the tank car. " ;
  rdfs:subClassOf c:IDT_3_2_3 .
c:axiom-idt-3_2_3_1-parent a owl:Axiom ;
