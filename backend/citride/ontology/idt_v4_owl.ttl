  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_9_2_3_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_9_2_3 .

c:IDT_9_2_4 a owl:Class ;
  rdfs:label "IDT 9.2.4 Courier Retail Facility" ;
  rdfs:comment "Facilities serving a specific local area to collect letters and parcels and provide other customer services.  " ;
  rdfs:subClassOf c:IDT_9_2 .
c:axiom-idt-9_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_9_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_9_2 .

c:IDT_9_2_5 a owl:Class ;
  rdfs:label "IDT 9.2.5 Courier Aircraft Maintenance Facility" ;
  rdfs:comment "Centralized facilities that provide aircraft and/or vehicle maintenance support.  " ;
  rdfs:subClassOf c:IDT_9_2 .
c:axiom-idt-9_2_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_9_2_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_9_2 .

c:IDT_9_3 a owl:Class ;
  rdfs:label "IDT 9.3 Other Postal and Shipping Facility" ;
  rdfs:comment "Other postal and shipping facilities and assets not elsewhere categorized. " ;
  rdfs:subClassOf c:IDT_9 .
c:axiom-idt-9_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_9_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_9 .

c:IDT_10 a owl:Class ;
  rdfs:label "IDT 10 Healthcare and Public Health" ;
  rdfs:comment "Assets related to the provision of health-related services to individuals (generally referred to as healthcare), the provision of health-related services to populations, including the general community, at the workplace, at academic institutions, and in the military (generally referred to as public health), and the provision of health-related supporting services. Includes public and private facilities." ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-10-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_10_1 a owl:Class ;
  rdfs:label "IDT 10.1 Direct Patient Healthcare" ;
  rdfs:comment "Facilities providing healthcare services to individuals including diagnosis and treatment of injuries and diseases." ;
  rdfs:subClassOf c:IDT_10 .
c:axiom-idt-10_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_10 .

c:IDT_10_1_1 a owl:Class ;
  rdfs:label "IDT 10.1.1 Hospital" ;
  rdfs:comment "Facilities providing medical, diagnostic, and treatment services that include physician, nursing, and other health services to inpatients and the specialized accommodation services required by inpatients." ;
  rdfs:subClassOf c:IDT_10_1 .
c:axiom-idt-10_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_10_1_1 ;
