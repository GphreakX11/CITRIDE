  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_15_1 .

c:IDT_15_2 a owl:Class ;
  rdfs:label "IDT 15.2 Service-Oriented Government Facility" ;
  rdfs:comment "Facilities geared towards providing services to government and the public.  These facilities typically experience large numbers of visitors and house technical equipment necessary to carry out and deliver government services.  " ;
  rdfs:subClassOf c:IDT_15 .
