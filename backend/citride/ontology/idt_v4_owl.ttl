c:IDT_5_2_6_2_1 a owl:Class ;
  rdfs:label "IDT 5.2.6.2.1 Petroleum Product Tanker" ;
  rdfs:comment "Marine vessels for moving petroleum products. Includes ocean-going tankers for movement of imported and domestic petroleum products, tankers, and barges for movement of petroleum products on coastal and inland waterways." ;
  rdfs:subClassOf c:IDT_5_2_6_2 .
c:axiom-idt-5_2_6_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
