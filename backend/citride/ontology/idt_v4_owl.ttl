  rdfs:label "IDT 5.3.5.2 Liquefied Natural Gas (LNG) Transport" ;
  rdfs:comment "Facilities that transport liquefied natural gas (LNG)." ;
  rdfs:subClassOf c:IDT_5_3_5 .
c:axiom-idt-5_3_5_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
