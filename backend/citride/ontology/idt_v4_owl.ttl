  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_4_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_4_2 .

c:IDT_1_1_4_2_4 a owl:Class ;
  rdfs:label "IDT 1.1.4.2.4 Game Propagation" ;
  rdfs:comment "Facilities primarily engaged in operations for game propagation." ;
  rdfs:subClassOf c:IDT_1_1_4_2 .
c:axiom-idt-1_1_4_2_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_4_2_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_4_2 .

c:IDT_1_1_4_2_5 a owl:Class ;
  rdfs:label "IDT 1.1.4.2.5 Game Retreat" ;
  rdfs:comment "Facilities primarily engaged in operating game retreats." ;
  rdfs:subClassOf c:IDT_1_1_4_2 .
