c:IDT_9_2 a owl:Class ;
  rdfs:label "IDT 9.2 Courier" ;
  rdfs:comment "Commercial companies providing delivery of letters and parcels ( e.g., United Parcel Service, Federal Express, DHL, Airborne)." ;
  rdfs:subClassOf c:IDT_9 .
