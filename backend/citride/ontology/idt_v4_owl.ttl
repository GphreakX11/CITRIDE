  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_3_2 .

c:IDT_3_2_4_1 a owl:Class ;
  rdfs:label "IDT 3.2.4.1 Tanker Truck" ;
  rdfs:comment "Trucks (generally semi-trailers) designed to carry hazardous chemicals.  " ;
  rdfs:subClassOf c:IDT_3_2_4 .
c:axiom-idt-3_2_4_1-parent a owl:Axiom ;
