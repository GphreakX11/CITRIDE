  rdfs:label "IDT 1.5.2.1 General Line Grocery Merchant Wholesaler" ;
  rdfs:comment "Establishments primarily engaged in the merchant wholesale distribution of a general line (wide range) of groceries. " ;
  rdfs:subClassOf c:IDT_1_5_2 .
