  rdfs:label "IDT 6.2.8 Fire & Emergency Services Supply Facility" ;
  rdfs:comment "Pre-identified storage and staging areas for fire mitigation supplies and equipment." ;
  rdfs:subClassOf c:IDT_6_2 .
