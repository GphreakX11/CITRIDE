  rdfs:label "IDT 14.3.1 Bed and Breakfast Inn" ;
  rdfs:comment "Establishments primarily engaged in providing short-term lodging in private homes or small buildings converted for this purpose." ;
  rdfs:subClassOf c:IDT_14_3 .
