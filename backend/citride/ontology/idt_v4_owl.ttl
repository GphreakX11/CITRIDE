  rdfs:label "IDT 17.3.3.2 Spent Nuclear Fuel Dry Storage Facility" ;
  rdfs:comment "Facilities where spent fuel is stored dry in specially designed casks. Generally referred to as an independent spent fuel storage installation (ISFSI)." ;
  rdfs:subClassOf c:IDT_17_3_3 .
c:axiom-idt-17_3_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
