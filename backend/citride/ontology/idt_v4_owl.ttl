c:IDT_6_4 a owl:Class ;
  rdfs:label "IDT 6.4 Emergency Management" ;
  rdfs:comment "Assets providing mitigation, prevention, preparedness (including planning, training, and exercising), response (including coordination, resource acquisition, and resource prioritization), recovery efforts, and public information before, during, and after disasters and catastrophic events." ;
  rdfs:subClassOf c:IDT_6 .
