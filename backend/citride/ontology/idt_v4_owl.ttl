c:IDT_1_1_2_6_1 a owl:Class ;
  rdfs:label "IDT 1.1.2.6.1 Apiculture" ;
  rdfs:comment "Facilities primarily engaged in farm-raising bees. These establishments may collect and gather honey and/or sell queen bees, packages of bees, royal jelly, bees' wax, propolis, venom, and/or other bee products. " ;
  rdfs:subClassOf c:IDT_1_1_2_6 .
c:axiom-idt-1_1_2_6_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_2_6_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_2_6 .

c:IDT_1_1_2_6_2 a owl:Class ;
  rdfs:label "IDT 1.1.2.6.2 Horses and Other Equine Production" ;
  rdfs:comment "Facilities primarily engaged in farm-raising horses, mules, donkeys, and other equines. " ;
  rdfs:subClassOf c:IDT_1_1_2_6 .
c:axiom-idt-1_1_2_6_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_2_6_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_1_2_6 .

c:IDT_1_1_2_6_3 a owl:Class ;
  rdfs:label "IDT 1.1.2.6.3 Fur-Bearing Animal and Rabbit Production" ;
  rdfs:comment "Facilities primarily engaged in farm-raising fur-bearing animals and rabbits." ;
  rdfs:subClassOf c:IDT_1_1_2_6 .
c:axiom-idt-1_1_2_6_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
