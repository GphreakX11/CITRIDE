  owl:annotatedTarget c:IDT_16 .

c:IDT_16_2_1 a owl:Class ;
  rdfs:label "IDT 16.2.1 Flood Protection Structure" ;
  rdfs:comment "A manmade structure designed to provide flood damage reduction to a defined area. " ;
  rdfs:subClassOf c:IDT_16_2 .
