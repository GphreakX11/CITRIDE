c:IDT_2_3_5_4 a owl:Class ;
  rdfs:label "IDT 2.3.5.4 International Insurance Organization" ;
  rdfs:comment "International organizations dealing with insurance issues." ;
  rdfs:subClassOf c:IDT_2_3_5 .
