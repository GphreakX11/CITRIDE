  owl:annotatedTarget c:IDT_5_3_6 .

c:IDT_5_3_6_4 a owl:Class ;
  rdfs:label "IDT 5.3.6.4 Compressed Natural Gas (CNG) Plant" ;
  rdfs:comment "Facilities that compress natural gas to very high pressures (2,000-5,000 psi) Includes specially designed tanks to store the gas. May include facilities to dispense the gas to smaller tanks (e.g., compressed natural gas [CNG] fueled vehicles)." ;
  rdfs:subClassOf c:IDT_5_3_6 .
c:axiom-idt-5_3_6_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
