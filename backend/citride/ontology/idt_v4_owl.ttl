  rdfs:label "IDT 10.1.1.2.2 Federal Psychiatric or Substance Abuse Hospital" ;
  rdfs:comment "Hospitals operated by government organizations (e.g., veterans hospital). " ;
  rdfs:subClassOf c:IDT_10_1_1_2 .
c:axiom-idt-10_1_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
