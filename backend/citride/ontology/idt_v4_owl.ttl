  owl:annotatedTarget c:IDT_1_1_3_2 .

c:IDT_1_1_3_2_3 a owl:Class ;
  rdfs:label "IDT 1.1.3.2.3 Rails and Rough Wood Manufacturing" ;
  rdfs:comment "Facilities and operations engaged in manufacturing rails or rough wood." ;
  rdfs:subClassOf c:IDT_1_1_3_2 .
c:axiom-idt-1_1_3_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_1_3_2_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
