  rdfs:label "IDT 2.1.3.7 Other Non-Depository Credit Institution" ;
  rdfs:comment "Establishments primarily engaged in providing non-depository credit other than those itemized above. Includes administrative offices, operations centers, data and information systems, and telecommunication systems." ;
  rdfs:subClassOf c:IDT_2_1_3 .
