c:IDT_5_5_5 a owl:Class ;
  rdfs:label "IDT 5.5.5 Ethanol Blending Facility" ;
  rdfs:comment "Facilities involved in blending ethanol with gasoline. Frequently done at terminals where tanker trucks are loaded for delivery to motor vehicle fueling stations." ;
  rdfs:subClassOf c:IDT_5_5 .
