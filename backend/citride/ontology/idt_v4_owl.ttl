c:IDT_1_1_2 a owl:Class ;
  rdfs:label "IDT 1.1.2 Animal Production" ;
  rdfs:comment "Facilities that raise or fatten animals for the sale of animals or animal products, and are comprised of ranches, farms, and feedlots primarily engaged in keeping, grazing, breeding, or feeding animals. The animals are generally raised in various environments, from total confinement or captivity to feeding on an open range pasture." ;
  rdfs:subClassOf c:IDT_1_1 .
