c:IDT_11_2_3_3 a owl:Class ;
  rdfs:label "IDT 11.2.3.3 Rail Yard - Intermodal" ;
  rdfs:comment "A railroad yard that is used specifically for handling the transfer of containers and/or trailers between trains and other modes of transport (e.g., truck, ship). Note: Included in this category are facilities that have the label \"Inland Port.\" These facilities, in spite of the label, handle rail-to-road transfers. They are labeled Inland Ports since all traffic moves to and from the facility by rail to the marine docks." ;
  rdfs:subClassOf c:IDT_11_2_3 .
c:axiom-idt-11_2_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_2_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_2_3 .

c:IDT_11_2_3_4 a owl:Class ;
