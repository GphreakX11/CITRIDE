c:IDT_9_1_5 a owl:Class ;
  rdfs:label "IDT 9.1.5 United States Postal Service Delivery Unit" ;
  rdfs:comment "Facilities serving a specific local area to deliver mail (e.g., post office, other delivery units)." ;
  rdfs:subClassOf c:IDT_9_1 .
c:axiom-idt-9_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_9_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_9_1 .

c:IDT_9_1_6 a owl:Class ;
  rdfs:label "IDT 9.1.6 United States Postal Service Vehicle Maintenance Facility" ;
  rdfs:comment "Centralized facilities that provide vehicle maintenance support to a specific local area.  " ;
  rdfs:subClassOf c:IDT_9_1 .
