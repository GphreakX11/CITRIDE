c:IDT_1_2 a owl:Class ;
  rdfs:label "IDT 1.2 Processing, Packaging, and Production" ;
  rdfs:comment "Facilities associated with the transformation of livestock and agricultural products into products for intermediate or final consumption. This category is sometimes referred to as Food Manufacturing." ;
  rdfs:subClassOf c:IDT_1 .
c:axiom-idt-1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1 .

c:IDT_1_2_1 a owl:Class ;
  rdfs:label "IDT 1.2.1 Animal Food Manufacturing" ;
  rdfs:comment "Facilities primarily engaged in manufacturing food and feed for animals from ingredients, such as grains, oilseed mill products, and meat products. These products are not intended for human consumption." ;
  rdfs:subClassOf c:IDT_1_2 .
c:axiom-idt-1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2 .

c:IDT_1_2_1_1 a owl:Class ;
  rdfs:label "IDT 1.2.1.1 Farm Animal Feed Manufacturing" ;
  rdfs:comment "Facilities associated with the manufacturing of feed for cattle, hogs, pigs, poultry, aquaculture fish, and other farm animals. Includes grain and meat feed, supplements, concentrates, mixes, and other animal feed." ;
  rdfs:subClassOf c:IDT_1_2_1 .
c:axiom-idt-1_2_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_1 .

c:IDT_1_2_1_1_1 a owl:Class ;
  rdfs:label "IDT 1.2.1.1.1 On-Farm Site Feed Manufacturing" ;
  rdfs:comment "Establishments located at animal raising operations that produce animal feed intended primarily for local consumption." ;
  rdfs:subClassOf c:IDT_1_2_1_1 .
c:axiom-idt-1_2_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_1_1 .

c:IDT_1_2_1_1_2 a owl:Class ;
  rdfs:label "IDT 1.2.1.1.2 Off-Farm Site Feed Manufacturing" ;
  rdfs:comment "Establishments located apart from animal raising operations that produce animal feed intended primarily for general sale." ;
  rdfs:subClassOf c:IDT_1_2_1_1 .
c:axiom-idt-1_2_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_1_1 .

c:IDT_1_2_1_2 a owl:Class ;
  rdfs:label "IDT 1.2.1.2 Pet Food Manufacturing" ;
  rdfs:comment "Facilities associated with manufacturing of food for household pets (e.g., dogs, cats, gerbils, hamsters, aquarium fish). Includes grain and meat feed, supplements, concentrates, mixes, and other pet food." ;
  rdfs:subClassOf c:IDT_1_2_1 .
c:axiom-idt-1_2_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_1 .

c:IDT_1_2_1_2_1 a owl:Class ;
  rdfs:label "IDT 1.2.1.2.1 Dog and Cat Food Manufacturing" ;
  rdfs:comment "Facilities primarily engaged in manufacturing dog and cat food from ingredients, such as grains, oilseed mill products, and meat products. " ;
  rdfs:subClassOf c:IDT_1_2_1_2 .
c:axiom-idt-1_2_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_1_2 .

c:IDT_1_2_1_2_2 a owl:Class ;
  rdfs:label "IDT 1.2.1.2.2 Animal Feeds Manufacturing (Except Dog and Cat)" ;
  rdfs:comment "Facilities primarily engaged in manufacturing pet food (except dog and cat food) from ingredients, such as grains, oilseed mill products, and meat products. " ;
  rdfs:subClassOf c:IDT_1_2_1_2 .
c:axiom-idt-1_2_1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2_1_2 .

c:IDT_1_2_2 a owl:Class ;
  rdfs:label "IDT 1.2.2 Grain and Oilseed Milling" ;
  rdfs:comment "Establishments primarily engaged in one or more of the following: (1) milling flour or meal from grains or vegetables; (2) preparing flour mixes or doughs from flour milled in the same establishment; (3) milling, cleaning, and polishing rice; and (4) manufacturing malt from barley, rye, or other grains." ;
  rdfs:subClassOf c:IDT_1_2 .
c:axiom-idt-1_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_1_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_1_2 .

c:IDT_1_2_2_1 a owl:Class ;
  rdfs:label "IDT 1.2.2.1 Flour Milling and Malt Manufacturing     " ;
  rdfs:comment "Facilities primarily engaged in one or more of the following: (1) wet milling corn and vegetables; (2) crushing oilseeds and tree nuts; (3) refining and/or blending vegetable oils; (4) manufacturing shortening and margarine; and (5) blending purchased animal fats with vegetable fats." ;
  rdfs:subClassOf c:IDT_1_2_2 .
c:axiom-idt-1_2_2_1-parent a owl:Axiom ;
