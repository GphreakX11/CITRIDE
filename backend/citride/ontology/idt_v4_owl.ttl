c:IDT_17 a owl:Class ;
  rdfs:label "IDT 17  Nuclear Reactors, Materials, and Waste  " ;
  rdfs:comment "The Nuclear Sector is comprised principally of (1) commercial nuclear reactors for generating electric power and non-power nuclear reactors used for research, testing, and training; (2) nuclear materials in medical, industrial, and academic settings and facilities that fabricate nuclear fuel; and (3) the transportation, storage, and disposal of nuclear materials and radioactive waste." ;
  rdfs:subClassOf c:InfrastructureEntity .
c:axiom-idt-17-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:InfrastructureEntity .

c:IDT_17_1 a owl:Class ;
  rdfs:label "IDT 17.1 Nuclear Facility" ;
  rdfs:comment "Assets involved in civilian uses of radioactive material.  Does not include military use radioactive materials and weapons." ;
  rdfs:subClassOf c:IDT_17 .
c:axiom-idt-17_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_17 .

c:IDT_17_1_1 a owl:Class ;
  rdfs:label "IDT 17.1.1 Nuclear Power Plant" ;
  rdfs:comment "Facilities using nuclear fission to produce electricity for use in the electric power grid.   " ;
  rdfs:subClassOf c:IDT_17_1 .
c:axiom-idt-17_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_17_1 .

c:IDT_17_1_1_1 a owl:Class ;
  rdfs:label "IDT 17.1.1.1 Boiling Water Reactor" ;
  rdfs:comment "A common nuclear power reactor design in which water flows upward through the core, where it is heated by fission and allowed to boil in the reactor vessel. The resulting steam then drives turbines, which activate generators to produce electricity." ;
  rdfs:subClassOf c:IDT_17_1_1 .
c:axiom-idt-17_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17_1_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_17_1_1 .

c:IDT_17_1_1_2 a owl:Class ;
  rdfs:label "IDT 17.1.1.2 Pressurized Water Reactor" ;
  rdfs:comment "A common nuclear power reactor design in which very pure water is heated to a very high temperature by fission, kept under high pressure (to prevent it from boiling), and converted to steam (rather than by boiling, as in a boiling-water reactor). The resulting steam is used to drive turbines, which activates generators to produce electricity." ;
  rdfs:subClassOf c:IDT_17_1_1 .
c:axiom-idt-17_1_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17_1_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_17_1_1 .

c:IDT_17_1_2 a owl:Class ;
  rdfs:label "IDT 17.1.2 Research, Training, or Test Reactor" ;
  rdfs:comment "Nuclear reactors used primarily to conduct research, to develop theoretical practices, for source production, for educational purposes, or for purposes aside from the generation of electricity. Most research and test reactors (RTRs) are at universities or colleges, while others are operated by private companies or the federal government. Also called non-power reactors. " ;
  rdfs:subClassOf c:IDT_17_1 .
c:axiom-idt-17_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_17_1 .

c:IDT_17_1_2_1 a owl:Class ;
  rdfs:label "IDT 17.1.2.1 Government Research or Test Reactor" ;
  rdfs:comment "Non-power reactors owned by the Federal Government." ;
  rdfs:subClassOf c:IDT_17_1_2 .
c:axiom-idt-17_1_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17_1_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_17_1_2 .

