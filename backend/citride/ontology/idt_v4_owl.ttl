c:IDT_5_3_5_1_2 a owl:Class ;
  rdfs:label "IDT 5.3.5.1.2 Natural Gas Transmission Pipeline Compressor Station" ;
  rdfs:comment "Stations along the length of a transmission pipeline. Includes gas-powered or electric compressors, valves, control systems, and associated equipment." ;
  rdfs:subClassOf c:IDT_5_3_5_1 .
c:axiom-idt-5_3_5_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_5_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_5_1 .

c:IDT_5_3_5_1_3 a owl:Class ;
  rdfs:label "IDT 5.3.5.1.3 Natural Gas Pipeline Interconnect" ;
  rdfs:comment "Facilities that link one company to another company to transfer gas custody or provide emergency transportation service between companies. This includes facilities such as pipeline segments, valves, or metering and/or pressure reduction stations." ;
  rdfs:subClassOf c:IDT_5_3_5_1 .
c:axiom-idt-5_3_5_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_5_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_5_1 .

c:IDT_5_3_5_1_4 a owl:Class ;
  rdfs:label "IDT 5.3.5.1.4 Natural Gas Pipeline Hub" ;
  rdfs:comment "A market or supply area for pooling and delivery of gas where transactions occur to facilitate the movement of gas between and among interstate pipelines. Transactions can include a change in title of gas ownership, a change in gas transporter, aggregation of gas supply, or other similar items." ;
  rdfs:subClassOf c:IDT_5_3_5_1 .
c:axiom-idt-5_3_5_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_5_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_5_1 .

c:IDT_5_3_5_1_5 a owl:Class ;
  rdfs:label "IDT 5.3.5.1.5 Natural Gas Receipt/Delivery Metering Station" ;
  rdfs:comment "Gas custody transfer metering stations along transmission pipelines. Used to monitor the amount of gas that is transported and provide quantity measurements for billing purposes." ;
  rdfs:subClassOf c:IDT_5_3_5_1 .
c:axiom-idt-5_3_5_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_5_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_5_1 .

c:IDT_5_3_5_1_6 a owl:Class ;
  rdfs:label "IDT 5.3.5.1.6 Natural Gas Transmission Pipeline Control Center" ;
  rdfs:comment "Central control facilities that monitor and operate a transmission pipeline(s). Generally includes supervisory control and data acquisition (SCADA) system control equipment." ;
  rdfs:subClassOf c:IDT_5_3_5_1 .
c:axiom-idt-5_3_5_1_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_5_1_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_5_1 .

