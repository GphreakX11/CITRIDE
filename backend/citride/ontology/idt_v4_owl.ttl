  owl:annotatedTarget c:IDT_17_3 .

c:IDT_17_3_2 a owl:Class ;
  rdfs:label "IDT 17.3.2 Site Managing Accumulations of Naturally Occurring Radioactive Materials (NORM)" ;
  rdfs:comment "Sites where large quantities of naturally-occurring materials are handled or processed (such as oil fields or phosphate mines) and radioactive components of those materials build up (such as radium or radioactive potassium).  " ;
  rdfs:subClassOf c:IDT_17_3 .
c:axiom-idt-17_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_17_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_17_3 .

