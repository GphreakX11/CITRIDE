c:IDT_14_5 a owl:Class ;
  rdfs:label "IDT 14.5 Real Estate Facility" ;
  rdfs:comment "Facilities that are owned and/or operated by commercial stakeholders.  May be leased to business or residential tenants." ;
  rdfs:subClassOf c:IDT_14 .
c:axiom-idt-14_5-parent a owl:Axiom ;
