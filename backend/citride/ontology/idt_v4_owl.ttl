  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_6_4 .

c:IDT_5_2_6_4_2 a owl:Class ;
  rdfs:label "IDT 5.2.6.4.2 Tanker Truck Loading Rack" ;
  rdfs:comment "Facilities at some storage facilities and refineries that are used to load tanker trucks that deliver petroleum products.  " ;
  rdfs:subClassOf c:IDT_5_2_6_4 .
c:axiom-idt-5_2_6_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_6_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_6_4 .

c:IDT_5_2_7 a owl:Class ;
  rdfs:label "IDT 5.2.7 Petroleum Supporting Facility" ;
  rdfs:comment "Facilities providing support functions in the petroleum system." ;
  rdfs:subClassOf c:IDT_5_2 .
c:axiom-idt-5_2_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2 .

c:IDT_5_2_7_1 a owl:Class ;
  rdfs:label "IDT 5.2.7.1 Crude Oil Market" ;
  rdfs:comment "Business operations that deal in the sale and purchase of crude oil and crude oil futures.  Includes centralized exchanges (e.g., New York Mercantile Exchange\n[NYMEX]) and trading houses.  " ;
  rdfs:subClassOf c:IDT_5_2_7 .
c:axiom-idt-5_2_7_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_7_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_7 .

c:IDT_5_2_7_2 a owl:Class ;
  rdfs:label "IDT 5.2.7.2 Petroleum Product Market" ;
  rdfs:comment "Business operations that deal in the sale and purchase of petroleum and petroleum futures.  Includes centralized exchanges (e.g., New York Mercantile Exchange\n [NYMEX]) and trading houses." ;
  rdfs:subClassOf c:IDT_5_2_7 .
c:axiom-idt-5_2_7_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_7_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_7 .

c:IDT_5_3 a owl:Class ;
  rdfs:label "IDT 5.3 Natural Gas" ;
  rdfs:comment "Facilities involved in the supply, processing, storage, transport, distribution, marketing, and regulation of natural gas." ;
  rdfs:subClassOf c:IDT_5 .
c:axiom-idt-5_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5 .

c:IDT_5_3_1 a owl:Class ;
  rdfs:label "IDT 5.3.1 Natural Gas Supply" ;
  rdfs:comment "Facilities involved in supplying natural gas." ;
  rdfs:subClassOf c:IDT_5_3 .
c:axiom-idt-5_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3 .

c:IDT_5_3_1_1 a owl:Class ;
  rdfs:label "IDT 5.3.1.1 Drilling Rig " ;
  rdfs:comment "Drilling, monitoring, and testing equipment that creates long-lasting stable boreholes into the ground or sea bottom that connect to an oil and gas reservoir so that a producing well can be put in place. The drilling equipment samples soil and rock so that an appropriate and sustainable borehole can be encased and protected from changes in pressure and the environment to allow the borehole to safely produce oil and/or gas for many decades.         " ;
  rdfs:subClassOf c:IDT_5_3_1 .
c:axiom-idt-5_3_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_1_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_1 .

c:IDT_5_3_1_2 a owl:Class ;
  rdfs:label "IDT 5.3.1.2 On-Shore Well" ;
  rdfs:comment "Land-based facilities used for the extraction of natural gas from the ground. A number of wells may be grouped closely together to extract gas from a reservoir. Includes equipment such as gathering lines used to bring the output of several wells to a central point. Note: Natural gas is sometimes extracted from the same wells that are used to extract oil. This is referred to as \"associated gas.\" Natural gas that is produced from wells that do not produce oil is referred to as \"non-associated gas.\" " ;
  rdfs:subClassOf c:IDT_5_3_1 .
c:axiom-idt-5_3_1_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_1_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_1 .

c:IDT_5_3_1_3 a owl:Class ;
  rdfs:label "IDT 5.3.1.3 Off-Shore Well" ;
  rdfs:comment "Sea-based facilities used for the extraction of natural gas. Includes equipment such as gathering lines used to bring the output on shore. Also referred to as drilling platforms or off-shore rigs." ;
  rdfs:subClassOf c:IDT_5_3_1 .
c:axiom-idt-5_3_1_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_1_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_1 .

c:IDT_5_3_1_4 a owl:Class ;
  rdfs:label "IDT 5.3.1.4 Unconventional Gas Extraction Facility" ;
  rdfs:comment "Unconventional gas extraction facilities used to reach gas that is difficult and/or expensive to exploit.  Gas extraction from coalbeds, tight formations, and shale are considered unconventional and require additional equipment to pump water, drill horizontally, and use water and chemicals to fracture the formations and release the gas." ;
  rdfs:subClassOf c:IDT_5_3_1 .
c:axiom-idt-5_3_1_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_1_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_1 .

c:IDT_5_3_1_5 a owl:Class ;
  rdfs:label "IDT 5.3.1.5 Natural Gas Production from Other Sources" ;
  rdfs:comment "Facilities designed to produce natural gas from other sources. " ;
  rdfs:subClassOf c:IDT_5_3_1 .
c:axiom-idt-5_3_1_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_1_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_1 .

c:IDT_5_3_2 a owl:Class ;
  rdfs:label "IDT 5.3.2 Natural Gas Processing" ;
  rdfs:comment "Facilities that process natural gas." ;
  rdfs:subClassOf c:IDT_5_3 .
c:axiom-idt-5_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3 .

c:IDT_5_3_2_1 a owl:Class ;
  rdfs:label "IDT 5.3.2.1 Natural Gas Processing Plant" ;
  rdfs:comment "Facilities that separate liquid hydrocarbons (other than crude oil and propane) from extracted natural gas, remove moisture and other impurities from gas, and/or add odorants to natural gas." ;
  rdfs:subClassOf c:IDT_5_3_2 .
c:axiom-idt-5_3_2_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_2_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_2 .

c:IDT_5_3_3 a owl:Class ;
  rdfs:label "IDT 5.3.3 Liquefied Natural Gas (LNG) Plant" ;
  rdfs:comment "Facilities involved in processing liquefied natural gas (LNG)." ;
  rdfs:subClassOf c:IDT_5_3 .
c:axiom-idt-5_3_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3 .

c:IDT_5_3_3_1 a owl:Class ;
  rdfs:label "IDT 5.3.3.1 Liquefied Natural Gas (LNG) Liquefaction Plant" ;
  rdfs:comment "Facilities that liquefy natural gas by reducing its temperature to very low levels (-263° F) at atmospheric pressure. Includes specially designed tanks to store the liquefied natural gas (LNG). May include facilities to regasify LNG for injection into pipelines." ;
  rdfs:subClassOf c:IDT_5_3_3 .
c:axiom-idt-5_3_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_3_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_3 .

c:IDT_5_3_3_2 a owl:Class ;
  rdfs:label "IDT 5.3.3.2 Liquefied Natural Gas (LNG) Satellite Storage and Regasification Plant" ;
  rdfs:comment "Facilities that store liquefied natural gas (LNG) and regasify it for injection into pipelines. Includes specially designed tanks to store the LNG." ;
  rdfs:subClassOf c:IDT_5_3_3 .
c:axiom-idt-5_3_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_3_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_3 .

c:IDT_5_3_4 a owl:Class ;
  rdfs:label "IDT 5.3.4 Natural Gas Storage" ;
  rdfs:comment "Facilities for storing natural gas." ;
  rdfs:subClassOf c:IDT_5_3 .
c:axiom-idt-5_3_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3 .

c:IDT_5_3_4_1 a owl:Class ;
  rdfs:label "IDT 5.3.4.1 Underground Storage Facility" ;
  rdfs:comment "Natural gas that is stored underground in aquifers, depleted oil and gas reservoirs, salt caverns, and other geologic formations. Includes surface facilities to inject, monitor, and extract gas. These facilities are typically used to meet peak load gas demands. Note: Does not include liquefied natural gas (LNG), compressed natural gas (CNG), or liquefied petroleum gas (LPG) storage facilities." ;
  rdfs:subClassOf c:IDT_5_3_4 .
c:axiom-idt-5_3_4_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_4_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_4 .

c:IDT_5_3_4_2 a owl:Class ;
  rdfs:label "IDT 5.3.4.2 Above Ground Storage Facility" ;
  rdfs:comment "Natural gas that is stored in tanks above ground. Includes facilities to inject, monitor, and withdraw gas. Note: Does not include liquefied natural gas (LNG), compressed natural gas (CNG), or liquefied petroleum gas (LPG) storage facilities." ;
  rdfs:subClassOf c:IDT_5_3_4 .
c:axiom-idt-5_3_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_4_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_4 .

c:IDT_5_3_4_3 a owl:Class ;
  rdfs:label "IDT 5.3.4.3 Propane Peak Shaving Facility" ;
  rdfs:comment "Facilities used by natural gas supplies to store, process, and deliver propane into the natural gas distribution system for peak gas demands." ;
  rdfs:subClassOf c:IDT_5_3_4 .
c:axiom-idt-5_3_4_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_4_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_4 .

c:IDT_5_3_5 a owl:Class ;
  rdfs:label "IDT 5.3.5 Natural Gas Transport" ;
  rdfs:comment "Facilities for moving large volumes of natural gas over long distances. " ;
  rdfs:subClassOf c:IDT_5_3 .
c:axiom-idt-5_3_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3 .

c:IDT_5_3_5_1 a owl:Class ;
  rdfs:label "IDT 5.3.5.1 Natural Gas Transmission Pipeline" ;
  rdfs:comment "Large, high-volume pipelines. " ;
  rdfs:subClassOf c:IDT_5_3_5 .
c:axiom-idt-5_3_5_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_3_5_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_3_5 .

c:IDT_5_3_5_1_1 a owl:Class ;
  rdfs:label "IDT 5.3.5.1.1 Natural Gas Transmission Pipeline Segment" ;
  rdfs:comment "Lengths of pipeline, interconnections, and valves. Includes above ground, under ground, river crossings, and other segments." ;
  rdfs:subClassOf c:IDT_5_3_5_1 .
