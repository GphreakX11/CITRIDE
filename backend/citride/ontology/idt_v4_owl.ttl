  rdfs:comment "Facilities used to train public works personnel. " ;
  rdfs:subClassOf c:IDT_6_5 .
c:axiom-idt-6_5_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_6_5_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_6_5 .

c:IDT_6_5_4 a owl:Class ;
  rdfs:label "IDT 6.5.4 Public Works Maintenance Facility" ;
  rdfs:comment "Facilities used to maintain public works equipment and vehicles." ;
  rdfs:subClassOf c:IDT_6_5 .
