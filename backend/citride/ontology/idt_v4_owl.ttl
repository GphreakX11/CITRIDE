c:IDT_6_2_5 a owl:Class ;
  rdfs:label "IDT 6.2.5 Fire Training Facility" ;
  rdfs:comment "Facilities used for fire and hazardous material (HAZMAT) training.  Includes fire academies and training sites." ;
  rdfs:subClassOf c:IDT_6_2 .
