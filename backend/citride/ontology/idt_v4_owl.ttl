  owl:annotatedTarget c:IDT_11_2_3 .

c:IDT_11_2_3_2 a owl:Class ;
  rdfs:label "IDT 11.2.3.2 Rail Yard - Classification" ;
  rdfs:comment "A railroad yard with special facilities to efficiently group rail cars according to destination to facilitate the makeup and breakdown of trains. May have areas adjacent for the loading/unloading of cars. " ;
  rdfs:subClassOf c:IDT_11_2_3 .
c:axiom-idt-11_2_3_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
