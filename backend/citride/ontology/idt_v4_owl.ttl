c:IDT_11_5 a owl:Class ;
  rdfs:label "IDT 11.5 Mass Transit" ;
  rdfs:comment "Facilities associated with a conveyance that provides regular and continuing general or special transportation to the public, but does not include school bus, charter, or sightseeing transportation." ;
  rdfs:subClassOf c:IDT_11 .
