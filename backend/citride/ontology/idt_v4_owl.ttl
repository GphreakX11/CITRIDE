  rdfs:label "IDT 11.5.1.2 Rail Transit Passenger Station" ;
  rdfs:comment "A station on a rail transit line that provides passenger loading and unloading. May be above or below ground. May connect with other modes of transport. " ;
  rdfs:subClassOf c:IDT_11_5_1 .
