  rdfs:label "IDT 14.2.4 Other Gaming Establishments" ;
  rdfs:comment "Includes bingo parlors, slot machine parlors, video gaming device operators, and lottery ticket vendors. May be located in other facilities such as hotels.  " ;
  rdfs:subClassOf c:IDT_14_2 .
