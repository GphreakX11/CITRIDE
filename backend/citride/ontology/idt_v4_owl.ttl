  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_6_2 .

c:IDT_5_2_6_2_2 a owl:Class ;
  rdfs:label "IDT 5.2.6.2.2 Ports Handling Petroleum Product" ;
  rdfs:comment "Port facilities for mooring, docking, loading, and unloading marine vessels with petroleum products. Includes shuttle tankers to off-load larger vessels. Note: Port may also handle other marine cargo." ;
  rdfs:subClassOf c:IDT_5_2_6_2 .
c:axiom-idt-5_2_6_2_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_6_2_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_6_2 .

c:IDT_5_2_6_3 a owl:Class ;
  rdfs:label "IDT 5.2.6.3 Petroleum Product Rail Transport" ;
  rdfs:comment "Railroad assets for transporting petroleum products.  " ;
  rdfs:subClassOf c:IDT_5_2_6 .
c:axiom-idt-5_2_6_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_5_2_6_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_5_2_6 .

c:IDT_5_2_6_3_1 a owl:Class ;
  rdfs:label "IDT 5.2.6.3.1 Railroad Petroleum Tank Car" ;
  rdfs:comment "Railroad tank cars designed for carrying petroleum products. Includes railroad tank cars used for mobile storage (i.e., the product is not off-loaded into a stationary tank but is used directly from the tank car)." ;
  rdfs:subClassOf c:IDT_5_2_6_3 .
c:axiom-idt-5_2_6_3_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
