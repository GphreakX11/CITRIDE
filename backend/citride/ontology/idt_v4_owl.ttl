  owl:annotatedTarget c:IDT_11_4_2_1 .

c:IDT_11_4_2_2 a owl:Class ;
  rdfs:label "IDT 11.4.2.2 Deep Draft Port" ;
  rdfs:comment "Ports capable of handling vessels with drafts of 15 feet or more. " ;
  rdfs:subClassOf c:IDT_11_4_2 .
