  rdfs:label "IDT 17.2.1.5.2 Category II Facility (Special Nuclear Materials - Moderate Strategic Significance)" ;
  rdfs:comment "Facilities handling special nuclear materials designated as Category II by the Nuclear Regulatory Commission (NRC)." ;
  rdfs:subClassOf c:IDT_17_2_1_5 .
c:axiom-idt-17_2_1_5_2-parent a owl:Axiom ;
