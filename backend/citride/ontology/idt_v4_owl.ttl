  owl:annotatedTarget c:IDT_16_3 .

c:IDT_16_3_2_1 a owl:Class ;
  rdfs:label "IDT 16.3.2.1 Pumping Station" ;
  rdfs:comment "A combination of structures and equipment required for pressure-driven transfer of water or liquid-borne materials." ;
  rdfs:subClassOf c:IDT_16_3_2 .
