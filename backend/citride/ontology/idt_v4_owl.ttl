c:IDT_1_2_3_1 a owl:Class ;
  rdfs:label "IDT 1.2.3.1 Sugar Manufacturing" ;
  rdfs:comment "Facilities primarily engaged in manufacturing raw sugar, liquid sugar, and refined sugar from sugarcane, raw cane sugar and sugar beets." ;
  rdfs:subClassOf c:IDT_1_2_3 .
c:axiom-idt-1_2_3_1-parent a owl:Axiom ;
