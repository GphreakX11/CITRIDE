  rdfs:label "IDT 1.5.2.4 Poultry and Poultry Product Merchant Wholesaler" ;
  rdfs:comment "Establishments primarily engaged in the merchant wholesale distribution of poultry and/or poultry products (except canned and packaged frozen)." ;
  rdfs:subClassOf c:IDT_1_5_2 .
c:axiom-idt-1_5_2_4-parent a owl:Axiom ;
