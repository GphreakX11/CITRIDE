  owl:annotatedTarget c:IDT_2_3_5 .

c:IDT_2_3_5_2 a owl:Class ;
  rdfs:label "IDT 2.3.5.2 State, Local, Regional Insurance Agency" ;
  rdfs:comment "State, local, and regional agencies dealing with insurance activities in their jurisdiction." ;
  rdfs:subClassOf c:IDT_2_3_5 .
