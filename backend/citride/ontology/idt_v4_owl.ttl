  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_3 a owl:Class ;
  rdfs:label "IDT 14.4.3 Arena" ;
  rdfs:comment "Large indoor facilities in which events are held for large audiences. Generally designed primarily for spectator sports but also with the ability to host concerts, lectures, rallies, circuses and other events with large audiences.  " ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_3 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_4 a owl:Class ;
  rdfs:label "IDT 14.4.4 Stadium" ;
  rdfs:comment "Large outdoor facilities in which events are held for large audiences.  May or may not have retractable domes for dealing with inclement weather. Generally designed primarily for spectator sports but also with the ability to host concerts, lectures, rallies, circuses and other events with large audiences.  " ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_4 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_5 a owl:Class ;
  rdfs:label "IDT 14.4.5 Amphitheater" ;
  rdfs:comment "Venues for concerts or theatrical performances with rising tiers of seats arranged about an open space.  Amphitheaters can be man-made or a geological formation that has been converted to a facility." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_6 a owl:Class ;
  rdfs:label "IDT 14.4.6 Museum or Planetarium" ;
  rdfs:comment "Facilities engaged in the preservation and exhibition of objects, sites, and natural wonders of historical, cultural, and/or educational value." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_7 a owl:Class ;
  rdfs:label "IDT 14.4.7 Performing Arts Center or Auditorium" ;
  rdfs:comment "Indoor facilities in which performing arts are presented to audiences. Includes concert halls, live theatrical production theaters, dance theaters, community theaters, and other such facilities. Generally smaller than arenas.  " ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_8 a owl:Class ;
  rdfs:label "IDT 14.4.8 Zoo, Aquarium, or Botanical Garden" ;
  rdfs:comment "Establishments primarily engaged in the preservation and exhibition of live plant and animal life displays.  " ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_8-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_8 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_9 a owl:Class ;
  rdfs:label "IDT 14.4.9 Convention Center" ;
  rdfs:comment "Facilities where large groups of people (e.g., political party, professional organization, civic group) meet to exchange information and where trade shows displaying products are held.  May also host other events such as concerts, theater performances, and sporting events.  May be attached to other facilities such as hotels.  " ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_9-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_9 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_10 a owl:Class ;
  rdfs:label "IDT 14.4.10 Golf Course or Country Club" ;
  rdfs:comment "Establishments primarily engaged in operating golf courses. May include dining facilities and other recreational facilities that are known as country clubs.  " ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_10-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_10 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_11 a owl:Class ;
  rdfs:label "IDT 14.4.11 Movie Theater" ;
  rdfs:comment "Facilities in which motion pictures are shown.  May have multiple screens.  " ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_11-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_11 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_12 a owl:Class ;
  rdfs:label "IDT 14.4.12 Entertainment District" ;
  rdfs:comment "Areas with a concentration of different types of entertainment facilities in close proximity.  May include restaurants, nightclubs, and other such establishments.  " ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_12-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_12 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_13 a owl:Class ;
  rdfs:label "IDT 14.4.13 Sports Recreational Facility" ;
  rdfs:comment "Establishments primarily engaged in operating fitness and recreational sports facilities, such as natatoriums, multi-sports complexes, and racquet courts." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_13-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_13 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_14 a owl:Class ;
  rdfs:label "IDT 14.4.14 Community Organization Facility" ;
  rdfs:comment "Facilities where members of a community gather for social, educational, religious, political, recreational, or other purposes.  May be publicly or privately operated facility." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_14-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_14 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_15 a owl:Class ;
  rdfs:label "IDT 14.4.15 Amusement, Theme, or Water Park" ;
  rdfs:comment "Entertainment facilities featuring rides, games, food, and sometimes shows.  Includes theme parks in which the attractions revolve around a central theme or group of themes, traditional amusement parks in which the activities do not focus on a common theme, and water parks in which the attractions center on water-based rides and activities.  " ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_15-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_15 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_16 a owl:Class ;
  rdfs:label "IDT 14.4.16 Community Park, Fairground, Pavilion" ;
  rdfs:comment "Community areas open to the public.  Does not include parklands identified within Sector 13, National Monuments and Icons." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_16-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_16 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_17 a owl:Class ;
  rdfs:label "IDT 14.4.17 Community Water Facility" ;
  rdfs:comment "Beaches, piers, boardwalks, and swimming pools open to the public." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_17-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_17 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_18 a owl:Class ;
  rdfs:label "IDT 14.4.18 Community Special Gathering Venues" ;
  rdfs:comment "Areas, facilities, or outdoor venues where parades, festivals, carnivals, scenic tours, holiday events, and demonstration protests can take place." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_18-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_18 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_18_1 a owl:Class ;
  rdfs:label "IDT 14.4.18.1 Parade Route" ;
  rdfs:comment "Parades scheduled in advance along a pre-determined route.  " ;
  rdfs:subClassOf c:IDT_14_4_18 .
c:axiom-idt-14_4_18_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_18_1 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4_18 .

c:IDT_14_4_18_2 a owl:Class ;
  rdfs:label "IDT 14.4.18.2 Special Event Venue" ;
  rdfs:comment "Facilities or outdoor venues where festivals, carnivals, scenic tours, or holiday events can take place. Generally scheduled well in advance." ;
  rdfs:subClassOf c:IDT_14_4_18 .
c:axiom-idt-14_4_18_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_18_2 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4_18 .

c:IDT_14_4_19 a owl:Class ;
  rdfs:label "IDT 14.4.19 Marina" ;
  rdfs:comment "Marinas are primarily covered in Sector 11, Transportation. This section is concerned with the land based operations associated with a marina such as the docking and/or storage facilities for pleasure craft owners, retailing marine supplies, repairing, maintaining, or renting pleasure boats, and shopping areas or districts associated or adjacent to the marina. Includes boating and sailing clubs, and yacht basins. Other marina activities such as the docks, regulation of water activities, and commercial shipping, navigation and fishing are covered in the Transportation Sector." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_19-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_19 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_20 a owl:Class ;
  rdfs:label "IDT 14.4.20 Mountain Facility" ;
  rdfs:comment "Establishments engaged in operating downhill or cross-country skiing, or other outdoor recreation facilities." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_20-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_20 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_21 a owl:Class ;
  rdfs:label "IDT 14.4.21 Recreational Vehicle Park or Recreational Camp" ;
  rdfs:comment "Establishments primarily engaged in operating recreational vehicle parks, campgrounds, or recreational vacation camps. These are characterized by the type of accommodation and by the nature and range of recreational facilities and activities provided." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_21-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_21 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_22 a owl:Class ;
  rdfs:label "IDT 14.4.22 Other Public Assembly Facility" ;
  rdfs:comment "Other public assembly facilities not elsewhere categorized." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_22-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_14_4_22 ;
  owl:annotatedProperty rdfs:subClassOf ;
