c:IDT_1_2_3 a owl:Class ;
  rdfs:label "IDT 1.2.3 Sugar and Confectionary Product Manufacturing" ;
  rdfs:comment "Establishments that process agricultural inputs, such as sugarcane, beet, and cacao, to give rise to a new product (sugar or chocolate), and those that begin with sugar and chocolate and process these further." ;
  rdfs:subClassOf c:IDT_1_2 .
c:axiom-idt-1_2_3-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
