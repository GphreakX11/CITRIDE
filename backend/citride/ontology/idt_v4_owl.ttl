  owl:annotatedTarget c:IDT_14_4 .

c:IDT_14_4_2 a owl:Class ;
  rdfs:label "IDT 14.4.2 Horse or Dog Track" ;
  rdfs:comment "Facilities that include specially surfaced courses built for the racing of horses or dogs. The track is a permanent facility and may feature grandstands or concourses." ;
  rdfs:subClassOf c:IDT_14_4 .
c:axiom-idt-14_4_2-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
