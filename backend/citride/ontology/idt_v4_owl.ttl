  rdfs:label "IDT 10.1.1.1.1 Private or Private Not-for-Profit General Medical and Surgical Hospital" ;
  rdfs:comment "Hospitals operated by private organizations, both profit and non-profit. " ;
  rdfs:subClassOf c:IDT_10_1_1_1 .
c:axiom-idt-10_1_1_1_1-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
