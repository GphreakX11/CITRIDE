c:IDT_1_1_2_6 a owl:Class ;
  rdfs:label "IDT 1.1.2.6 Other Animal Production" ;
  rdfs:comment "Facilities primarily engaged in raising animals and insects (except those identified above) such as bees, horses and other equines, rabbits and other fur-bearing animals." ;
  rdfs:subClassOf c:IDT_1_1_2 .
c:axiom-idt-1_1_2_6-parent a owl:Axiom ;
