  owl:annotatedTarget c:IDT_11_6_3 .

c:IDT_11_6_3_5 a owl:Class ;
  rdfs:label "IDT 11.6.3.5 Natural Gas Pipeline Hub" ;
  rdfs:comment "A market or supply area for pooling and delivery of gas where transactions occur to facilitate the movement of gas between and among interstate pipelines. Transactions can include a change in title of gas ownership, a change in gas transporter, aggregation of gas supply, or other similar items. Also known as a Market Center." ;
  rdfs:subClassOf c:IDT_11_6_3 .
c:axiom-idt-11_6_3_5-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_6_3_5 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_6_3 .

c:IDT_11_6_3_6 a owl:Class ;
  rdfs:label "IDT 11.6.3.6 Natural Gas Receipt/Delivery Metering Station" ;
  rdfs:comment "Gas custody transfer metering stations along transmission pipelines. Used to monitor the amount of gas that is transported and to provide quantity measurements for billing purposes. " ;
  rdfs:subClassOf c:IDT_11_6_3 .
c:axiom-idt-11_6_3_6-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_6_3_6 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_6_3 .

c:IDT_11_6_3_7 a owl:Class ;
  rdfs:label "IDT 11.6.3.7 Liquefied Natural Gas Storage Terminal" ;
  rdfs:comment "Facilities that store liquefied natural gas (LNG) and regasify it for injection into pipelines. Includes specially designed tanks to store the LNG. " ;
  rdfs:subClassOf c:IDT_11_6_3 .
c:axiom-idt-11_6_3_7-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
  rdfs:comment "IDT v4 hierarchy" ;
  owl:annotatedSource c:IDT_11_6_3_7 ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget c:IDT_11_6_3 .

c:IDT_11_6_4 a owl:Class ;
  rdfs:label "IDT 11.6.4 Natural Gas Distribution" ;
  rdfs:comment "Facilities, generally owned by a local distribution company (LDC), that distribute natural gas to final consumers." ;
  rdfs:subClassOf c:IDT_11_6 .
c:axiom-idt-11_6_4-parent a owl:Axiom ;
  rdfs:label "IDT v4 hierarchy" ;
