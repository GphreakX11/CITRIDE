  "boilWaterRules": [
    {
      "id": "bwn-unsafe-water",
      "when": {
        "seedLossType": "unsafe_water",
        "providerType": "WaterServiceProvider",
        "minPersistHours": 1
      },
      "label": "Boil-water notice: possible",
      "explanation": "Unsafe treated water at a public water system for an hour or more can lead to a boil-water notice.",
      "decidedBy": "The utility and the state drinking-water regulator decide.",
      "verification": "needs_sme_review",
      "sourceRefs": [
        "src-response-options"
      ]
    }
  ],
  "firstActions": [
    {
      "id": "fa-vpn-disable",
      "when": {
        "observation": "vendor_vpn_login_off_hours"
      },
      "scope": "utility",
      "text": "Disable the vendor remote-access account and end active sessions.",
      "contactRole": "Utility {u} operations manager (on call)"
    },
    {
      "id": "fa-dosing-manual",
      "when": {
        "observation": "dosing_parameter_change"
      },
      "scope": "utility",
      "text": "Confirm the dosing setpoint at the plant and run the process in manual.",
      "contactRole": "Treatment Plant {u} superintendent"
    },
    {
      "id": "fa-boil-water",
      "when": {
        "boilWaterRule": "bwn-unsafe-water"
      },
      "scope": "utility",
      "text": "Coordinate on a possible boil-water notice. The utility and the state regulator decide.",
      "contactRole": "Utility {u} operations manager (on call)"
    },
    {
      "id": "fa-sample",
      "when": {
        "observation": "water_quality_drift"
      },
      "scope": "utility",
      "text": "Take confirmatory water-quality samples.",
      "contactRole": "Treatment Plant {u} superintendent"
    },
    {
      "id": "fa-vendor-check",
      "when": {
        "observation": "probing_only"
      },
      "scope": "utility",
      "text": "Check for the Vendor V account, reset its credentials, and block the shared source address.",
      "contactRole": "Utility {u} IT lead"
    },
    {
      "id": "fa-login-review",
      "when": {
        "observation": "probing_only",
        "utilityServesSector": "10.1.2"
      },
      "scope": "utility",
      "text": "Review recent controller logins.",
      "contactRole": "Utility {u} IT lead"
    },
    {
      "id": "fa-vendor-notify",
      "when": {
        "observation": "vendor_vpn_login_off_hours"
      },
      "scope": "vendor",
      "text": "Tell Vendor V its support account was misused at one utility and is in use at others.",
      "contactRole": "Vendor V remote support lead"
    },
    {
      "id": "fa-health-call",
      "when": {
        "impactFacilitySector": "10"
      },
      "scope": "facility",
      "text": "Call the facility with the earliest modeled window first.",
      "contactRole": "{facility} administrator"
    }
  ],
  "firstActionsLabel": "Suggested — cyber SME to confirm",
